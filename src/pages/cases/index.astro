---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import { cases, caseChannels, caseNiches } from '../../data/cases';
import { emphasize } from '../../lib/text';

const filters = [...caseChannels, ...caseNiches];
const slugify = (value: string) => value.toLowerCase().replace(/[^a-zа-яіїєґ0-9]+/gi, '-');
---

<BaseLayout
  title="Кейси з реклами Google Ads і Meta Ads — результати в цифрах"
  description="Кейси performance-маркетингу зі скріншотами з рекламних кабінетів: B2B SaaS, eCommerce, нерухомість, FinTech. CPL, ROAS, CPA і що саме було зроблено."
>
  <section class="page-head">
    <div class="wrap">
      <p class="kicker"><b>{String(cases.length).padStart(2, '0')}</b> Кейси</p>
      <h1 class="display page-head__title">Результати, які можна <em>перевірити</em></h1>
      <p class="lead page-head__lead">
        Кожен кейс — це реальний рекламний кабінет: контекст, рішення, скріншоти й цифри до та після. Назви брендів приховані
        через NDA.
      </p>

      <div class="filters" role="group" aria-label="Фільтр кейсів" data-case-filters>
        <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">Усі</button>
        {filters.map((filter) => (
          <button type="button" class="filter" data-filter={slugify(filter)} aria-pressed="false">{filter}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap cases-grid" aria-label="Список кейсів">
    {cases.map((item, index) => (
      <a
        href={`/cases/${item.slug}`}
        class="case-card"
        data-tags={[...item.channels, item.niche].map(slugify).join(' ')}
        data-reveal
        style={`--reveal-i:${index % 2}`}
      >
        <div class="case-card__media">
          <img src={item.cover.src} alt="" width={item.cover.width} height={item.cover.height} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
        </div>
        <div class="case-card__body">
          <p class="case-card__meta">{item.niche} · {item.channels.join(' + ')} · {item.market}</p>
          <h2 class="case-card__title" set:html={emphasize(item.headline)} />
          <div class="case-card__metrics">
            {item.highlights.map((metric) => (
              <div>
                <b class="num">{metric.value}</b>
                <small>{metric.label}{metric.note && ` · ${metric.note}`}</small>
              </div>
            ))}
          </div>
          <span class="case-card__more">Читати кейс <Icon name="arrow-right" size={16} /></span>
        </div>
      </a>
    ))}
  </section>

  <ContactCta location="cases_index" />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-case-filters]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.case-card'));

  root?.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-filter]') : null;
    if (!button) return;
    const value = button.dataset.filter || 'all';

    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((item) => {
      const active = item === button;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', String(active));
    });

    cards.forEach((card) => {
      const match = value === 'all' || (card.dataset.tags || '').split(' ').includes(value);
      card.hidden = !match;
      if (match) card.classList.add('is-visible');
    });
  });
</script>

<style>
  .page-head {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem));
    padding-bottom: 2.5rem;
  }

  .page-head__title {
    max-width: 16ch;
    margin-top: 1.25rem;
    font-size: clamp(2.3rem, 1.3rem + 4.5vw, 4.8rem);
  }

  .page-head__lead {
    max-width: 40rem;
    margin-top: 1.25rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 2.25rem;
  }

  .filter {
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 200ms ease;
  }

  .filter:hover {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  .filter.is-active {
    border-color: var(--color-signal);
    background: var(--color-signal);
    color: #fff;
  }

  .cases-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .cases-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .case-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.2);
    background: var(--color-ink-2);
    transition: border-color 300ms ease;
  }

  .case-card[hidden] {
    display: none;
  }

  .case-card:hover {
    border-color: rgb(255 90 31 / 0.55);
  }

  .case-card__media {
    position: relative;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .case-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(16 18 22 / 0.55), transparent 60%);
  }

  .case-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 900ms var(--ease-out);
  }

  .case-card:hover .case-card__media img {
    transform: scale(1.04);
  }

  .case-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .case-card__meta {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .case-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .case-card__title :global(em) {
    color: var(--color-signal);
    font-style: normal;
  }

  .case-card__metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .case-card__metrics b {
    display: block;
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .case-card__metrics small {
    color: var(--color-faint);
    font-size: 0.8rem;
  }

  .case-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-weight: 700;
  }

  .case-card:hover .case-card__more {
    color: var(--color-signal-soft);
  }
</style>
