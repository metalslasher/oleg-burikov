---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const caseData = {
  title: "Житловий комплекс у Києві",
  industry: "Real Estate",
  period: "Серпень - листопад 2024",
  budget: "₴420,000",
  market: "Київ",
  service: "Google Ads"
};

const keyMetrics = [
  { value: "865", label: "Ліди", description: "Заповнені заявки з лендінгу" },
  { value: "₴510", label: "CPL", description: "Середня вартість ліда" },
  { value: "132", label: "Записи на перегляд", description: "Кваліфіковані дії" },
  { value: "4.1%", label: "CR лендінгу", description: "Конверсія в заявку" }
];

const results = {
  leads: "865",
  cpl: "₴510",
  visits: "132",
  qualifiedRate: "41%"
};
---

<PageLayout
  title="Кейс: Житловий комплекс у Києві | Targetsy Agency"
  description="Google Ads для житлового комплексу в Києві: 865 лідів, CPL ₴510 та 132 записи на перегляд завдяки сегментації та оптимізації."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/cases" class="hover:text-accent-400 transition-colors">Кейси</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white">{caseData.title}</span>
      </nav>

      <!-- Header -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="px-4 py-1.5 bg-accent-500/20 text-accent-400 text-sm font-medium rounded-full">
          {caseData.industry}
        </span>
        <span class="px-4 py-1.5 bg-white/5 border border-white/10 text-gray-300 text-sm rounded-full">
          {caseData.service}
        </span>
        <span class="px-4 py-1.5 bg-white/5 border border-white/10 text-gray-300 text-sm rounded-full">
          {caseData.market}
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
        865 лідів для житлового комплексу в Києві з CPL <span class="text-accent-400">₴510</span>
      </h1>

      <p class="text-xl text-gray-400 mb-8 max-w-3xl">
        Проєкт у конкурентному сегменті первинного житла. Мета - стабільно отримувати заявки, відсіювати нерелевантні
        аудиторії та підвищити частку записів на перегляд.
      </p>

      <!-- Key Metrics Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        {keyMetrics.map((metric) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-5 text-center hover:border-accent-500/50 transition-colors">
            <div class="text-2xl md:text-3xl font-bold text-accent-400 mb-1">{metric.value}</div>
            <div class="text-white font-medium mb-1">{metric.label}</div>
            <div class="text-xs text-gray-400">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-white">Виклик</h2>
          </div>

          <p class="text-gray-400 mb-6 leading-relaxed">
            Ринок первинної нерухомості має довгий цикл прийняття рішення та високі вимоги до якості лідів. Потрібно було
            знизити CPL, збільшити частку записів на перегляд і не втратити обсяг трафіку.
          </p>

          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
              </svg>
              <span class="text-gray-400">Висока конкуренція на бренд і загальні запити</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-gray-400">Низька якість частини заявок</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-gray-400">Необхідність утримати CPL у цільових межах</span>
            </div>
          </div>
        </div>

        <!-- Stats Card -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-sm text-white font-medium mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Підсумок кампаній
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-3xl font-bold text-white">{results.leads}</div>
              <div class="text-sm text-gray-400">Ліди</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-white">{results.cpl}</div>
              <div class="text-sm text-gray-400">CPL</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-white">{results.visits}</div>
              <div class="text-sm text-gray-400">Записи на перегляд</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-white">{results.qualifiedRate}</div>
              <div class="text-sm text-gray-400">Частка якісних лідів</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Що зробили</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Сегментація аудиторій</h3>
          <p class="text-gray-400 text-sm">Окремі кампанії під різні запити: локація, тип житла, бюджет.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Search + Display</h3>
          <p class="text-gray-400 text-sm">Пошук для гарячого попиту, медійка для формування наміру.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Якісні фільтри</h3>
          <p class="text-gray-400 text-sm">Мінус-слова та уточнення, що відсікають нерелевантні запити.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Посадкова сторінка</h3>
          <p class="text-gray-400 text-sm">Посилили меседжі, планування перегляду та соцдоказ.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Оптимізація під CPL</h3>
          <p class="text-gray-400 text-sm">Стратегія ставок з контролем вартості ліда.</p>
        </div>
      </div>

      <!-- Campaign Screenshot -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mb-8">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
          </svg>
          Фрагмент кампаній Google Ads
        </h3>
        <div class="overflow-x-auto">
          <img 
            src="/images/cases/synergy_campaigns.png" 
            alt="Кампанії Google Ads для житлового комплексу"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Результати</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center mb-12">
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-2xl font-bold text-white">{results.leads}</div>
          <div class="text-xs text-gray-400">Ліди</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-2xl font-bold text-white">{results.cpl}</div>
          <div class="text-xs text-gray-400">CPL</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-2xl font-bold text-white">{results.visits}</div>
          <div class="text-xs text-gray-400">Записи на перегляд</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-2xl font-bold text-white">{results.qualifiedRate}</div>
          <div class="text-xs text-gray-400">Якісні ліди</div>
        </div>
      </div>

      <!-- Key Takeaways -->
      <div class="bg-gradient-to-br from-accent-500/10 to-primary-500/10 border border-accent-500/20 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
          <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Ключові висновки
        </h3>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">1</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Локальна сегментація = якісні ліди</h4>
              <p class="text-gray-400 text-sm">Запити за районами дали найвищу конверсію.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">2</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Посадкова сторінка критично впливає на CR</h4>
              <p class="text-gray-400 text-sm">Після оптимізації зросла частка заявок.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">3</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Контроль якості важливіший за обсяг</h4>
              <p class="text-gray-400 text-sm">Записи на перегляд підвищили цінність ліда.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">4</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Search + Display працюють разом</h4>
              <p class="text-gray-400 text-sm">Поєднання каналів підсилює ефект у довгому циклі.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
