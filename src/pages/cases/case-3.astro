---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const caseData = {
  title: "Житловий комплекс у Києві",
  industry: "Real Estate",
  period: "Серпень - листопад 2024",
  budget: "$11,895",
  market: "Київ",
  service: "Meta Ads"
};

const keyMetrics = [
  { value: "$13.75", label: "CPL", description: "Середня вартість ліда" },
  { value: "15%", label: "Запис на перегляд", description: "Частка переглядів від лідів" },
  { value: "$11,895", label: "Витрати", description: "Сумарний бюджет Meta Ads" },
  { value: "865", label: "Ліди", description: "Meta lead-форми та заявки" }
];
---

<PageLayout
  title="Кейс Meta Ads для житлового комплексу у Києві | Targetsy Agency"
  description="865 лідів, CPL $13.75 та 132 записи на перегляд."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/cases" class="hover:text-accent-400 transition-colors">Кейси</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white">{caseData.title}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
        <span class="text-accent-400">865</span> лідів для ЖК у Києві з CPL <span class="text-accent-400">$13.75</span>
      </h1>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 sm:p-6 mb-8">
        <img
          src="/images/cases/synergy_site_hero.png"
          alt="Hero-секція сайту житлового комплексу"
          class="rounded-xl w-full border border-white/10"
          loading="lazy"
        />
      </div>

    </div>
  </section>

  <!-- Challenge Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-4">
        <h2 class="text-2xl font-bold text-white">Виклик</h2>
        <div class="mt-2 h-1 w-12 rounded-full bg-gradient-to-r from-accent-400 to-transparent"></div>
      </div>

      <p class="text-gray-400 mb-6 leading-relaxed">
        Проєкт у конкурентному сегменті первинного житла Києва з активною фазою продажів. Ринок перегрітий: висока конкуренція в аукціоні Meta Ads, багато нецільових звернень і різна мотивація лідів, тож потрібно було сегментувати аудиторії за районами й бюджетами, стабілізувати CPL та збільшити записи на перегляд без росту бюджету. Фокус — якість лідів і прогнозоване навантаження на відділ продажів.
      </p>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white">Що зробили</h2>
        <div class="mt-2 h-1 w-12 rounded-full bg-gradient-to-r from-accent-400 to-transparent"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🎯</div>
          <h3 class="text-lg font-bold text-white mb-2">Сегментація аудиторій</h3>
          <p class="text-gray-400 text-sm">Розділили аудиторії за районами Києва, інтересами та поведінкою.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">👥</div>
          <h3 class="text-lg font-bold text-white mb-2">Lookalike та інтереси</h3>
          <p class="text-gray-400 text-sm">Зібрали LAL на базі лідів і протестували інтереси під купівлю житла.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🎬</div>
          <h3 class="text-lg font-bold text-white mb-2">Креативні сценарії</h3>
          <p class="text-gray-400 text-sm">Окремі меседжі під УТП: інфраструктура, укриття, програми фінансування.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🌐</div>
          <h3 class="text-lg font-bold text-white mb-2">Lead Ads + сайт</h3>
          <p class="text-gray-400 text-sm">Паралельно вели Lead Ads і трафік на сайт, щоб відбирати найякісніші заявки.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">📝</div>
          <h3 class="text-lg font-bold text-white mb-2">Оптимізація лід-форми</h3>
          <p class="text-gray-400 text-sm">Скоротили форму та додали кваліфікаційні поля для релевантності.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🔁</div>
          <h3 class="text-lg font-bold text-white mb-2">Ретаргетинг і відсікання</h3>
          <p class="text-gray-400 text-sm">Ремаркетинг на взаємодії та виключення нецільових сегментів.</p>
        </div>
      </div>

      <!-- Campaigns Section -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mb-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-xl leading-none" aria-hidden="true">📣</span>
          Рекламні кампанії
        </h3>
        <div class="overflow-x-auto mb-4">
          <img
            src="/images/cases/synergy_campaigns.png"
            alt="Рекламні кампанії Meta Ads для житлового комплексу"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
        </div>
        <div class="text-sm text-gray-400 leading-relaxed space-y-3">
          
          <ul class="grid md:grid-cols-3 gap-3 text-gray-300">
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Lead Ads на холодні аудиторії Києва з фокусом на заявки.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Промо‑кампанії для прогріву та сезонних меседжів.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Lead‑to‑site кампанії й A/B тести креативів та форм.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Creatives Section -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-xl leading-none" aria-hidden="true">🎨</span>
          Рекламні креативи
        </h3>
        <div class="grid md:grid-cols-3 gap-4">
          <img
            src="/images/cases/synergy_cereo_1.jpg"
            alt="Креатив про програму Оселя та ВПО для житлового комплексу"
            class="rounded-xl w-full border border-white/10 bg-white/5"
            loading="lazy"
          />
          <img
            src="/images/cases/synergy_cereo_2.jpg"
            alt="Креатив про інфраструктуру та укриття в житловому комплексі"
            class="rounded-xl w-full border border-white/10 bg-white/5"
            loading="lazy"
          />
          <img
            src="/images/cases/synergy_cereo_3.jpg"
            alt="Креатив про стабільність і інженерні рішення житлового комплексу"
            class="rounded-xl w-full border border-white/10 bg-white/5"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white">Результати</h2>
        <div class="mt-2 h-1 w-12 rounded-full bg-gradient-to-r from-accent-400 to-transparent"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        {keyMetrics.map((metric) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-white font-semibold text-sm mb-1">{metric.value} {metric.label}</div>
            <div class="text-sm text-gray-400">{metric.description}</div>
          </div>
        ))}
      </div>

      <!-- Key Takeaways -->
      <div class="bg-gradient-to-br from-accent-500/10 to-primary-500/10 border border-accent-500/20 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
          <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Ключові висновки
        </h3>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">1</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Гео-кластери підняли якість лідів</h4>
              <p class="text-gray-400 text-sm">Розподіл за районами зменшив нецільові заявки.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">2</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Оголошення з УТП знижують CPL</h4>
              <p class="text-gray-400 text-sm">Акцент на плануваннях і локації підвищив конверсію.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">3</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Фокус на переглядах підвищує продажі</h4>
              <p class="text-gray-400 text-sm">Оптимізація під записи дала більше якісних лідів.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">4</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Тести креативів очищують трафік</h4>
              <p class="text-gray-400 text-sm">A/B сценарії дали нижчий CPL і більше якісних заявок.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
