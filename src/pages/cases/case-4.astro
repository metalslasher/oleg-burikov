---
import PageLayout from '../../layouts/PageLayout.astro';

const caseData = {
  title: "Онлайн кредитування для фінтех-сервісу",
  industry: "FinTech",
  period: "Травень - липень 2024",
  budget: "$1,677.55",
  market: "Україна",
  service: "Google Ads"
};

const keyMetrics = [
  { value: "597", label: "Заявки", description: "Конверсії у заявки" },
  { value: "$2.81", label: "CPA", description: "Середня вартість заявки" },
  { value: "7.6%", label: "Конверсія", description: "Частка кліків, що стали заявками" },
  { value: "$1,677.55", label: "Витрати", description: "Сумарний бюджет кампаній" }
];

---

<PageLayout
  title="Кейс Google Ads для фінтех-сервісу онлайн кредитування"
  description="597 заявок на кредит, CPA $2.81 та конверсія 7.6% в Україні."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/cases" class="hover:text-accent-400 transition-colors">Кейси</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white">{caseData.title}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
        <span class="text-accent-400">597</span> заявок на кредит з ціною <span class="text-accent-400">$2.81</span>
      </h1>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 sm:p-6 mb-8">
        <img
          src="/images/cases/monobank_site_hero.png"
          alt="Hero-секція сайту фінтех-сервісу"
          class="rounded-xl w-full border border-white/10"
          loading="lazy"
        />
      </div>

    </div>
  </section>

  <!-- Challenge Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-4">
        <h2 class="text-2xl font-bold text-white">Виклик</h2>
        <div class="mt-2 h-1 w-12 rounded-full bg-gradient-to-r from-accent-400 to-transparent"></div>
      </div>

      <p class="text-gray-400 mb-6 leading-relaxed">
        Онлайн кредитування в Україні — ринок з високою конкуренцією і дуже чутливою економікою ліда. Висока конкуренція за транзакційні запити та різний намір аудиторій вимагали точного контролю, бо будь-яке різке зростання трафіку піднімало CPA і знижувало конверсію в заявку. Потрібно було масштабуватися без стрибка CPA, зберегти стабільну конверсію та робити ставку на запити з високим наміром і якість трафіку.
      </p>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white">Що зробили</h2>
        <div class="mt-2 h-1 w-12 rounded-full bg-gradient-to-r from-accent-400 to-transparent"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🔎</div>
          <h3 class="text-lg font-bold text-white mb-2">Семантика з високим наміром</h3>
          <p class="text-gray-400 text-sm">Сфокусувалися на запитах з прямим наміром отримати кредит.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🧩</div>
          <h3 class="text-lg font-bold text-white mb-2">Кластеризація запитів</h3>
          <p class="text-gray-400 text-sm">Розділили запити за сумами, термінами і типом кредиту.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">🧹</div>
          <h3 class="text-lg font-bold text-white mb-2">Фільтрація трафіку</h3>
          <p class="text-gray-400 text-sm">Відсікли нерелевантні запити та слабкі сегменти аудиторій.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">📝</div>
          <h3 class="text-lg font-bold text-white mb-2">Оптимізація форми</h3>
          <p class="text-gray-400 text-sm">Скоротили шлях до заявки та підвищили читабельність умов.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">✅</div>
          <h3 class="text-lg font-bold text-white mb-2">Контроль якості заявок</h3>
          <p class="text-gray-400 text-sm">Відстежували конверсію і підсилювали найкращі сегменти.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4 text-2xl leading-none" aria-hidden="true">⚙️</div>
          <h3 class="text-lg font-bold text-white mb-2">Автоматизовані ставки</h3>
          <p class="text-gray-400 text-sm">Оптимізація під CPA з контролем стабільності трафіку.</p>
        </div>
      </div>

      <!-- Campaigns Section -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-xl leading-none" aria-hidden="true">📣</span>
          Рекламні кампанії
        </h3>
        <div class="overflow-x-auto mb-4">
          <img
            src="/images/cases/monobank_campaigns.png"
            alt="Рекламні кампанії Google Ads для фінтех-сервісу"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
        </div>
        <div class="text-sm text-gray-400 leading-relaxed space-y-3">
          <p>
            Структура кампаній орієнтована на пошуковий попит: більшість кампаній збирають користувачів з прямим наміром
            оформити кредит. Запити розділені за типами потреб і рівнем готовності, щоб точніше керувати CPA.
          </p>
          <ul class="grid md:grid-cols-3 gap-3 text-gray-300">
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Переважно пошукові кампанії з різними типами відповідності.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Усі кампанії працювали зі стратегією Maximize Conversions для стабільного CPA.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Розділили брендові й небрендові групи, щоб окремо контролювати витрати та якість трафіку.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white">Результати</h2>
        <div class="mt-2 h-1 w-12 rounded-full bg-gradient-to-r from-accent-400 to-transparent"></div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden mb-8">
        <div class="p-4 bg-white/5 border-b border-white/10">
          <span class="text-white font-medium flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Звіт: грудень 2021
          </span>
        </div>
        <div class="p-6">
          <img
            src="/images/cases/monobank_results.png"
            alt="Результати кампаній Google Ads для фінтех-сервісу"
            class="rounded-xl w-full mb-6"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        {keyMetrics.map((metric) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-white font-semibold text-sm mb-1">{metric.value} {metric.label}</div>
            <div class="text-sm text-gray-400">{metric.description}</div>
          </div>
        ))}
      </div>

      <!-- Key Takeaways -->
      <div class="bg-gradient-to-br from-accent-500/10 to-primary-500/10 border border-accent-500/20 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
          <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Ключові висновки
        </h3>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">1</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Якість важливіша за максимальний обсяг</h4>
              <p class="text-gray-400 text-sm">Фільтрація трафіку зберегла стабільність конверсії.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">2</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Семантика з високим наміром тримає CPA в межах</h4>
              <p class="text-gray-400 text-sm">Попит з чітким наміром дав стабільні заявки.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">3</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Прозорі меседжі підвищують конверсію</h4>
              <p class="text-gray-400 text-sm">Акцент на зрозумілих умовах знизив бар’єр заявки.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">4</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Оптимізація форми прискорює рішення</h4>
              <p class="text-gray-400 text-sm">Коротший шлях до заявки зберіг CR на високому рівні.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
