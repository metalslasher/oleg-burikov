---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const caseData = {
  title: "Мобільний банкінг",
  industry: "Фінанси",
  period: "1 місяць",
  budget: "$1,540",
  market: "Україна",
  service: "Google Ads"
};

const keyMetrics = [
  { value: "585", label: "Виданих карток", description: "конверсій за період" },
  { value: "$2.63", label: "Вартість заявки", description: "середня ціна конверсії" },
  { value: "20.11%", label: "Конверсія", description: "найкраща кампанія" },
  { value: "7.46K", label: "Кліків", description: "цільового трафіку" }
];

const results = {
  conversions: "585",
  costPerConversion: "$2.63",
  clicks: "7,495",
  impressions: "76,556",
  spent: "$1,540",
  ctr: "9.79%"
};
---

<PageLayout 
  title="Кейс: Мобільний банкінг | Targetsy Agency"
  description="Як ми отримали 585 виданих кредитних карток для мобільного банку через Google Ads з вартістю конверсії $2.63."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/cases" class="hover:text-accent-400 transition-colors">Кейси</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white">{caseData.title}</span>
      </nav>

      <!-- Header -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="px-4 py-1.5 bg-accent-500/20 text-accent-400 text-sm font-medium rounded-full">
          {caseData.industry}
        </span>
        <span class="px-4 py-1.5 bg-white/5 border border-white/10 text-gray-300 text-sm rounded-full">
          {caseData.service}
        </span>
        <span class="px-4 py-1.5 bg-white/5 border border-white/10 text-gray-300 text-sm rounded-full">
          {caseData.market}
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
        Як ми отримали <span class="text-accent-400">585 виданих карток</span> для мобільного банку
      </h1>

      <p class="text-xl text-gray-400 mb-8 max-w-3xl">
        Запуск пошукових Google Ads кампаній для мобільного банкінгу з фокусом на оформлення кредитної картки та досягнення високої конверсії.
      </p>

      <!-- Key Metrics Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        {keyMetrics.map((metric) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-5 text-center hover:border-accent-500/50 transition-colors">
            <div class="text-2xl md:text-3xl font-bold text-accent-400 mb-1">{metric.value}</div>
            <div class="text-white font-medium mb-1">{metric.label}</div>
            <div class="text-xs text-gray-400">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-white">Виклик</h2>
          </div>
          
          <p class="text-gray-400 mb-6 leading-relaxed">
            Клієнт — мобільний банк з фокусом на кредитні картки. Основна ціль — залучення якісних заявок на оформлення картки через Google Ads у висококонкурентній фінансовій ніші.
          </p>
          
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
              <span class="text-gray-400">Висока конкуренція у <strong class="text-white">фінансовій ніші</strong></span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span class="text-gray-400">Необхідність <strong class="text-white">якісних конверсій</strong></span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
              <span class="text-gray-400">Робота з <strong class="text-white">брендовими та загальними</strong> запитами</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              <span class="text-gray-400">Масштабування з <strong class="text-white">контролем ефективності</strong></span>
            </div>
          </div>
        </div>

        <!-- Stats Card -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-sm text-white font-medium mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Підсумкові результати
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-3xl font-bold text-white">{results.conversions}</div>
              <div class="text-sm text-gray-400">Конверсій</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-white">{results.costPerConversion}</div>
              <div class="text-sm text-gray-400">Вартість конверсії</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-white">{results.clicks}</div>
              <div class="text-sm text-gray-400">Кліків</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-white">{results.spent}</div>
              <div class="text-sm text-gray-400">Витрачено</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Наше рішення</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <!-- Strategy Cards -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Пошукові кампанії</h3>
          <p class="text-gray-400 text-sm">Запуск Search кампаній з фокусом на оформлення кредитної картки для цільової аудиторії.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Структура за типами</h3>
          <p class="text-gray-400 text-sm">Кампанії структуровані за типами відповідності: Exact, Phrase, Broad для контролю ефективності.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Брендові запити</h3>
          <p class="text-gray-400 text-sm">Використання брендових ключів для захоплення готової до конверсії аудиторії.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Загальні запити</h3>
          <p class="text-gray-400 text-sm">Робота із запитами "оформити кредитну картку онлайн" для розширення охоплення.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Релевантні оголошення</h3>
          <p class="text-gray-400 text-sm">Створення оголошень під кожну групу запитів для досягнення високого CTR.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Maximize Conversions</h3>
          <p class="text-gray-400 text-sm">Стратегія призначення ставок для максимізації конверсій при контрольованому бюджеті.</p>
        </div>
      </div>

      <!-- Campaign Screenshots -->
      <div class="space-y-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
            </svg>
            Рекламні кампанії
          </h3>
          <div class="overflow-x-auto">
            <img 
              src="/images/cases/monobank_campaigns.png" 
              alt="Рекламні кампанії Google Ads для мобільного банку"
              class="rounded-xl w-full border border-white/10"
              loading="lazy"
            />
          </div>
          <p class="text-sm text-gray-400 mt-3">* Структура кампаній за типами відповідності: Brand Exact, Brand Phrase, Main Phrase, Main Broad</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            Загальні результати
          </h3>
          <div class="overflow-x-auto">
            <img 
              src="/images/cases/monobank_results.png" 
              alt="Загальні результати рекламних кампаній для мобільного банку"
              class="rounded-xl w-full border border-white/10"
              loading="lazy"
            />
          </div>
          <p class="text-sm text-gray-400 mt-3">* Динаміка кліків та конверсій за період кампанії</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Результати</h2>
      </div>

      <!-- Results Grid -->
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
          <div class="text-4xl font-bold text-white mb-2">585</div>
          <div class="text-gray-400">Виданих карток</div>
          <div class="text-sm text-accent-400 mt-2">конверсій за період</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
          <div class="text-4xl font-bold text-white mb-2">$2.63</div>
          <div class="text-gray-400">Середня вартість</div>
          <div class="text-sm text-accent-400 mt-2">найкращі: $1.58</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
          <div class="text-4xl font-bold text-white mb-2">20.11%</div>
          <div class="text-gray-400">Найкраща конверсія</div>
          <div class="text-sm text-accent-400 mt-2">Brand Exact кампанія</div>
        </div>
      </div>

      <!-- Key Takeaways -->
      <div class="bg-gradient-to-br from-accent-500/10 to-primary-500/10 border border-accent-500/20 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
          <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Ключові висновки
        </h3>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">1</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Брендові запити — найвища конверсія</h4>
              <p class="text-gray-400 text-sm">Exact match на брендові запити показав 20.11% конверсії — найкращий результат серед усіх кампаній.</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">2</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Broad match — найнижча вартість</h4>
              <p class="text-gray-400 text-sm">Main Broad кампанія дала найнижчу вартість конверсії $1.58 при 228 конверсіях.</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">3</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Структура за типами відповідності</h4>
              <p class="text-gray-400 text-sm">Розподіл кампаній за Exact, Phrase, Broad дозволив точно контролювати ефективність кожного сегменту.</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">4</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Повна окупність у конкурентній ніші</h4>
              <p class="text-gray-400 text-sm">Реклама забезпечила масштабований результат у фінансовій ніші з високою конкуренцією.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-8 border-t border-white/10">
        <a href="/cases/case-3" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Попередній кейс
        </a>
