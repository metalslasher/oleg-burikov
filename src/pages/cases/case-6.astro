---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const caseData = {
  title: "Магазин наборів для вишивки бісером і хрестиком",
  industry: "eCommerce",
  period: "Жовтень - грудень 2024",
  budget: "₴158,452",
  market: "Україна",
  service: "Meta Ads"
};

const keyMetrics = [
  { value: "804", label: "Покупки", description: "Замовлення за період" },
  { value: "₴197", label: "CPA", description: "Середня вартість покупки" },
  { value: "2.6x", label: "ROAS", description: "Окупність рекламних витрат" },
  { value: "₴158,452", label: "Витрати", description: "Сумарний бюджет" }
];
---

<PageLayout
  title="Кейс Meta Ads для магазину наборів для вишивки | Targetsy Agency"
  description="Кейс Meta Ads для eCommerce: 804 покупки, CPA ₴197, ROAS 2.6x та бюджет ₴158,452 для магазину наборів для вишивки."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/cases" class="hover:text-accent-400 transition-colors">Кейси</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white">{caseData.title}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
        804 покупки для магазину наборів для вишивки з CPA <span class="text-accent-400">₴197</span>
      </h1>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 sm:p-6 mb-8">
        <img
          src="/images/cases/abrisart_site_hero.png"
          alt="Hero-секція сайту магазину наборів для вишивки"
          class="rounded-xl w-full border border-white/10"
          loading="lazy"
        />
      </div>

      <p class="text-xl text-gray-400 mb-8">
        Магазин наборів для вишивки — емоційний продукт, де важливі довіра та натхнення. Ми зосередилися на
        креативах, що показують процес і результат, та на стабільному потоці покупок без втрати ефективності,
        щоб підтримати масштабування у сезонний період.
      </p>
    </div>
  </section>

  <!-- Challenge Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-5 h-5 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Виклик</h2>
      </div>

      <p class="text-gray-400 mb-6 leading-relaxed">
        Аудиторія потребує натхнення, деталей і довіри. Потрібно було підвищити конверсію холодного трафіку,
        уникнути зростання CPA при масштабуванні та системно пояснити цінність продукту.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <div class="flex items-start gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
            <span class="text-white font-medium">Низька конверсія холодної аудиторії</span>
          </div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <div class="flex items-start gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
            <span class="text-white font-medium">Потреба показати процес і результат</span>
          </div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <div class="flex items-start gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
            <span class="text-white font-medium">Ризик зростання CPA при масштабуванні</span>
          </div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <div class="flex items-start gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
            <span class="text-white font-medium">Необхідність системно пояснити цінність продукту</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-5 h-5 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Що зробили</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Креативи з процесом</h3>
          <p class="text-gray-400 text-sm">Показали етапи вишивки та фінальний результат.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Інтереси + lookalike</h3>
          <p class="text-gray-400 text-sm">Сегментація за хобі, рукоділлям та схожими аудиторіями.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Оптимізація Purchase</h3>
          <p class="text-gray-400 text-sm">Налаштували оптимізацію під покупки, а не перегляди.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a2 2 0 01-1-1v-6z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Каталожні кампанії</h3>
          <p class="text-gray-400 text-sm">Показували набори за інтересами та історією переглядів.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Ремаркетинг</h3>
          <p class="text-gray-400 text-sm">Повернули тих, хто переглядав товари або додавав у кошик.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-accent-500/50 transition-colors">
          <div class="mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Покращення лендінгу</h3>
          <p class="text-gray-400 text-sm">Додали відгуки, приклади робіт і гарантії доставки.</p>
        </div>
      </div>

      <!-- Campaigns Section -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
          </svg>
          Рекламні кампанії
        </h3>
        <div class="overflow-x-auto mb-4">
          <img
            src="/images/cases/abrisart_campaigns.png"
            alt="Кампанії Meta Ads для магазину наборів для вишивки"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
        </div>
        <div class="text-sm text-gray-400 leading-relaxed space-y-3">
          <p>
            Кампанії побудували навколо Purchase із розділенням на холодні аудиторії, lookalike та ретаргетинг,
            щоб контролювати CPA і поступово масштабувати бюджет.
          </p>
          <ul class="grid md:grid-cols-3 gap-3 text-gray-300">
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Каталожні кампанії під асортимент і інтереси.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Креативні кампанії з демонстрацією процесу та готових робіт.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-accent-400 flex-shrink-0"></span>
              <span>Ретаргетинг на перегляди, додавання в кошик і повторні покупки.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Creatives Section -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mt-6">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4-4 4 4 8-8M4 4h16v16H4V4z" />
          </svg>
          Рекламні креативи
        </h3>
        <div class="grid md:grid-cols-2 gap-4">
          <img
            src="/images/cases/abrisart_creo_1.jpg"
            alt="Креатив для наборів з вишивки"
            class="rounded-xl w-full border border-white/10 bg-white/5"
            loading="lazy"
          />
          <img
            src="/images/cases/abrisart_creo_2.jpg"
            alt="Креатив із прикладами готових робіт"
            class="rounded-xl w-full border border-white/10 bg-white/5"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-5 h-5 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Результати</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        {keyMetrics.map((metric) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-2xl md:text-3xl font-bold text-accent-400 mb-1">{metric.value}</div>
            <div class="text-white font-medium mb-1">{metric.label}</div>
            <div class="text-xs text-gray-400">{metric.description}</div>
          </div>
        ))}
      </div>

      <!-- Key Takeaways -->
      <div class="bg-gradient-to-br from-accent-500/10 to-primary-500/10 border border-accent-500/20 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
          <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Ключові висновки
        </h3>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">1</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Креативи з процесом підвищують довіру</h4>
              <p class="text-gray-400 text-sm">Показ результату та процесу збільшив конверсію.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">2</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Каталог стабілізує CPA</h4>
              <p class="text-gray-400 text-sm">Динамічні оголошення дали більш передбачувану ціну покупки.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">3</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Ретаргетинг повертає готових клієнтів</h4>
              <p class="text-gray-400 text-sm">Підвищили частку повторних покупок без росту CPA.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 bg-accent-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-accent-400 font-bold">4</span>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Lookalike масштабує без втрати CPA</h4>
              <p class="text-gray-400 text-sm">Схожі аудиторії дали стабільний обсяг покупок.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
