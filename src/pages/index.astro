---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Services from '../components/home/Services.astro';
import Process from '../components/home/Process.astro';
import SelectedCases from '../components/home/SelectedCases.astro';
import Formats from '../components/home/Formats.astro';
import Experience from '../components/home/Experience.astro';
import Faq from '../components/home/Faq.astro';
import { pad2 } from '../lib/text';
import ContactCta from '../components/ContactCta.astro';
import { siteConfig } from '../config/site';
import { faq } from '../data/profile';

const sections = ['services', 'process', 'cases', 'formats', 'experience', 'faq'];
const n = (id: string) => pad2(sections.indexOf(id) + 1);

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={siteConfig.seo.defaultTitle} description={siteConfig.seo.defaultDescription} ogType="profile" schema={[faqSchema]}>
  <Hero />
  <Marquee />
  <Services num={n('services')} />
  <Process num={n('process')} />
  <SelectedCases num={n('cases')} />
  <Formats num={n('formats')} />
  <Experience num={n('experience')} />
  <Faq num={n('faq')} />
  <ContactCta location="home_final" />
</BaseLayout>
