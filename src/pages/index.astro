---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Services from '../components/home/Services.astro';
import Process from '../components/home/Process.astro';
import SelectedCases from '../components/home/SelectedCases.astro';
import Formats from '../components/home/Formats.astro';
import Experience from '../components/home/Experience.astro';
import Faq from '../components/home/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import { siteConfig } from '../config/site';
import { faq } from '../data/profile';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={siteConfig.seo.defaultTitle} description={siteConfig.seo.defaultDescription} ogType="profile" schema={[faqSchema]}>
  <Hero />
  <Marquee />
  <Services />
  <Process />
  <SelectedCases />
  <Formats />
  <Experience />
  <Faq />
  <ContactCta location="home_final" />
</BaseLayout>
