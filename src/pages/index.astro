---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Audience from '../components/Audience.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Niches from '../components/Niches.astro';
import Cases from '../components/Cases.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={siteConfig.seo.defaultTitle}
  description={siteConfig.seo.defaultDescription}
  ogTitle={siteConfig.seo.defaultTitle}
  ogDescription={siteConfig.seo.defaultDescription}
  ogImage={siteConfig.seo.defaultOgImage}
>
  <Header />
  
  <main id="main" class="bg-[linear-gradient(135deg,#020617_0%,#0f172a_58%,#111827_100%)] pt-[80px] sm:pt-0">
    <Hero />
    <Audience />
    <Services />
    <About />
    <Experience />
    <Niches />
    <Cases />
    <ContactCTA />
    <Footer />
  </main>
</BaseLayout>
