---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

Astro.response.status = 404;
---

<BaseLayout title="Сторінку не знайдено" description="Такої сторінки немає. Перейдіть на головну, до кейсів або блогу." noindex>
  <section class="nf wrap">
    <p class="kicker"><b>404</b> Not found</p>
    <p class="nf__code num" aria-hidden="true">4<span>0</span>4</p>
    <h1 class="h2">Ця сторінка не конвертується</h1>
    <p class="lead">CTR є, а сторінки немає. Можливо, посилання застаріло або в адресі помилка.</p>
    <div class="nf__actions">
      <a href="/" class="btn btn--primary">На головну <Icon name="arrow-right" /></a>
      <a href="/cases" class="btn btn--ghost">Кейси</a>
      <a href="/blog" class="btn btn--ghost">Блог</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    min-height: 80dvh;
    align-content: center;
    padding-top: var(--header-h);
  }

  .nf__code {
    font-size: clamp(6rem, 3rem + 18vw, 14rem);
    line-height: 0.9;
  }

  .nf__code span {
    color: var(--color-signal);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
</style>
