---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const host = new URL(siteConfig.siteUrl).hostname;
const sections = [
  {
    title: 'Хто обробляє дані',
    body: [`Власник сайту та контролер даних — ${siteConfig.legalName} (персональний бренд «${siteConfig.personName}»).`],
  },
  {
    title: 'Які дані збираються',
    body: [
      'Якщо ви залишаєте заявку, сайт обробляє ім’я, номер телефону, зручний спосіб зв’язку, тип запиту, повідомлення, сторінку, з якої надіслано форму, та UTM-мітки.',
      'Також збирається технічна аналітика: переглянуті сторінки, джерела переходу, кліки по кнопках, події форм і параметри браузера.',
    ],
  },
  {
    title: 'Для чого використовуються дані',
    body: ['Щоб відповісти на заявку, домовитися про співпрацю або дзвінок, покращувати сайт, вимірювати ефективність реклами та захищати форми від спаму.'],
  },
  {
    title: 'Аналітика і трекінг',
    body: ['Сайт використовує Google Tag Manager, через який можуть бути підключені Google Analytics 4, Microsoft Clarity, Meta Pixel та інші інструменти аналітики й реклами.'],
  },
  {
    title: 'Передача даних третім сторонам',
    body: ['Дані можуть оброблятися сервісами, які забезпечують роботу сайту й комунікацію: Vercel, Google, Calendly, Microsoft, Meta — лише в межах потрібного функціоналу. Дані не продаються.'],
  },
  {
    title: 'Зберігання та захист',
    body: ['Дані зберігаються стільки, скільки потрібно для обробки звернення та комунікації. Заявки обробляються на сервері з перевіркою даних, обмеженням частоти запитів і заголовками безпеки.'],
  },
  {
    title: 'Ваші права',
    body: ['Ви можете попросити доступ до своїх даних, їх виправлення або видалення, написавши на email нижче.'],
  },
];
---

<BaseLayout title="Політика конфіденційності" description={`Як сайт ${host} обробляє персональні дані та аналітику.`} noindex>
  <article class="wrap legal">
    <p class="kicker"><b>§</b> Документ</p>
    <h1 class="h2">Політика конфіденційності</h1>
    <p class="lead">Коротко і по суті: які дані збирає сайт {host} і навіщо.</p>

    <ol class="legal__list">
      {sections.map((section) => (
        <li>
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </li>
      ))}
      <li>
        <h2>Контакти</h2>
        <p>
          Email: <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a><br />
          Телефон: <a href={`tel:${siteConfig.contact.phone}`}>{siteConfig.contact.phoneDisplay}</a>
        </p>
      </li>
    </ol>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: calc(46rem + var(--gutter) * 2);
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 4rem));
    padding-bottom: 5rem;
  }

  .legal .h2 {
    margin-top: 1.25rem;
  }

  .legal .lead {
    margin-top: 1rem;
  }

  .legal__list {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
    counter-reset: legal;
  }

  .legal__list li {
    counter-increment: legal;
  }

  .legal__list h2 {
    font-size: 1.15rem;
    font-weight: 800;
  }

  .legal__list h2::before {
    content: counter(legal, decimal-leading-zero) " ";
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .legal__list p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }

  .legal__list a {
    color: var(--color-paper);
    text-decoration: underline;
  }
</style>
