---
import PageLayout from '../../layouts/PageLayout.astro';
import { siteConfig } from '../../config/site';

const nonce = Astro.locals.cspNonce;

const blogPosts = [
  {
    slug: 'saas-google-ads-click-fraud',
    title: 'Склікування в Google Ads: як ми захистили SaaS‑кампанію в США',
    excerpt:
      'Кейс про склікування (click fraud): аномальний CTR і CPC, поведінковий аналіз, ClickCease, скарги до Google та корекція стратегії ставок.',
    date: '21 грудня 2025',
    category: 'Google Ads',
    readTime: '11 хв',
    tags: ['Google Ads', 'Аналітика', 'B2B SaaS']
  },
  {
    slug: 'b2b-google-ads-lead-generation',
    title: 'B2B Google Ads: лідогенерація на основі даних та гіпотез',
    excerpt:
      'Практичний гайд з B2B PPC: гіпотези, ключові слова, лендінги, аналітика та кваліфікація лідів для SaaS.',
    date: '20 грудня 2025',
    category: 'Google Ads',
    readTime: '12 хв',
    tags: ['Google Ads', 'Аналітика', 'B2B SaaS']
  }
];

const categories = ['Усі теми', ...Array.from(new Set(blogPosts.map((post) => post.category)))];
---

<PageLayout
  title="Блог"
  description="Практичні кейси й гіди з маркетингу та аналітики."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <span class="inline-block px-4 py-2 bg-accent-500/10 border border-accent-500/20 rounded-full text-accent-400 text-sm font-medium mb-6">
        База знань
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        Блог {siteConfig.brandName}
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        Корисні статті, кейси та інсайти з digital-маркетингу від нашої команди експертів.
      </p>
    </div>
  </section>

  <!-- Categories Filter -->
  <section class="pb-8 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap justify-center gap-3">
        {categories.map((category, index) => (
          <button
            type="button"
            data-filter={category}
            class={`px-5 py-2 rounded-full text-sm font-medium transition-all duration-300 ${
              index === 0
                ? 'bg-accent-500 text-white'
                : 'bg-white/5 text-gray-300 hover:bg-white/10 border border-white/10'
            }`}
          >
            {category}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            data-category={post.category}
            class="group block bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl overflow-hidden hover:border-accent-500/50 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400"
          >
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-accent-500/20 text-accent-400 text-xs font-semibold rounded-full">
                    {post.category}
                  </span>
                </div>
                <svg class="w-5 h-5 text-gray-500 group-hover:text-accent-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </div>

              <div class="flex items-center gap-4 text-sm text-gray-400 mb-2">
                <span>{post.date}</span>
                <span aria-hidden="true">•</span>
                <span>{post.readTime} читання</span>
              </div>

              <h2 class="text-xl font-bold text-white mb-3 group-hover:text-accent-400 transition-colors">
                {post.title}
              </h2>

              <p class="text-gray-300 mb-5 line-clamp-3">
                {post.excerpt}
              </p>

              <span class="inline-flex items-center gap-2 text-accent-400 font-medium group-hover:text-accent-300 transition-colors">
                Читати статтю
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <script is:inline nonce={nonce}>
    const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-category]'));

    const setActive = (activeButton) => {
      filterButtons.forEach((button) => {
        if (button === activeButton) {
          button.classList.add('bg-accent-500', 'text-white');
          button.classList.remove('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
        } else {
          button.classList.remove('bg-accent-500', 'text-white');
          button.classList.add('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
        }
      });
    };

    const applyFilter = (filterValue) => {
      const showAll = filterValue === 'Усі теми';
      cards.forEach((card) => {
        const match = showAll || card.dataset.category === filterValue;
        card.classList.toggle('hidden', !match);
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActive(button);
        applyFilter(button.dataset.filter);
      });
    });
  </script>
</PageLayout>
