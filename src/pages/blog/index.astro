---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, readingTime, formatDate } from '../../lib/blog';

const posts = await getPosts();
---

<BaseLayout
  title="Блог про performance-маркетинг"
  description="Практичні статті про Google Ads, Meta Ads, аналітику, трекінг і B2B-лідогенерацію — з реальних проєктів, без води."
>
  <section class="page-head">
    <div class="wrap">
      <p class="kicker"><b>{String(posts.length).padStart(2, '0')}</b> Блог</p>
      <h1 class="display page-head__title">Нотатки з <em>рекламних кабінетів</em></h1>
      <p class="lead page-head__lead">
        Розбираю реальні ситуації з проєктів: що пішло не так, як я це знайшов і що спрацювало. Без загальних порад з
        інтернету.
      </p>
    </div>
  </section>

  <section class="wrap posts" aria-label="Статті">
    {posts.map((post, index) => (
      <a href={`/blog/${post.id}`} class="post" data-reveal style={`--reveal-i:${index}`}>
        <div class="post__meta">
          <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} хв читання</span>
        </div>
        <h2 class="post__title">{post.data.title}</h2>
        <p class="post__excerpt">{post.data.excerpt}</p>
        <div class="post__foot">
          <ul class="post__tags">
            {post.data.tags.map((tag) => <li class="chip chip--mono">{tag}</li>)}
          </ul>
          <span class="post__arrow"><Icon name="arrow-up-right" size={20} /></span>
        </div>
      </a>
    ))}
  </section>

  <ContactCta location="blog_index" />
</BaseLayout>

<style>
  .page-head {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem));
    padding-bottom: 3rem;
  }

  .page-head__title {
    max-width: 15ch;
    margin-top: 1.25rem;
    font-size: clamp(2.3rem, 1.3rem + 4.5vw, 4.8rem);
  }

  .page-head__lead {
    max-width: 40rem;
    margin-top: 1.25rem;
  }

  .posts {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .post {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) 0;
    border-bottom: 1px solid var(--line);
    transition: padding 300ms var(--ease-out), background-color 300ms ease;
  }

  .post:hover {
    padding-inline: clamp(1rem, 3vw, 2rem);
    background: var(--color-ink-2);
  }

  .post__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .post__title {
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    transition: color 250ms ease;
  }

  .post:hover .post__title {
    color: var(--color-signal-soft);
  }

  .post__excerpt {
    max-width: 44rem;
    color: var(--color-muted);
  }

  .post__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post__arrow {
    display: grid;
    flex: none;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: all 300ms var(--ease-out);
  }

  .post:hover .post__arrow {
    border-color: var(--color-signal);
    background: var(--color-signal);
    transform: rotate(45deg);
  }
</style>
