---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const nonce = Astro.locals.cspNonce;

const meta = {
  title: 'Склікування в Google Ads: як ми захистили SaaS‑кампанію в США',
  description:
    'Кейс про склікування (click fraud) у B2B SaaS: аномальний CTR, низький CPC, поведінкові сигнали, ClickCease, скарги до Google Ads і корекція стратегії.',
  date: '21 грудня 2025',
  readTime: '11 хв читання',
  category: 'Google Ads',
  tags: ['Google Ads', 'B2B SaaS', 'Аналітика', 'Click Fraud']
};

const ogImage = '/images/blog/saas-click-fraud/cleo_keywords_fraud.png';
const publishedDate = '2025-12-21';
const siteUrl = Astro.site?.toString() || 'https://targetsy.agency';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: meta.title,
  description: meta.description,
  image: [new URL(ogImage, siteUrl).toString()],
  datePublished: publishedDate,
  dateModified: publishedDate,
  inLanguage: 'uk',
  mainEntityOfPage: pageUrl,
  author: {
    '@type': 'Organization',
    name: 'Targetsy'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Targetsy',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', siteUrl).toString()
    }
  },
  keywords: meta.tags.join(', '),
  articleSection: ['Google Ads', 'B2B SaaS', 'Click Fraud']
};

const badgeTag = meta.category;

const toc = [
  { id: 'summary', title: 'Коротко про кейс' },
  { id: 'context', title: 'SaaS‑проєкт і конкурентне середовище' },
  { id: 'challenge', title: 'Виклик: ринок високих ставок і склікування' },
  { id: 'how-fraud-works', title: 'Як працює click fraud у Google Ads' },
  { id: 'signals', title: 'Ключові індикатори фрода' },
  { id: 'behavior', title: 'Поведінковий аналіз і підтвердження' },
  { id: 'clickcease', title: 'Тестування ClickCease' },
  { id: 'google-support', title: 'Скарги до Google та відшкодування' },
  { id: 'strategy', title: 'Корекція стратегії Google Ads' },
  { id: 'takeaways', title: 'Ключові висновки' }
];
---

<PageLayout
  title={`${meta.title} | Targetsy`}
  description={meta.description}
  ogTitle={meta.title}
  ogDescription={meta.description}
  ogImage={ogImage}
>
  <script type="application/ld+json" nonce={nonce} set:html={JSON.stringify(structuredData)} />

  <article class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950">
    <!-- Hero -->
    <section class="pt-8 pb-12 px-4">
      <div class="max-w-5xl mx-auto">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
          <a href="/blog" class="hover:text-accent-400 transition-colors">Блог</a>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-white">{meta.title}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="px-4 py-1.5 bg-accent-500/20 text-accent-400 text-sm font-medium rounded-full">
            {badgeTag}
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
          {meta.title}
        </h1>

        <div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
          <span>{meta.date}</span>
          <span aria-hidden="true">•</span>
          <span>{meta.readTime}</span>
        </div>

        <p class="text-xl text-gray-400 mb-8 max-w-3xl leading-relaxed">
          У цьому кейсі показуємо, як ми виявили й зменшили склікування (click fraud) у Google Ads для SaaS‑проєкту в США: від аномального CTR і низького CPC до використання ClickCease та повернення коштів від Google.
        </p>
      </div>
    </section>

    <!-- TOC -->
    <section class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm">
          <h2 class="text-lg font-semibold text-white mb-4">Зміст</h2>
          <ol class="list-decimal list-inside space-y-2 text-gray-300">
            {toc.map((item) => (
              <li>
                <a class="hover:text-accent-400 transition-colors" href={`#${item.id}`}>
                  {item.title}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Summary -->
    <section id="summary" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <h2 class="text-xl font-semibold text-white mb-4">Коротко про кейс</h2>
          <ul class="list-disc list-inside space-y-2 text-gray-300">
            <li>Ринок США, B2B SaaS EDI/API та висока конкуренція за пошук.</li>
            <li>Сплеск склікування (click fraud) після підвищення ставок і видимості.</li>
            <li>Сигнали: CTR 60%+ і CPC ≈ $3 при нормі $30–50.</li>
            <li>Захист: ClickCease + скарги до Google Ads + зміна стратегії.</li>
            <li>Результат: економія 15–20% бюджету та компенсація $966.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section: Context -->
    <section id="context" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">SaaS‑проєкт і конкурентне середовище</h2>
        </div>

        <p class="text-gray-400 mb-6 leading-relaxed">
          Клієнт працює в SaaS на ринку США та продає корпоративні EDI/API інтеграції для бізнесу. Ніша конкурентна, пошуковий обсяг обмежений, а CPC високий. Це робить Google Ads ключовим, але складним каналом для B2B lead generation.
        </p>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <ul class="list-disc list-inside space-y-2 text-gray-300">
            <li>Обмежений попит і висока конкуренція за high‑intent запити.</li>
            <li>Конкуренти з великими бюджетами та агресивними ставками.</li>
            <li>Кожен клік має бути якісним — інакше бюджет “згорає”.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section: Challenge -->
    <section id="challenge" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Виклик: ринок високих ставок і склікування</h2>
        </div>

        <p class="text-gray-400 mb-6 leading-relaxed">
          Реклама означала конкуренцію з великими постачальниками ПЗ і битву за топові позиції. Коли ми підвищили ставки і видимість оголошень, зіткнулися зі стрімким зростанням фроду кліків (click fraud). У США проблема була критичною, тоді як у Канаді, Великій Британії та Європі — мінімальною.
        </p>

        <div class="bg-accent-500/10 border border-accent-500/30 rounded-2xl p-6 text-white leading-relaxed">
          Висновок: склікування стало системною проблемою і вимагало окремої стратегії захисту бюджету.
        </div>
      </div>
    </section>

    <!-- Section: How Fraud Works -->
    <section id="how-fraud-works" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Як працює click fraud у Google Ads</h2>
        </div>

        <p class="text-gray-400 mb-6 leading-relaxed">
          Склікування в B2B Google Ads — це не лише випадкові боти. У дорогих нішах конкуренти можуть використовувати автоматизацію, щоб “вибити” вас з аукціону.
        </p>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <ul class="list-disc list-inside space-y-2 text-gray-300">
            <li><strong class="text-white">Автоботи</strong>: кліки з випадковими інтервалами.</li>
            <li><strong class="text-white">Проксі/VPN</strong>: динамічні IP‑адреси, ротація.</li>
            <li><strong class="text-white">Headless Chrome</strong>: емулює “живий” браузер.</li>
            <li><strong class="text-white">Клікові ферми</strong>: реальні люди в дешевих регіонах.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section: Signals -->
    <section id="signals" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Ключові індикатори фрода</h2>
        </div>

        <p class="text-gray-400 mb-6 leading-relaxed">
          Ми побачили сильні відхилення від історичної норми. Це були типові “червоні прапорці” click fraud:
        </p>

        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 space-y-2">
            <h3 class="text-lg font-semibold text-white">Аномальні метрики</h3>
            <ul class="list-disc list-inside text-gray-300 space-y-1">
              <li>CTR понад 60% (норма: 5–8%).</li>
              <li>CPC ≈ $3 замість $30–50 за high‑intent запити.</li>
              <li>150+ кліків за кілька днів при обсязі 10–40/міс.</li>
              <li>0 конверсій при звичних 2–4%.</li>
            </ul>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 space-y-2">
            <h3 class="text-lg font-semibold text-white">Скріншоти доказів</h3>
            <p class="text-gray-300 text-sm">
              Дані з Google Ads та Keyword Planner підтвердили аномальний обсяг кліків.
            </p>
          </div>
        </div>

        <figure class="bg-white/5 border border-white/10 rounded-2xl p-4 mb-6">
          <img
            src="/images/blog/saas-click-fraud/cleo_keywords_fraud.png"
            alt="Скріншот ключових слів Google Ads із високим CTR і низьким CPC"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
          <figcaption class="text-sm text-gray-400 mt-3">
            Скріншот ключових слів: підозріло високий CTR і низький CPC.
          </figcaption>
        </figure>

        <figure class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <img
            src="/images/blog/saas-click-fraud/cleo_keywords_volume.png"
            alt="Обʼєм пошукових запитів: 10–40 на місяць проти 150+ кліків"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
          <figcaption class="text-sm text-gray-400 mt-3">
            Обʼєм пошуку в Google Keyword Planner і фактична кількість кліків.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Section: Behavior -->
    <section id="behavior" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Поведінковий аналіз і підтвердження</h2>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <ul class="list-disc list-inside space-y-2 text-gray-300">
            <li>Сесії &lt; 3 секунд (норма — 30+ секунд).</li>
            <li>Відсутність прокрутки або подій.</li>
            <li>Кліки з різних штатів без стабільного IP‑патерну.</li>
          </ul>
          <p class="text-gray-300 mt-4">
            Ручне блокування IP не працювало: адреси постійно змінювались, а географія кліків була розпорошена — це вказувало на бот‑мережі або клікові ферми.
          </p>
        </div>
      </div>
    </section>

    <!-- Section: ClickCease -->
    <section id="clickcease" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Тестування ClickCease</h2>
        </div>

        <p class="text-gray-400 mb-6 leading-relaxed">
          Ми підключили ClickCease для фільтрації підозрілих кліків. За місяць вдалося зекономити 15–20% бюджету (≈ $8,000). Тестували ліміти 2–3 кліки/IP та агресивний режим блокування — фрод падав, але інколи “зрізався” і легітимний трафік.
        </p>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mb-6">
          <h3 class="text-lg font-semibold text-white mb-2">Як ClickCease відсікає фрод</h3>
          <ul class="list-disc list-inside space-y-2 text-gray-300">
            <li>IP та device fingerprinting.</li>
            <li>Блокування повторних кліків з підмереж.</li>
            <li>Поведенкова перевірка (bounce rate, session duration).</li>
          </ul>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mb-6">
          <h3 class="text-lg font-semibold text-white mb-2">Обмеження та ручні коригування</h3>
          <p class="text-gray-300">
            Динамічні IP, VPN і дата‑центри інколи проходять фільтри. Це вимагає постійних ручних корекцій і регулярного перегляду звітів, щоб не блокувати реальних користувачів.
          </p>
        </div>

        <figure class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <img
            src="/images/blog/saas-click-fraud/cleo_clickcease.png"
            alt="ClickCease: приклад економії бюджету від блокування фродових кліків"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
          <figcaption class="text-sm text-gray-400 mt-3">
            ClickCease: збережені кліки та економія бюджету.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Section: Google Support -->
    <section id="google-support" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Скарги до Google та відшкодування</h2>
        </div>

        <p class="text-gray-400 mb-6 leading-relaxed">
          Ми зверталися до підтримки Google Ads з детальними доказами. Google підтвердив невалідний трафік і нарахував компенсацію ($966).
        </p>

        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">Що передав у підтримку</h3>
            <ul class="list-disc list-inside text-gray-300 space-y-1">
              <li>Назви кампаній і ключові слова.</li>
              <li>Періоди з аномальним CTR та CPC.</li>
              <li>Звіти зі стороннього ПЗ з детекції фроду.</li>
              <li>Скріншоти трендів трафіку.</li>
            </ul>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">Як працюють відшкодування</h3>
            <ul class="list-disc list-inside text-gray-300 space-y-1">
              <li>Google повертає кошти у вигляді кредитів.</li>
              <li>Сума залежить від підтвердженого обсягу невалідних кліків.</li>
              <li>Повернення може бути частковим.</li>
              <li>Кредити з’являються у звіті транзакцій.</li>
            </ul>
          </div>
        </div>

        <figure class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <img
            src="/images/blog/saas-click-fraud/cleo_googleads_refund.png"
            alt="Лист підтримки Google Ads про невалідні кліки та компенсацію"
            class="rounded-xl w-full border border-white/10"
            loading="lazy"
          />
          <figcaption class="text-sm text-gray-400 mt-3">
            Відповідь підтримки Google Ads щодо невалідних кліків.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Section: Strategy -->
    <section id="strategy" class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
