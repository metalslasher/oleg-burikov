---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ogImage } from '../../lib/og';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import { getServicePage, servicePages } from '../../data/services';
import { getCase } from '../../data/cases';
import { getPosts } from '../../lib/blog';
import { emphasize, plain, pad2 } from '../../lib/text';
import { absoluteUrl, siteConfig } from '../../config/site';

const page = getServicePage(Astro.params.slug || '');
if (!page) {
  return Astro.rewrite('/404');
}

const relatedCases = page.caseSlugs.map(getCase).filter((item) => item !== undefined);
const posts = (await getPosts()).filter((post) => page.blogSlugs?.includes(post.id));
const otherServices = servicePages.filter((item) => item.slug !== page.slug);
const url = absoluteUrl(`/services/${page.slug}`);

const schema = [
  {
    '@type': 'Service',
    name: plain(page.h1),
    serviceType: page.name,
    description: page.seo.description,
    url,
    provider: { '@id': `${siteConfig.siteUrl}/#person` },
    areaServed: [
      { '@type': 'Country', name: 'Україна' },
      { '@type': 'Place', name: 'Європа' },
      { '@type': 'Country', name: 'США' },
    ],
    availableLanguage: ['uk', 'en'],
  },
  {
    '@type': 'FAQPage',
    mainEntity: page.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Послуги', item: absoluteUrl('/services') },
      { '@type': 'ListItem', position: 3, name: page.name, item: url },
    ],
  },
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} ogImage={ogImage(`service-${page.slug}`)} schema={schema}>
  <section class="svc-hero">
    <div class="svc-hero__glow" aria-hidden="true"></div>
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлібні крихти">
        <a href="/">Головна</a>
        <span aria-hidden="true">/</span>
        <a href="/services">Послуги</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{page.name}</span>
      </nav>
      <h1 class="display svc-hero__title" set:html={emphasize(page.h1)} />
      <p class="lead svc-hero__lead">{page.lead}</p>
      <div class="svc-hero__actions">
        <a href="#contact" class="btn btn--primary" data-contact-service="Реклама під ключ" data-gtm-event="cta_click" data-gtm-label="service_hero" data-gtm-location={`service_${page.slug}`}>
          Обговорити задачу <Icon name="arrow-up-right" />
        </a>
        <a href="#contact" class="btn btn--ghost" data-contact-service="Аудит" data-gtm-event="cta_click" data-gtm-label="service_audit" data-gtm-location={`service_${page.slug}`}>
          Замовити аудит
        </a>
      </div>
      <dl class="facts">
        {page.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section block" aria-labelledby="pains">
    <div class="wrap split">
      <div>
        <p class="kicker"><b>01</b> Коли це потрібно</p>
        <h2 id="pains" class="h2" style="margin-top:1rem">Знайомі <em>ситуації</em>?</h2>
      </div>
      <ul class="pains">
        {page.pains.map((pain, index) => (
          <li data-reveal style={`--reveal-i:${index}`}>
            <span class="pains__mark" aria-hidden="true">!</span>
            {pain}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section block" aria-labelledby="included">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker"><b>02</b> Що входить</p>
        <h2 id="included" class="h2">Що я <em>роблю</em></h2>
      </div>
      <div class="included">
        {page.included.map((item, index) => (
          <article class="included__item" data-reveal data-spotlight style={`--reveal-i:${index % 3}`}>
            <span class="included__num">{pad2(index + 1)}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <ul class="tools" aria-label="Інструменти">
        {page.tools.map((tool) => <li class="chip chip--mono">{tool}</li>)}
      </ul>
    </div>
  </section>

  <section class="section block" aria-labelledby="steps">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker"><b>03</b> Як працюю</p>
        <h2 id="steps" class="h2">Від першої розмови до <em>результату</em></h2>
      </div>
      <ol class="steps">
        {page.steps.map((step, index) => (
          <li class="step" data-reveal style={`--reveal-i:${index}`}>
            <span class="step__num">{pad2(index + 1)}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {relatedCases.length > 0 && (
    <section class="section block" aria-labelledby="proof">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker"><b>04</b> Кейси</p>
          <h2 id="proof" class="h2">Результати в <em>цифрах</em></h2>
        </div>
        <div class="proof">
          {relatedCases.map((item, index) => (
            <a href={`/cases/${item.slug}`} class="proof__card" data-reveal style={`--reveal-i:${index % 2}`}>
              <span class="proof__meta">{item.niche} · {item.channels.join(' + ')}</span>
              <span class="proof__title" set:html={emphasize(item.headline)} />
              <span class="proof__metrics">
                {item.highlights.map((metric) => (
                  <span>
                    <b class="num">{metric.value}</b>
                    <small>{metric.label}</small>
                  </span>
                ))}
              </span>
              <span class="proof__more">Читати кейс <Icon name="arrow-right" size={16} /></span>
            </a>
          ))}
        </div>
        {posts.length > 0 && (
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="link-arrow">Стаття: {post.data.title} <Icon name="arrow-right" size={16} /></a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <section class="section block" aria-labelledby="faq">
    <div class="wrap split">
      <div>
        <p class="kicker"><b>05</b> Питання</p>
        <h2 id="faq" class="h2" style="margin-top:1rem">Часті <em>питання</em></h2>
      </div>
      <div class="faq">
        {page.faq.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon"><Icon name="plus" size={18} /></span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <nav class="wrap others" aria-label="Інші послуги">
    <p class="others__title">Інші послуги</p>
    <div class="others__list">
      {otherServices.map((item) => (
        <a href={`/services/${item.slug}`} class="others__link">
          {item.name} <Icon name="arrow-up-right" size={18} />
        </a>
      ))}
    </div>
  </nav>

  <ContactCta location={`service_${page.slug}`} title={`Обговоримо ваш *${page.name}*?`} />
</BaseLayout>

<style>
  .svc-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 3.5rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .svc-hero__glow {
    position: absolute;
    z-index: -1;
    top: -20%;
    right: -15%;
    width: min(70vw, 50rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 90 31 / 0.22), transparent 65%);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-faint);
    font-size: 0.86rem;
  }

  .crumbs a:hover {
    color: var(--color-paper);
  }

  .crumbs [aria-current] {
    color: var(--color-muted);
  }

  .svc-hero__title {
    max-width: 18ch;
    margin-top: 1.5rem;
    font-size: clamp(2.1rem, 1.2rem + 3.8vw, 4.2rem);
  }

  .svc-hero__title :global(em),
  .proof__title :global(em) {
    color: var(--color-signal);
    font-style: normal;
  }

  .svc-hero__lead {
    max-width: 44rem;
    margin-top: 1.4rem;
  }

  .svc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .facts {
    display: grid;
    gap: 1px;
    margin-top: 2.75rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
  }

  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts div {
    padding: 1.1rem 1.3rem;
    background: var(--color-ink-2);
  }

  .facts dt {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .facts dd {
    margin-top: 0.3rem;
    font-weight: 700;
  }

  .block {
    border-top: 1px solid var(--line);
  }

  .split {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
  }

  .pains {
    display: grid;
    gap: 0.75rem;
  }

  .pains li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--color-ink-2);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .pains__mark {
    display: grid;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 90 31 / 0.15);
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .included {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .included {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .included {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .included__item {
    position: relative;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--color-ink-2);
    overflow: hidden;
    transition: border-color 300ms ease;
  }

  .included__item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), rgb(255 90 31 / 0.12), transparent 55%);
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  .included__item:hover {
    border-color: rgb(255 90 31 / 0.45);
  }

  .included__item:hover::before {
    opacity: 1;
  }

  .included__num,
  .step__num {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .included__item h3,
  .step h3 {
    margin-top: 0.7rem;
    font-size: 1.12rem;
    font-weight: 800;
  }

  .included__item p,
  .step p {
    margin-top: 0.45rem;
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .steps {
    display: grid;
    gap: 1.5rem;
    counter-reset: s;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step {
    padding-top: 1.25rem;
    border-top: 2px solid var(--line-strong);
    transition: border-color 600ms ease;
  }

  .step.is-visible {
    border-top-color: var(--color-signal);
    transition-delay: calc(var(--reveal-i) * 200ms);
  }

  .proof {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 800px) {
    .proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .proof__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--color-ink-2);
    transition: border-color 300ms ease;
  }

  .proof__card:hover {
    border-color: rgb(255 90 31 / 0.55);
  }

  .proof__meta {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .proof__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .proof__metrics {
    display: flex;
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .proof__metrics span {
    display: grid;
  }

  .proof__metrics b {
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .proof__metrics small {
    color: var(--color-faint);
    font-size: 0.8rem;
  }

  .proof__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-weight: 700;
  }

  .posts {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .faq {
    border-top: 1px solid var(--line);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.3rem 0;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    display: grid;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: transform 300ms var(--ease-out), background-color 300ms ease, border-color 300ms ease;
  }

  .faq details[open] .faq__icon {
    border-color: var(--color-signal);
    background: var(--color-signal);
    transform: rotate(45deg);
  }

  .faq details p {
    padding: 0 3rem 1.4rem 0;
    color: var(--color-muted);
  }

  .others {
    padding-block: 3rem 1rem;
  }

  .others__title {
    margin-bottom: 1rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .others__list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .others__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 0;
      gap: 1rem;
    }
  }

  .others__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    transition: color 200ms ease;
  }

  .others__link:hover {
    color: var(--color-signal-soft);
  }
</style>
