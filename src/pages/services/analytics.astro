---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import content from '../../content/home-uk.json';

const nonce = Astro.locals.cspNonce;

const benefits = [
  {
    title: 'Google Analytics 4',
    description: 'Налаштування GA4 для відстеження поведінки користувачів та конверсій',
    icon: '📊'
  },
  {
    title: 'Google Tag Manager',
    description: 'Централізоване управління всіма тегами та пікселями на сайті',
    icon: '🏷️'
  },
  {
    title: 'Conversion Tracking',
    description: 'Налаштування відстеження цілей та електронної комерції',
    icon: '🎯'
  },
  {
    title: 'Microsoft Clarity',
    description: 'Теплові карти та записи сесій для розуміння поведінки користувачів',
    icon: '🔥'
  },
  {
    title: 'Дашборди та звіти',
    description: 'Створення зрозумілих звітів та дашбордів в Looker Studio',
    icon: '📈'
  },
  {
    title: 'Server-side tracking',
    description: 'Серверне відстеження для точніших даних та обходу блокувальників',
    icon: '🖥️'
  }
];

const process = [
  { step: '01', title: 'Аудит', description: 'Перевіряємо поточний стан аналітики та виявляємо проблеми' },
  { step: '02', title: 'Планування', description: 'Визначаємо ключові метрики та події для відстеження' },
  { step: '03', title: 'Впровадження', description: 'Налаштовуємо всі системи аналітики та тестуємо' },
  { step: '04', title: 'Навчання', description: 'Навчаємо вашу команду працювати зі звітами' },
];


const caseSlides = content.cases.items.map((caseItem, index) => ({
  ...caseItem,
  slug: `case-${index + 1}`,
}));

const deliverables = [
  {
    title: 'Аудит аналітики',
    description: 'Перевіряємо коректність подій, цілей і передачі конверсій.',
  },
  {
    title: 'GA4 + GTM',
    description: 'Налаштовуємо GA4 та Google Tag Manager під вашу структуру сайту.',
  },
  {
    title: 'Конверсії для реклами',
    description: 'Передаємо конверсії у Google Ads та Meta Ads для оптимізації ставок.',
  },
  {
    title: 'E-commerce події',
    description: 'Події покупки, кошика, checkout, параметри товарів і доходу.',
  },
  {
    title: 'Looker Studio',
    description: 'Збираємо зрозумілі дашборди для контролю ключових KPI.',
  },
  {
    title: 'Якість даних',
    description: 'Фільтри, UTM‑структура, перевірка точності та стабільності вимірювань.',
  },
];

---

<PageLayout 
  title="Веб-аналітика та трекінг конверсій | Targetsy Agency"
  description="Налаштовуємо GA4 та Google Tag Manager так, щоб ви бачили реальні дані: події, конверсії, джерела продажів і ефективність реклами. Без “сліпих зон” у звітах."
><!-- Hero -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            <span class="text-green-400">
              Веб-аналітика
            </span>
          </h1>
          
          <p class="text-xl text-gray-400 mb-8">
            Налаштовуємо аналітику так, щоб ви бачили реальний внесок реклами в продажі.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a
              href="#contact"
              data-gtm-event="cta_click"
              data-gtm-label="analytics_hero_contact"
              data-gtm-location="service_hero"
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-8 py-4 rounded-xl font-semibold hover:shadow-lg hover:shadow-green-500/30 transition-all"
            >
              Замовити аудит аналітики
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
        
                <div class="w-full lg:justify-self-end">
          <div class="case-slider w-full">
            {caseSlides.map((caseItem, index) => (
              <article class={`case-slide ${index === 0 ? 'is-active' : ''}`} data-case-slide aria-hidden={index === 0 ? 'false' : 'true'}>
                <div class="case-card bg-gradient-to-br from-green-500/15 to-emerald-500/15 border border-green-500/30 rounded-3xl p-8">
                  <div class="text-xs uppercase tracking-wide text-green-200/80">{caseItem.industry}</div>
                  <h2 class="text-2xl font-bold text-white mt-2 mb-3">{caseItem.client}</h2>
                  <p class="text-gray-400 text-sm leading-relaxed line-clamp-3">{caseItem.challenge}</p>
                  <div class="grid grid-cols-2 gap-3 mt-6">
                    {caseItem.results.slice(0, 2).map((result) => (
                      <div class="case-metric bg-white/5 border border-white/10 rounded-xl p-3">
                        <div class="text-lg font-semibold text-white">{result.value}</div>
                        <div class="text-xs text-gray-400">{result.metric}</div>
                      </div>
                    ))}
                  </div>
                  <a href={`/cases/${caseItem.slug}`} class="inline-flex items-center gap-2 text-green-300 hover:text-green-200 font-semibold mt-6">
                    Дивитись кейс
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що входить в послугу?
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Повний спектр інструментів для вимірювання та аналізу ефективності вашого бізнесу
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <div class="text-4xl mb-4">{benefit.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{benefit.title}</h3>
            <p class="text-gray-400">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що ви отримуєте з аналітики
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Чіткі дані та звіти, на основі яких можна приймати рішення.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {deliverables.map((item) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        Як ми працюємо
      </h2>
      
      <div class="grid md:grid-cols-4 gap-8">
        {process.map((item) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 text-center hover:bg-white/10 transition-colors">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-r from-green-500 to-emerald-500 flex items-center justify-center text-white font-bold text-xl">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>

<script is:inline nonce={nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = Array.from(document.querySelectorAll('[data-case-slide]'));
    if (slides.length <= 1) return;
    let current = 0;
    const update = (index) => {
      const total = slides.length;
      slides.forEach((slide) => {
        slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-next-secondary');
        slide.setAttribute('aria-hidden', 'true');
      });

      const next = (index + 1) % total;
      const prev = (index - 1 + total) % total;
      const nextSecondary = (index + 2) % total;

      slides[index].classList.add('is-active');
      slides[index].setAttribute('aria-hidden', 'false');

      if (total > 1) slides[next].classList.add('is-next');
      if (total > 2) slides[prev].classList.add('is-prev');
      if (total > 3) slides[nextSecondary].classList.add('is-next-secondary');
    };

    const advance = () => {
      current = (current + 1) % slides.length;
      update(current);
    };

    update(0);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let timer = setInterval(advance, 6000);
    const slider = document.querySelector('.case-slider');
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };
    const start = () => {
      if (!timer) timer = setInterval(advance, 6000);
    };

    if (slider) {
      slider.addEventListener('mouseenter', stop);
      slider.addEventListener('mouseleave', start);
      slider.addEventListener('focusin', stop);
      slider.addEventListener('focusout', start);
      slider.addEventListener('touchstart', stop, { passive: true });
      slider.addEventListener('touchend', start, { passive: true });
    }
  });
</script>

<style>
  .case-slider {
    position: relative;
    min-height: clamp(360px, 45vw, 440px);
    overflow: visible;
  }

  .case-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    transform: translateY(24px) scale(0.96);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .case-slide.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    z-index: 3;
    pointer-events: auto;
  }

  .case-slide.is-next {
    opacity: 0.5;
    transform: translateX(28px) translateY(18px) scale(0.96);
    z-index: 2;
  }

  .case-slide.is-prev {
    opacity: 0.25;
    transform: translateX(-22px) translateY(24px) scale(0.94);
    z-index: 1;
  }

  .case-slide.is-next-secondary {
    opacity: 0.15;
    transform: translateX(52px) translateY(32px) scale(0.92);
    z-index: 0;
  }

  .case-card {
    background-color: rgba(12, 20, 36, 0.96);
  }

  .case-slide.is-next .case-card,
  .case-slide.is-prev .case-card,
  .case-slide.is-next-secondary .case-card {
    background-color: rgba(12, 20, 36, 0.9);
  }

  .case-slide.is-active .case-metric {
    border-color: rgba(52, 211, 153, 0.4);
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .case-slider {
      min-height: 420px;
    }

    .case-slide.is-prev,
    .case-slide.is-next-secondary {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }

    .case-slide.is-next {
      opacity: 0.35;
      transform: translateX(16px) translateY(16px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-slide {
      transition: none;
    }
  }
</style>




