---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const benefits = [
  {
    title: 'Google Analytics 4',
    description: 'Налаштування GA4 для відстеження поведінки користувачів та конверсій',
    icon: '📊'
  },
  {
    title: 'Google Tag Manager',
    description: 'Централізоване управління всіма тегами та пікселями на сайті',
    icon: '🏷️'
  },
  {
    title: 'Conversion Tracking',
    description: 'Налаштування відстеження цілей та електронної комерції',
    icon: '🎯'
  },
  {
    title: 'Microsoft Clarity',
    description: 'Теплові карти та записи сесій для розуміння поведінки користувачів',
    icon: '🔥'
  },
  {
    title: 'Дашборди та звіти',
    description: 'Створення зрозумілих звітів та дашбордів в Looker Studio',
    icon: '📈'
  },
  {
    title: 'Server-side tracking',
    description: 'Серверне відстеження для точніших даних та обходу блокувальників',
    icon: '🖥️'
  }
];

const process = [
  { step: '01', title: 'Аудит', description: 'Перевіряємо поточний стан аналітики та виявляємо проблеми' },
  { step: '02', title: 'Планування', description: 'Визначаємо ключові метрики та події для відстеження' },
  { step: '03', title: 'Впровадження', description: 'Налаштовуємо всі системи аналітики та тестуємо' },
  { step: '04', title: 'Навчання', description: 'Навчаємо вашу команду працювати зі звітами' },
];
---

<PageLayout 
  title="Веб-аналітика | Targetsy Agency"
  description="Налаштування Google Analytics 4, Google Tag Manager, Microsoft Clarity. Відстеження конверсій, електронна комерція, дашборди та звіти."
>
  <!-- Hero -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/services" class="inline-flex items-center text-accent-400 hover:text-accent-300 mb-6">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Всі послуги
          </a>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            <span class="text-green-400">
              Веб-аналітика
            </span>
          </h1>
          
          <p class="text-xl text-gray-400 mb-8">
            Впроваджуємо системи аналітики, які дають чітке розуміння: звідки приходять клієнти, 
            скільки коштує конверсія, і що потрібно покращити.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="#contact" class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-8 py-4 rounded-xl font-semibold hover:shadow-lg hover:shadow-green-500/30 transition-all">
              Замовити аудит аналітики
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="bg-gradient-to-br from-green-500/20 to-emerald-500/20 backdrop-blur-sm rounded-3xl p-8 border border-green-500/30">
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                  <span class="text-2xl">📊</span>
                </div>
                <div>
                  <div class="text-white font-semibold">Google Analytics 4</div>
                  <div class="text-gray-400 text-sm">Сертифіковані спеціалісти</div>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                  <span class="text-2xl">🏷️</span>
                </div>
                <div>
                  <div class="text-white font-semibold">Google Tag Manager</div>
                  <div class="text-gray-400 text-sm">Експерти з тегування</div>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                  <span class="text-2xl">📈</span>
                </div>
                <div>
                  <div class="text-white font-semibold">Looker Studio</div>
                  <div class="text-gray-400 text-sm">Кастомні дашборди</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що входить в послугу?
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Повний спектр інструментів для вимірювання та аналізу ефективності вашого бізнесу
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <div class="text-4xl mb-4">{benefit.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{benefit.title}</h3>
            <p class="text-gray-400">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        Як ми працюємо
      </h2>
      
      <div class="grid md:grid-cols-4 gap-8">
        {process.map((item) => (
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-r from-green-500 to-emerald-500 flex items-center justify-center text-white font-bold text-xl">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Hint -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="bg-gradient-to-r from-green-500/10 to-emerald-500/10 border border-green-500/30 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-4">Вартість послуги</h2>
        <p class="text-gray-400 mb-6">
          Вартість залежить від складності проекту та кількості подій для відстеження. 
          Базове налаштування GA4 + GTM від $200. Повний аудит та впровадження від $500.
        </p>
        <a href="/pricing" class="inline-flex items-center text-green-400 hover:text-green-300 font-medium">
          Дізнатись детальніше про ціни
          <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
