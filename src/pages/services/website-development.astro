  <script nonce={nonce}>
    const baseWidth = 900;
    const baseHeight = 1200;
    const frames = document.querySelectorAll('.wd-case__frame');

    const applyScale = (frame) => {
      const width = frame.clientWidth;
      if (!width) return;
      const scale = width / baseWidth;
      frame.style.setProperty('--demo-scale', scale.toFixed(3));
      frame.style.height = `${Math.round(baseHeight * scale)}px`;
    };

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver((entries) => {
        entries.forEach((entry) => applyScale(entry.target));
      });
      frames.forEach((frame) => observer.observe(frame));
    } else {
      const update = () => frames.forEach(applyScale);
      update();
      window.addEventListener('resize', update);
    }
  </script>

