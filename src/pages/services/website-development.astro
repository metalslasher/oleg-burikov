---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const nonce = Astro.locals.cspNonce;



const trustStats = [
  { value: '5+ років', label: 'у digital маркетингу' },
  { value: '50+ проєктів', label: 'для бізнесів України' },
  { value: '90%', label: 'клієнтів рекомендують нас' },
  { value: '+45%', label: 'середнє зростання CR' },
];

const clientLogos = [
  'SaaS',
  'Fintech',
  'E-commerce',
  'EdTech',
  'Healthcare',
  'Logistics',
  'Manufacturing',
  'Real Estate',
];

const principles = [
  {
    title: 'Фокус на бізнес-цілях',
    description:
      'Починаємо з ролі сайту в маркетингу: продажі, заявки або бренд. Далі будуємо сторінки під цю мету.',
  },
  {
    title: 'UX, що веде до дії',
    description:
      'Кожен блок відповідає на запитання користувача, підсилює довіру та підштовхує до правильного рішення.',
  },
  {
    title: 'Швидкість і SEO',
    description:
      'Оптимізуємо структуру, технічні параметри та контент так, щоб сайт стабільно ріс в органіці.',
  },
];

const formats = [
  {
    title: 'Landing для запуску',
    description: 'Фокус на одній пропозиції, швидкий запуск і чіткі CTA для тестування попиту.',
    meta: ['2-3 тижні', 'CRO фокус'],
  },
  {
    title: 'Корпоративний сайт',
    description: 'Стратегічна структура, брендова подача і сторінки під основні напрямки бізнесу.',
    meta: ['4-6 тижнів', 'B2B/Brand'],
  },
  {
    title: 'Інтернет-магазин',
    description: 'Каталог, фільтри, кошик і промо-блоки для росту конверсії та середнього чеку.',
    meta: ['6-10 тижнів', 'E-commerce'],
  },
  {
    title: 'SaaS або продукт',
    description: 'Сторінки під воронку, onboarding, pricing та сторінки підтримки.',
    meta: ['6-8 тижнів', 'Product UX'],
  },
];

const process = [
  {
    step: '01',
    icon: 'brief',
    title: 'Бриф і аналітика',
    description: 'Визначаємо цільову аудиторію, конкурентів, KPI та головну мету сайту.',
  },
  {
    step: '02',
    icon: 'ux',
    title: 'UX карта і структура',
    description: 'Проєктуємо логіку сторінок, формуємо контент і сценарії для користувача.',
  },
  {
    step: '03',
    icon: 'concept',
    title: 'Концепція та вайрфрейм',
    description: 'Затверджуємо основу дизайну та розміщення ключових блоків.',
  },
  {
    step: '04',
    icon: 'ui',
    title: 'UI дизайн',
    description: 'Створюємо візуальну систему, адаптиви та дизайн усіх сторінок.',
  },
  {
    step: '05',
    icon: 'dev',
    title: 'Розробка і CMS',
    description: 'Верстка, інтеграції, налаштування швидкості, SEO і аналітики.',
  },
  {
    step: '06',
    icon: 'launch',
    title: 'Запуск і підтримка',
    description: 'QA, запуск, супровід і навчання вашої команди по управлінню сайтом.',
  },
];

const processIcons = {
  brief: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6l1.2 2.4H20a1 1 0 0 1 1 1v12.6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6.4a1 1 0 0 1 1-1h3.8L9 3z"/><path d="M9 12l2 2 4-4"/></svg>`,
  ux: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="7" height="7" rx="1.5"/><rect x="14" y="4" width="7" height="7" rx="1.5"/><rect x="3" y="13" width="7" height="7" rx="1.5"/><path d="M14 13h7v7h-7z"/><path d="M10 7h4"/><path d="M10 16h4"/></svg>`,
  concept: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12c.7.6 1.2 1.4 1.4 2.3L9.6 18h4.8l.2-1.7c.2-.9.7-1.7 1.4-2.3A7 7 0 0 0 12 2z"/></svg>`,
  ui: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 1 0-9-9c0 4.4 3.6 8 8 8h1z"/><circle cx="8" cy="10" r="1"/><circle cx="12" cy="8" r="1"/><circle cx="16" cy="10" r="1"/><circle cx="9" cy="14.5" r="1"/></svg>`,
  dev: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/><path d="M10 19l4-14"/></svg>`,
  launch: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M6.4 6.4l3.1 3.1"/><path d="M17.6 17.6l-3.1-3.1"/><path d="M6.4 17.6l3.1-3.1"/><path d="M17.6 6.4l-3.1 3.1"/></svg>`,
};

const deliverables = [
  'UX структура і логіка сторінок',
  'UI дизайн + дизайн-система',
  'Розробка сайту з адаптивами',
  'CMS під вашу команду',
  'SEO база: структура, метадані, схема',
  'Аналітика: GA4, GTM, події та цілі',
  'Інтеграції з CRM і сервісами',
  'Інструкція та підтримка після запуску',
];

const toolbox = [
  'Figma',
  'Astro або Next.js',
  'WordPress / Webflow',
  'Headless CMS',
  'GA4 + GTM',
  'Hotjar або Clarity',
  'CRM інтеграції',
];

const performanceSignals = [
  { value: 'LCP < 2s', label: 'Core Web Vitals' },
  { value: 'GA4 + GTM', label: 'події та воронки' },
  { value: 'CRM-ready', label: 'готовність до лідів' },
];

const packages = [
  {
    title: 'Start',
    subtitle: 'Сайт для MVP',
    timeline: '2-3 тижні',
    focus: 'Launch',
    description: 'Швидкий запуск і фокус на одній пропозиції.',
    includes: ['Бриф і аналітика', 'UX + UI дизайн', 'Розробка + оптимізація', 'Запуск і підтримка'],
    price: 'від $1 200',
    accent: '#38bdf8',
  },
  {
    title: 'Growth',
    subtitle: 'Корпоративний сайт',
    timeline: '4-6 тижнів',
    focus: 'Brand',
    description: 'Сильна структура, брендова подача та SEO база.',
    includes: ['Стратегія і структура', 'UI kit і дизайн сторінок', 'CMS і інтеграції', 'Аналітика і SEO'],
    price: 'від $3 500',
    accent: '#f97316',
  },
  {
    title: 'Scale',
    subtitle: 'E-commerce або SaaS',
    timeline: '6-10 тижнів',
    focus: 'Conversion',
    description: 'Складні сценарії, інтеграції та оптимізація конверсії.',
    includes: ['Каталог або продуктові сторінки', 'Онбординг і сценарії', 'Інтеграції і QA', 'Підтримка запуску'],
    price: 'від $6 000',
    accent: '#2563eb',
  },
];

const testimonials = [
  {
    quote:
      'Команда занурилась у бізнес і побудувала сайт, який підсвітив сильні сторони продукту та збільшив кількість заявок.',
    name: 'Анна',
    role: 'Head of Marketing',
    company: 'B2B SaaS',
    result: '+41% заявок',
    initials: 'АП',
    accent: '#38bdf8',
  },
  {
    quote:
      'Ми отримали красивий сайт і чітку структуру. Конверсія зросла вже в перший місяць після запуску.',
    name: 'Сергій',
    role: 'Founder',
    company: 'E-commerce',
    result: '+32% CR',
    initials: 'СР',
    accent: '#f97316',
  },
  {
    quote:
      'Дизайн і UX були на рівні. Клієнти швидше знаходять потрібну інформацію та залишають заявки.',
    name: 'Олена',
    role: 'CMO',
    company: 'EdTech',
    result: '+24% лідів',
    initials: 'ОК',
    accent: '#2563eb',
  },
];

const guarantees = [
  {
    title: 'Прозорий план робіт',
    description: 'Фіксуємо roadmap і дедлайни, щоб ви бачили прогрес щотижня.',
  },
  {
    title: 'Прогнозований результат',
    description: 'Опора на аналітику і кращі практики конверсії.',
  },
  {
    title: '2 кола правок',
    description: 'Вносимо правки по дизайну і контенту без бюрократії.',
  },
  {
    title: 'Підтримка після запуску',
    description: '30 днів супроводу для стабільної роботи сайту.',
  },
];


---
<PageLayout
  title="Розробка сайтів для бізнесу | Targetsy Agency"
  description="Створюємо сайти, що конвертують: UX, дизайн, розробка, SEO база, інтеграції та аналітика для росту бізнесу."
>

  <div class="wd-page">
    <section class="wd-hero">
      <div class="max-w-7xl mx-auto relative">
        <div class="wd-hero__grid">
          <div class="wd-hero__copy">
            <h1 class="wd-title">
              Розробка сайтів, що
              <span
                class="wd-title__accent wd-rotate"
                data-words="продають|вражають|переконують|запам'ятовуються"
              >
                продають
              </span>
            </h1>
            <p class="wd-subtitle">
              Стратегія, UX, дизайн і код, які ведуть користувача до дії, підсилюють маркетинг і не гальмують
              швидкість.
            </p>
            <div class="wd-hero__cta">
              <a
                href="#contact"
                data-gtm-event="cta_click"
                data-gtm-label="website_dev_hero_contact"
                data-gtm-location="service_hero"
                class="wd-btn wd-btn--primary"
              >Замовити сайт</a>
              <a href="#process" class="wd-btn wd-btn--ghost">Подивитись процес</a>
            </div>
          </div>

          <div class="wd-hero__build">
            <div class="wd-build" aria-hidden="true">
              <div class="wd-build__screen">
                <div class="wd-build__top">
                  <span class="wd-build__dot"></span>
                  <span class="wd-build__dot"></span>
                  <span class="wd-build__dot"></span>
                </div>
                <div class="wd-build__hero">
                  <div class="wd-build__line wd-build__line--xl"></div>
                  <div class="wd-build__line wd-build__line--lg"></div>
                  <div class="wd-build__line wd-build__line--md"></div>
                  <div class="wd-build__cta"></div>
                </div>
                <div class="wd-build__cards">
                  <div class="wd-build__card"></div>
                  <div class="wd-build__card"></div>
                  <div class="wd-build__card"></div>
                </div>
                <div class="wd-build__footer">
                  <div class="wd-build__pill"></div>
                  <div class="wd-build__pill"></div>
                  <div class="wd-build__pill"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wd-section wd-proof">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Довіра</span>
          <h2 class="wd-section__title">Показники, що підтверджують підхід</h2>
          <p class="wd-section__text">
            Ми працюємо в парі з маркетингом, дивимося на дані та будуємо сайти з фокусом на результат.
          </p>
        </div>

        <div class="wd-proof__stats" data-countup-group>
          {trustStats.map((item) => (
            <div class="wd-proof__card">
              <div class="wd-proof__value" data-countup>{item.value}</div>
              <div class="wd-proof__label">{item.label}</div>
            </div>
          ))}
        </div>

        <div class="wd-proof__logos">
          {clientLogos.map((logo) => (
            <span class="wd-proof__logo">{logo}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="wd-section wd-principles">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Підхід</span>
          <h2 class="wd-section__title">Принципи, які приводять до конверсії</h2>
          <p class="wd-section__text">
            Ми не робимо просто красивий сайт. Кожен блок має роль у воронці та відповідає на потреби аудиторії.
          </p>
        </div>

        <div class="wd-grid wd-grid-3">
          {principles.map((item) => (
            <div class="wd-card wd-card--soft">
              <h3>{item.title}</h3>
              <p class="wd-muted">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="wd-section wd-section--dark" id="formats">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Формати</span>
          <h2 class="wd-section__title">Який формат сайту потрібен вашому бізнесу</h2>
          <p class="wd-section__text">
            Підбираємо архітектуру та контент під бізнес-цілі, а не просто під шаблон.
          </p>
        </div>

        <div class="wd-grid wd-grid-4">
          {formats.map((item) => (
            <div class="wd-card">
              <div class="wd-format__meta">
                {item.meta.map((meta) => (
                  <span class="wd-chip wd-chip--outline">{meta}</span>
                ))}
              </div>
              <h3>{item.title}</h3>
              <p class="wd-muted">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="wd-section" id="process">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Процес</span>
          <h2 class="wd-section__title">Як ми будуємо розробку сайту</h2>
          <p class="wd-section__text">Кожен етап прозорий: від брифу до запуску та підтримки.</p>
        </div>

        <div class="wd-process-tree">
          {process.map((item, index) => (
            <div class={`wd-process-branch ${index % 2 === 0 ? 'is-left' : 'is-right'}`}>
              <div class="wd-process-node">{item.step}</div>
              <div class="wd-process-card">
                <div class="wd-process-card__header">
                  <span class="wd-process-icon" aria-hidden="true" set:html={processIcons[item.icon]} />
                  <h3>{item.title}</h3>
                </div>
                <p class="wd-muted">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="wd-section" id="result">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Результат</span>
          <h2 class="wd-section__title">Що ви отримаєте в фіналі</h2>
          <p class="wd-section__text">
            Повний пакет матеріалів і інструментів, щоб сайт працював на маркетинг і продажі.
          </p>
        </div>

        <ul class="wd-list wd-list--cards">
          {deliverables.map((item) => (
            <li class="wd-list__item">{item}</li>
          ))}
        </ul>

        <div class="wd-results__side">
          <div class="wd-card wd-card--soft">
            <h3>Інструменти і стек</h3>
            <p class="wd-muted">Збираємо сайт на технологіях, які легко підтримувати.</p>
            <div class="wd-chip-group">
              {toolbox.map((item) => (
                <span class="wd-chip wd-chip--outline">{item}</span>
              ))}
            </div>
          </div>

          <div class="wd-card wd-card--soft">
            <h3>Ключові сигнали якості</h3>
            <p class="wd-muted">Контролюємо швидкість, події та інтеграції ще до запуску.</p>
            <div class="wd-insights__grid">
              {performanceSignals.map((item) => (
                <div class="wd-signal">
                  <div class="wd-signal__value">{item.value}</div>
                  <div class="wd-signal__label">{item.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wd-section" id="guarantees">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Гарантії</span>
          <h2 class="wd-section__title">Чому процес прогнозований і без стресу</h2>
          <p class="wd-section__text">
            Працюємо як партнер: прозорі кроки, контроль якості та підтримка.
          </p>
        </div>

        <div class="wd-grid wd-grid-4">
          {guarantees.map((item) => (
            <div class="wd-card wd-card--soft wd-guarantee">
              <h3>{item.title}</h3>
              <p class="wd-muted">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="wd-section" id="testimonials">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Відгуки</span>
          <h2 class="wd-section__title">Що кажуть клієнти після запуску</h2>
          <p class="wd-section__text">
            Ми працюємо як партнер і тримаємо фокус на цілях бізнесу.
          </p>
        </div>

        <div class="wd-grid wd-grid-3">
          {testimonials.map((item) => (
            <div class="wd-card wd-card--soft wd-testimonial">
              <p class="wd-testimonial__quote">"{item.quote}"</p>
              <div class="wd-testimonial__meta">
                <div class="wd-testimonial__person">
                  <div class="wd-avatar" style={`--accent: ${item.accent};`}>{item.initials}</div>
                  <div>
                    <div class="wd-testimonial__name">{item.name}</div>
                    <div class="wd-testimonial__role">{item.role}, {item.company}</div>
                  </div>
                </div>
                <span class="wd-testimonial__result">{item.result}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="wd-section" id="packages">
      <div class="max-w-7xl mx-auto">
        <div class="wd-section__header wd-section__header--center">
          <span class="wd-section__eyebrow">Пакети</span>
          <h2 class="wd-section__title">Обирайте формат під ваші задачі</h2>
          <p class="wd-section__text">Пакети можна масштабувати під складність проєкту.</p>
        </div>

        <div class="wd-grid wd-grid-3">
          {packages.map((item) => (
            <div class="wd-package" style={`--accent: ${item.accent};`}>
              {item.badge && <span class="wd-badge">{item.badge}</span>}
              <h3>{item.title}</h3>
              <p class="wd-package__subtitle">{item.subtitle}</p>
              <div class="wd-package__price">{item.price}</div>
              <p class="wd-muted">{item.description}</p>
              <div class="wd-package__meta">
                <span>{item.timeline}</span>
                <span>{item.focus}</span>
              </div>
              <ul class="wd-package__list">
                {item.includes.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div id="contact">
      <ContactCTA />
    </div>
  </div>

  <script nonce={nonce}>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rotatingWords = Array.from(document.querySelectorAll('.wd-rotate'));

    rotatingWords.forEach((node) => {
      const words = (node.dataset.words || '').split('|').map((word) => word.trim()).filter(Boolean);
      if (words.length < 2) return;
      if (prefersReducedMotion) {
        node.textContent = words[0];
        return;
      }

      let index = 0;
      const cycle = () => {
        node.classList.add('is-fading');
        window.setTimeout(() => {
          index = (index + 1) % words.length;
          node.textContent = words[index];
          node.classList.remove('is-fading');
        }, 320);
      };

      window.setInterval(cycle, 2400);
    });
  </script>

  <script nonce={nonce}>
    const counters = Array.from(document.querySelectorAll('[data-countup]'));
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const parseCounter = (rawValue) => {
      const trimmed = rawValue.replace(/\s+/g, ' ').trim();
      const ratioMatch = trimmed.match(/^(\d+)\s*\/\s*(\d+)$/);
      if (ratioMatch) {
        const target = Number.parseInt(ratioMatch[1], 10);
        if (!Number.isFinite(target)) return null;
        return { prefix: '', suffix: `/${ratioMatch[2]}`, target, decimals: 0, raw: rawValue };
      }

      const match = trimmed.match(/^([^0-9]*)(\d+(?:[.,]\d+)?)([^0-9]*)$/);
      if (!match) return null;

      const [, prefix, numberRaw, suffix] = match;
      const normalized = numberRaw.replace(',', '.');
      const target = Number.parseFloat(normalized);

      if (!Number.isFinite(target)) return null;

      const decimals = normalized.includes('.') ? normalized.split('.')[1].length : 0;
      return { prefix, suffix, target, decimals, raw: rawValue };
    };

    const animateCounter = (element) => {
      if (element.dataset.counted === 'true') return;

      const rawValue = element.textContent?.trim() ?? '';
      const data = parseCounter(rawValue);
      if (!data) return;

      element.dataset.counted = 'true';

      if (prefersReduced) {
        element.textContent = `${data.prefix}${data.target.toFixed(data.decimals)}${data.suffix}`;
        return;
      }

      const duration = 1200;
      const start = performance.now();

      const step = (now) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = data.target * eased;
        const value = data.decimals > 0 ? current.toFixed(data.decimals) : Math.round(current).toString();
        element.textContent = `${data.prefix}${value}${data.suffix}`;

        if (progress < 1) {
          requestAnimationFrame(step);
        }
      };

      requestAnimationFrame(step);
    };

    const startAll = () => {
      counters.forEach((counter) => animateCounter(counter));
    };

    if ('IntersectionObserver' in window && !prefersReduced) {
      const group = document.querySelector('[data-countup-group]');
      if (group) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startAll();
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.35 });

        observer.observe(group);
      } else {
        startAll();
      }
    } else {
      startAll();
    }
  </script>

