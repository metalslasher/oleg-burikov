---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const benefits = [
  {
    title: 'Аудит рекламних кампаній',
    description: 'Детальний аналіз поточних кампаній з рекомендаціями по оптимізації',
    icon: '🔍'
  },
  {
    title: 'Маркетингова стратегія',
    description: 'Розробка комплексної стратегії просування під ваші цілі',
    icon: '📋'
  },
  {
    title: 'Оптимізація бюджету',
    description: 'Аналіз та перерозподіл бюджету для максимальної ефективності',
    icon: '💰'
  },
  {
    title: 'Аналіз конкурентів',
    description: 'Дослідження рекламних стратегій конкурентів та їх позиціонування',
    icon: '👀'
  },
  {
    title: 'Навчання команди',
    description: 'Тренінги та воркшопи для вашої маркетингової команди',
    icon: '🎓'
  },
  {
    title: 'Консультації',
    description: 'Регулярні консультації та відповіді на ваші питання',
    icon: '💬'
  }
];

const formats = [
  { 
    title: 'Разовий аудит', 
    description: 'Детальний аналіз поточного стану з рекомендаціями',
    price: 'від $300',
    features: ['Аналіз рекламних кампаній', 'Перевірка аналітики', 'Детальний звіт', 'Рекомендації']
  },
  { 
    title: 'Стратегічна сесія', 
    description: '2-3 години інтенсивної роботи над вашою стратегією',
    price: 'від $200',
    features: ['Аналіз цілей', 'Розробка стратегії', 'План дій', 'Запис сесії']
  },
  { 
    title: 'Менторство', 
    description: 'Регулярні консультації та супровід вашої команди',
    price: 'від $500/міс',
    features: ['4 консультації/міс', 'Ревю кампаній', 'Відповіді на питання', 'Пріоритетна підтримка']
  },
];
---

<PageLayout 
  title="Консалтинг з реклами | Targetsy Agency"
  description="Аудит рекламних кампаній, маркетингова стратегія, оптимізація бюджету, навчання команди. Експертні консультації з digital-маркетингу."
>
  <!-- Hero -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/services" class="inline-flex items-center text-accent-400 hover:text-accent-300 mb-6">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Всі послуги
          </a>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            <span class="text-amber-400">
              Консалтинг
            </span>
            <br />з реклами
          </h1>
          
          <p class="text-xl text-gray-400 mb-8">
            Аналізуємо вашу поточну рекламу та стратегію просування. 
            Надаємо покроковий план покращення та допомагаємо з впровадженням.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="#contact" class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white px-8 py-4 rounded-xl font-semibold hover:shadow-lg hover:shadow-amber-500/30 transition-all">
              Замовити консультацію
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="bg-gradient-to-br from-amber-500/20 to-orange-500/20 backdrop-blur-sm rounded-3xl p-8 border border-amber-500/30">
            <div class="text-center">
              <div class="text-5xl mb-4">💡</div>
              <h3 class="text-2xl font-bold text-white mb-2">4+ років досвіду</h3>
              <p class="text-gray-400">в digital-маркетингу</p>
              <div class="mt-6 pt-6 border-t border-white/10">
                <div class="text-3xl font-bold text-white">100+</div>
                <div class="text-gray-400">проектів реалізовано</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що входить в консалтинг?
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Експертна підтримка на кожному етапі вашого маркетингового шляху
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <div class="text-4xl mb-4">{benefit.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{benefit.title}</h3>
            <p class="text-gray-400">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Formats -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        Формати співпраці
      </h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        {formats.map((format) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:border-amber-500/50 transition-colors">
            <h3 class="text-xl font-bold text-white mb-2">{format.title}</h3>
            <p class="text-gray-400 mb-4">{format.description}</p>
            <div class="text-2xl font-bold text-amber-400 mb-6">{format.price}</div>
            <ul class="space-y-2">
              {format.features.map((feature) => (
                <li class="flex items-center text-gray-300">
                  <svg class="w-5 h-5 mr-2 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
