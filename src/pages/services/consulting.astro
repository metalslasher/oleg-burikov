---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import content from '../../content/home-uk.json';

const nonce = Astro.locals.cspNonce;

const benefits = [
  {
    title: 'Аудит рекламних кампаній',
    description: 'Детальний аналіз поточних кампаній з рекомендаціями по оптимізації',
    icon: '🔍'
  },
  {
    title: 'Маркетингова стратегія',
    description: 'Розробка комплексної стратегії просування під ваші цілі',
    icon: '📋'
  },
  {
    title: 'Оптимізація бюджету',
    description: 'Аналіз та перерозподіл бюджету для максимальної ефективності',
    icon: '💰'
  },
  {
    title: 'Аналіз конкурентів',
    description: 'Дослідження рекламних стратегій конкурентів та їх позиціонування',
    icon: '👀'
  },
  {
    title: 'Навчання команди',
    description: 'Тренінги та воркшопи для вашої маркетингової команди',
    icon: '🎓'
  },
  {
    title: 'Консультації',
    description: 'Регулярні консультації та відповіді на ваші питання',
    icon: '💬'
  }
];

const caseSlides = content.cases.items.map((caseItem, index) => ({
  ...caseItem,
  slug: `case-${index + 1}`,
}));

const formats = [
  { 
    title: 'Разовий аудит', 
    description: 'Детальний аналіз поточного стану з рекомендаціями',
    price: 'від $100',
    features: ['Аналіз рекламних кампаній', 'Перевірка аналітики', 'Детальний звіт', 'Рекомендації']
  },
  { 
    title: 'Стратегічна сесія', 
    description: '2-3 години інтенсивної роботи над вашою стратегією',
    price: 'від $50',
    features: ['Аналіз цілей', 'Розробка стратегії', 'План дій', 'Запис сесії']
  },
  { 
    title: 'Менторство', 
    description: 'Регулярні консультації та супровід вашої команди',
    price: 'від $200/міс',
    features: ['8 консультації/міс', 'Аналіз кампаній', 'Відповіді на питання', 'Пріоритетна підтримка']
  },
];

const deliverables = [
  {
    title: 'Аудит реклами й воронки',
    description: 'Розбираємо кампанії, креативи та етапи конверсії.',
  },
  {
    title: 'Стратегія росту',
    description: 'Формуємо позиціонування, оффери та пріоритети каналів.',
  },
  {
    title: 'План оптимізації',
    description: 'Детальний roadmap із кроками, дедлайнами та метриками.',
  },
  {
    title: 'Розбір креативів',
    description: 'Пояснюємо, що не працює, і даємо ідеї для тестів.',
  },
  {
    title: 'Підтримка команди',
    description: 'Відповідаємо на питання, допомагаємо з рішеннями та фокусом.',
  },
  {
    title: 'Контроль KPI',
    description: 'Визначаємо ключові метрики та регулярно відстежуємо прогрес.',
  },
];

const faq = [
  {
    question: 'Які формати консалтингу доступні?',
    answer: 'Разова консультація, стратегічна сесія або регулярний супровід.',
  },
  {
    question: 'Чи працюєте з інхаус‑командою?',
    answer: 'Так, можемо підсилити вашу команду або допомогти її навчити.',
  },
  {
    question: 'Чи можна тільки аудит без супроводу?',
    answer: 'Так, робимо аудит і передаємо чіткий план подальших дій.',
  },
  {
    question: 'Які дані потрібні на старті?',
    answer: 'Доступи до рекламних акаунтів, аналітики та короткий опис цілей.',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<PageLayout 
  title="Маркетинговий консалтинг і аудит реклами | Targetsy Agency"
  description="Консалтинг для бізнесу та інхаус‑команд: аудит кампаній, стратегія, оптимізація воронки, підтримка та навчання."
>
  <script type="application/ld+json" nonce={nonce} set:html={JSON.stringify(faqStructuredData)} />
  <!-- Hero -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            <span class="text-amber-400">
              Консалтинг
            </span>
            <br />з реклами
          </h1>
          
          <p class="text-xl text-gray-400 mb-8">
            Проводимо аудит, формуємо стратегію й даємо чіткий план дій, щоб реклама працювала стабільно і прогнозовано.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="#contact" class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white px-8 py-4 rounded-xl font-semibold hover:shadow-lg hover:shadow-amber-500/30 transition-all">
              Замовити консультацію
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="w-full lg:justify-self-end">
          <div class="case-slider w-full">
            {caseSlides.map((caseItem, index) => (
              <article class={`case-slide ${index === 0 ? 'is-active' : ''}`} data-case-slide aria-hidden={index === 0 ? 'false' : 'true'}>
                <div class="bg-gradient-to-br from-amber-500/15 to-orange-500/15 border border-amber-500/30 rounded-3xl p-8">
                  <div class="text-xs uppercase tracking-wide text-amber-200/80">{caseItem.industry}</div>
                  <h2 class="text-2xl font-bold text-white mt-2 mb-3">{caseItem.client}</h2>
                  <p class="text-gray-400 text-sm leading-relaxed line-clamp-3">{caseItem.challenge}</p>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
                    {caseItem.results.slice(0, 3).map((result) => (
                      <div class="bg-white/5 border border-white/10 rounded-xl p-3">
                        <div class="text-lg font-semibold text-white">{result.value}</div>
                        <div class="text-xs text-gray-400">{result.metric}</div>
                      </div>
                    ))}
                  </div>
                  <a href={`/cases/${caseItem.slug}`} class="inline-flex items-center gap-2 text-amber-300 hover:text-amber-200 font-semibold mt-6">
                    Дивитись кейс
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що входить в консалтинг?
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Експертна підтримка на кожному етапі вашого маркетингового шляху
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <div class="text-4xl mb-4">{benefit.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{benefit.title}</h3>
            <p class="text-gray-400">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що ви отримуєте від консалтингу
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Конкретні кроки й рекомендації, які можна впровадити одразу.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {deliverables.map((item) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Formats -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        Формати співпраці
      </h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        {formats.map((format) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:border-amber-500/50 transition-colors">
            <h3 class="text-xl font-bold text-white mb-2">{format.title}</h3>
            <p class="text-gray-400 mb-4">{format.description}</p>
            <div class="text-2xl font-bold text-amber-400 mb-6">{format.price}</div>
            <ul class="space-y-2">
              {format.features.map((feature) => (
                <li class="flex items-center text-gray-300">
                  <svg class="w-5 h-5 mr-2 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        Часті питання про консалтинг
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        {faq.map((item) => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">{item.question}</h3>
            <p class="text-gray-400">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>

<script nonce={nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = Array.from(document.querySelectorAll('[data-case-slide]'));
    if (slides.length <= 1) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let current = 0;
    const show = (index) => {
      slides.forEach((slide, i) => {
        const isActive = i === index;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });
    };

    const advance = () => {
      current = (current + 1) % slides.length;
      show(current);
    };

    let timer = setInterval(advance, 6000);
    const slider = document.querySelector('.case-slider');
    if (slider) {
      slider.addEventListener('mouseenter', () => clearInterval(timer));
      slider.addEventListener('mouseleave', () => {
        timer = setInterval(advance, 6000);
      });
    }
  });
</script>

<style>
  .case-slider {
    display: grid;
  }

  .case-slide {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .case-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-slide {
      transition: none;
    }
  }
</style>
