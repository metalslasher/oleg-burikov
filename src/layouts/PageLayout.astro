---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogType,
  publishedTime,
  modifiedTime,
  noindex,
} = Astro.props;
---

<BaseLayout 
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogType={ogType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  noindex={noindex}
>
  <Header />
  
  <main id="main" class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950" style="padding-top: 120px;">
    <slot />
    <Footer />
  </main>
</BaseLayout>
