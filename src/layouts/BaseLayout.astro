---
import { siteConfig, sameAsLinks, withBrandTitle } from '../config/site';
import ContactModal from '../components/ContactModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogType,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;
const siteUrl = siteConfig.siteUrl;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const canonicalUrlString = canonicalURL.toString();
const pageTitle = withBrandTitle(title);
const resolvedOgTitle = ogTitle ? withBrandTitle(ogTitle) : pageTitle;
const resolvedOgImage = new URL(ogImage || siteConfig.seo.defaultOgImage, siteUrl).toString();
const resolvedOgType =
  ogType || (Astro.url.pathname.startsWith('/blog/') ? 'article' : 'website');
const nonce = Astro.locals.cspNonce;
const shouldLoadVercelInsights = import.meta.env.PROD;
const faviconHref = `${siteConfig.logo.src}?v=20260612-3`;

const defaultSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.brandName,
    url: siteUrl,
    inLanguage: siteConfig.locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: siteConfig.personName,
    alternateName: siteConfig.brandName,
    url: siteUrl,
    email: siteConfig.contact.email,
    telephone: siteConfig.contact.phone,
    sameAs: sameAsLinks,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: siteConfig.legalName,
    alternateName: siteConfig.brandName,
    url: siteUrl,
    logo: new URL(siteConfig.logo.src, siteUrl).toString(),
    founder: {
      '@type': 'Person',
      name: siteConfig.personName,
    },
    email: siteConfig.contact.email,
    telephone: siteConfig.contact.phone,
    sameAs: sameAsLinks,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description,
    url: canonicalUrlString,
    inLanguage: siteConfig.locale,
    isPartOf: {
      '@type': 'WebSite',
      name: siteConfig.brandName,
      url: siteUrl,
    },
  },
];
---

<!doctype html>
<html lang="uk">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline nonce={nonce} define:vars={{ gtmId: siteConfig.tracking.gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',gtmId);</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={siteConfig.locale} href={canonicalUrlString} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrlString} />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={resolvedOgImage} />
    {resolvedOgType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {resolvedOgType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={resolvedOgTitle} />
    <meta property="twitter:description" content={ogDescription || description} />
    <meta property="twitter:image" content={resolvedOgImage} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="512x512" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" nonce={nonce} set:html={JSON.stringify(defaultSchemas)} />
  </head>
  <body class="custom-scrollbar">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${siteConfig.tracking.gtmId}`}
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent-600 focus:text-white focus:px-4 focus:py-2 focus:rounded">
      Перейти до основного контенту
    </a>
    
    <slot />
    <ContactModal />
    
    <!-- Load scripts after content -->
    <script>
      import '../scripts/smoothScroll.ts';
      import '../scripts/formValidation.ts';
      import '../scripts/gtmEvents.ts';
      import '../scripts/contactModal.ts';
      import '../scripts/nichesSlider.ts';
    </script>
    
    {shouldLoadVercelInsights && (
      <script
        is:inline
        defer
        src="/_vercel/speed-insights/script.js"
        data-sdkn="@vercel/speed-insights/astro"
        data-sdkv="2.0.0"
        data-route={Astro.url.pathname}
      ></script>
    )}
  </body>
</html>
