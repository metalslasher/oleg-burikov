---
import { siteConfig, sameAsLinks, withBrandTitle, absoluteUrl } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';
import { servicePages } from '../data/services';
import displayFont from '@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (Article, FAQPage, BreadcrumbList...). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = siteConfig.seo.defaultOgImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const pageTitle = withBrandTitle(title);
const resolvedOgImage = absoluteUrl(ogImage);
const nonce = Astro.locals.cspNonce;
const loadSpeedInsights = import.meta.env.PROD;

const person = {
  '@type': 'Person',
  '@id': `${siteConfig.siteUrl}/#person`,
  name: siteConfig.personName,
  alternateName: siteConfig.personNameEn,
  jobTitle: siteConfig.jobTitle,
  url: siteConfig.siteUrl,
  image: absoluteUrl('/images/oleg-burikov-hero-cutout.webp'),
  email: siteConfig.contact.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Kyiv', addressCountry: 'UA' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Taras Shevchenko National University of Kyiv' },
  knowsAbout: ['Performance marketing', 'Google Ads', 'Meta Ads', 'TikTok Ads', 'Amazon Ads', 'Google Analytics 4', 'Google Tag Manager', 'Landing page development', 'Conversion rate optimization'],
  worksFor: { '@type': 'Organization', name: 'SvitSoft' },
  knowsLanguage: ['uk', 'en'],
  sameAs: sameAsLinks,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.siteUrl}/#website`,
      name: siteConfig.personName,
      url: siteConfig.siteUrl,
      inLanguage: siteConfig.locale,
      publisher: { '@id': `${siteConfig.siteUrl}/#person` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteConfig.siteUrl}/#service`,
      name: `${siteConfig.personName} — performance-маркетинг`,
      url: siteConfig.siteUrl,
      image: absoluteUrl(siteConfig.seo.defaultOgImage),
      founder: { '@id': `${siteConfig.siteUrl}/#person` },
      email: siteConfig.contact.email,
      telephone: siteConfig.contact.phone,
      address: { '@type': 'PostalAddress', addressLocality: 'Kyiv', addressCountry: 'UA' },
      areaServed: ['UA', 'Europe', 'US', 'CA'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Послуги',
        itemListElement: servicePages.map((page) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: page.seo.title, url: absoluteUrl(`/services/${page.slug}`) },
        })),
      },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline nonce={nonce}>document.documentElement.classList.add('js');</script>
    <script is:inline nonce={nonce} define:vars={{ gtmId: siteConfig.tracking.gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',gtmId);</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="author" content={siteConfig.personName} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta property="og:site_name" content={siteConfig.personName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Блог — ${siteConfig.personName}`} href="/rss.xml" />
    <script is:inline type="application/ld+json" nonce={nonce} set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${siteConfig.tracking.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>
    <a href="#main" class="skip-link">Перейти до основного контенту</a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ContactModal />
    <Lightbox />

    <script>
      import '../scripts/site.ts';
      import '../scripts/gtmEvents.ts';
    </script>

    {loadSpeedInsights && (
      <script
        is:inline
        defer
        src="/_vercel/speed-insights/script.js"
        data-sdkn="@vercel/speed-insights/astro"
        data-sdkv="2.0.0"
        data-route={Astro.url.pathname}
      ></script>
    )}
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--color-signal);
    color: var(--color-ink);
    font-weight: 700;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main {
    display: block;
  }
</style>
