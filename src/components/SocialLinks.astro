---
import { messengerLinks, socialLinks } from '../config/site';

interface Props {
  location: string;
}

const { location } = Astro.props;
const messengerIcons = {
  Telegram: 'telegram',
  Viber: 'viber',
  WhatsApp: 'whatsapp',
} as const;

const links = [
  ...socialLinks.map((link) => ({
    label: link.platform,
    url: link.url,
    icon: link.icon,
    event: 'social_click',
  })),
  ...messengerLinks.map((link) => ({
    label: link.label,
    url: link.url,
    icon: messengerIcons[link.label as keyof typeof messengerIcons],
    event: 'messenger_click',
  })),
];
---

<div class="social-links" aria-label="Соціальні мережі та месенджери">
  {links.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="social-link"
      aria-label={link.label}
      title={link.label}
      data-gtm-event={link.event}
      data-gtm-label={link.label.toLowerCase()}
      data-gtm-location={location}
    >
      {link.icon === 'facebook' && (
        <svg class="social-link__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 8H6v4h3v12h5V12h3.64L18 8h-4V6.33C14 5.38 14.19 5 15.12 5H18V0h-3.81C10.6 0 9 1.58 9 4.62V8Z" />
        </svg>
      )}
      {link.icon === 'instagram' && (
        <svg class="social-link__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
