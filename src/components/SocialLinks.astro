        </svg>
      )}
      {link.icon === 'linkedin' && (
        <svg class="social-link__icon social-link__icon--linkedin" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.34 7.43a2.06 2.06 0 1 0 0-4.12 2.06 2.06 0 0 0 0 4.12ZM3.56 9h3.55v11.45H3.56V9Zm5.79 0h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9Z" />
        </svg>
      )}
