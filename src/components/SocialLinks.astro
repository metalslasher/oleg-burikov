        <svg class="social-link__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M11.94 0A12 12 0 1 0 12 0h-.06Zm4.97 7.22c.1 0 .32.02.46.14.12.1.16.23.17.33.02.09.04.3.02.47-.18 1.9-.96 6.5-1.36 8.63-.17.9-.5 1.2-.82 1.23-.7.06-1.23-.46-1.9-.9-1.06-.7-1.65-1.13-2.68-1.8-1.18-.78-.42-1.21.26-1.91.18-.18 3.25-2.98 3.31-3.23.01-.03.01-.15-.06-.21-.07-.06-.17-.04-.25-.03-.1.03-1.79 1.14-5.06 3.35-.48.33-.91.49-1.3.48-.43-.01-1.25-.24-1.87-.44-.75-.24-1.35-.37-1.3-.79.03-.21.33-.43.9-.66 3.49-1.52 5.83-2.53 7-3.01 3.33-1.39 4.02-1.63 4.48-1.64Z" />
        </svg>
      )}
      {link.icon === 'viber' && (
        <svg class="social-link__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M11.4 0C9.47.03 5.33.34 3.02 2.47 1.3 4.19.7 6.7.63 9.82.57 12.93.49 18.78 6.12 20.36v2.42s-.04.97.61 1.17c.78.24 1.23-.5 1.98-1.3.41-.44.97-1.08 1.4-1.58 3.85.33 6.81-.41 7.15-.52.77-.25 5.17-.82 5.89-6.66.74-6.02-.36-9.83-2.34-11.55C20.21 1.8 17.8.04 12.43.02c0 0-.4-.03-1.04-.02Zm.06 1.69c.54 0 .88.02.88.02 4.54.02 6.72 1.39 7.22 1.85 1.68 1.43 2.53 4.87 1.91 9.9-.61 4.87-4.18 5.18-4.84 5.39-.28.09-2.88.74-6.15.52 0 0-2.44 2.94-3.2 3.71-.12.12-.26.16-.35.14-.13-.03-.17-.19-.16-.41l.02-4.02c-4.76-1.32-4.49-6.29-4.43-8.9.05-2.6.54-4.73 2-6.17 1.96-1.77 5.47-2.02 7.1-2.03Zm.38 2.61a.3.3 0 0 0 0 .6c1.62.02 2.94.54 4.02 1.6 1.08 1.04 1.62 2.47 1.64 4.33a.3.3 0 0 0 .6 0c-.01-1.98-.62-3.6-1.81-4.77-1.2-1.16-2.7-1.75-4.45-1.76ZM7.88 4.99c-.19-.03-.4 0-.62.12-.43.25-.82.56-1.15.93-.27.33-.42.64-.46.95-.01.05-.01.1-.01.14 0 .14.02.27.07.4.14.48.47 1.28 1.2 2.61.42.77.91 1.5 1.45 2.19.27.34.56.67.87.98l.13.13c.31.31.64.6.98.87.69.54 1.42 1.03 2.19 1.45 1.33.73 2.13 1.07 2.6 1.2.13.05.27.07.41.07h.14c.31-.04.63-.19.95-.46.37-.33.68-.72.93-1.15.23-.43.15-.84-.18-1.12 0 0-.7-.58-1.04-.83-.36-.25-.73-.49-1.11-.71-.51-.28-1.03-.1-1.25.18l-.45.56c-.23.28-.65.25-.65.25-3.12-.8-3.96-3.96-3.96-3.96s-.03-.42.25-.65l.56-.45c.28-.22.46-.74.17-1.25-.22-.38-.45-.75-.71-1.11-.25-.34-.83-1.03-.83-1.04-.14-.16-.31-.26-.5-.3Zm4.49.88a.3.3 0 0 0-.02.61c1.16.08 2.02.46 2.65 1.15.63.68.93 1.52.9 2.57a.3.3 0 0 0 .61.01c.03-1.18-.33-2.2-1.07-3-.74-.81-1.78-1.25-3.05-1.34h-.02Zm.46 1.63a.3.3 0 0 0-.01.61c.52.03.87.17 1.11.42.24.24.39.62.42 1.16a.3.3 0 0 0 .6-.03c-.03-.64-.21-1.17-.58-1.55-.36-.38-.89-.58-1.52-.61h-.02Z" />
        </svg>
      )}
      {link.icon === 'whatsapp' && (
        <svg class="social-link__icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.23-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.34.44-.52.15-.17.2-.3.3-.5.1-.19.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.37l-.36-.22-3.74.99 1-3.65-.24-.38a9.86 9.86 0 0 1-1.5-5.26C2.17 6.44 6.6 2 12.05 2c2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.43 9.88-9.88 9.88ZM20.46 3.5A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.15 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9 0-3.17-1.23-6.15-3.48-8.4Z" />
        </svg>
      )}
    </a>
  ))}
</div>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .social-link {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(249 115 22 / 0.22);
    border-radius: 0.7rem;
    background: rgb(249 115 22 / 0.14);
    color: rgb(251 146 60);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .social-link:hover {
    transform: translateY(-2px);
    border-color: rgb(249 115 22 / 0.7);
    background: rgb(249 115 22);
    color: white;
  }

  .social-link:focus-visible {
    outline: 2px solid rgb(251 146 60);
    outline-offset: 3px;
  }

  .social-link__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  .social-link__icon--linkedin {
    width: 1.3rem;
    height: 1.3rem;
  }

  @media (min-width: 768px) {
    .social-links {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
  }
</style>
