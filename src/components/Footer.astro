---
import { navigation, siteConfig, contactLinks } from '../config/site';
import Icon from './Icon.astro';

const isHome = Astro.url.pathname === '/';
const resolveHref = (href: string) => (isHome && href.startsWith('/#') ? href.slice(1) : href);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__name">{siteConfig.personName}</a>
        <p>Маркетинг під ключ: стратегія, сайти, креативи, реклама в Google, Meta і TikTok та аналітика.</p>
      </div>

      <div>
        <p class="footer__title">Навігація</p>
        <ul>
          <li><a href="/">Головна</a></li>
          {navigation.map((item) => <li><a href={resolveHref(item.href)}>{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <p class="footer__title">Контакти</p>
        <ul>
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                data-gtm-event={link.event}
                data-gtm-label={link.label.toLowerCase()}
                data-gtm-location="footer"
              >
                <Icon name={link.icon} size={16} />
                {link.icon === 'email' ? siteConfig.contact.email : link.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`tel:${siteConfig.contact.phone}`} data-gtm-event="contact_click" data-gtm-label="phone" data-gtm-location="footer">
              <Icon name="phone" size={16} />
              {siteConfig.contact.phoneDisplay}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {siteConfig.legalName}</p>
      <a href="/privacy">Політика конфіденційності</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--color-muted);
    font-size: 0.93rem;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 760px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }

  .footer__name {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__brand p {
    max-width: 24rem;
    margin-top: 0.9rem;
  }

  .footer__title {
    margin-bottom: 0.9rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 0.55rem;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 200ms ease;
    overflow-wrap: anywhere;
  }

  ul a:hover,
  .footer__bottom a:hover {
    color: var(--color-paper);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--color-faint);
    font-size: 0.84rem;
  }
</style>
