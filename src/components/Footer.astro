---
import content from '../content/home-uk.json';
import { siteConfig } from '../config/site';
import SocialLinks from './SocialLinks.astro';

const { footer } = content;
const currentYear = new Date().getFullYear();
---

<footer class="py-16 md:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12 text-center md:text-left">
        <div class="flex flex-col items-center md:items-start space-y-6">
          <div>
            <h3 class="text-xl md:text-2xl font-bold text-white mb-2">{siteConfig.brandName}</h3>
            <p class="text-sm font-medium text-accent-400 uppercase tracking-wider">{siteConfig.positioning.shortLabel}</p>
          </div>
          <SocialLinks location="footer" />
        </div>

        <div class="flex flex-col items-center md:items-start space-y-4">
          <h4 class="text-xl md:text-2xl font-bold text-white">{footer.menu.title}</h4>
          <ul class="space-y-3">
            {footer.menu.links.map((link) => (
              <li>
                <a href={link.href} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col items-center md:items-start space-y-4">
          <h4 class="text-xl md:text-2xl font-bold text-white">{footer.contact.title}</h4>
          <ul class="space-y-3">
            <li>
              <a href={`mailto:${siteConfig.contact.email}`} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
                {siteConfig.contact.email}
              </a>
            </li>
            <li>
              <a href={`tel:${siteConfig.contact.phone}`} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
                {siteConfig.contact.phoneDisplay}
              </a>
            </li>
          </ul>
        </div>

        <div class="flex flex-col items-center md:items-start space-y-4">
          <h4 class="text-xl md:text-2xl font-bold text-white">{footer.legal.title}</h4>
          <ul class="space-y-2">
            {footer.legal.links.map((link) => (
              <li>
                <a href={link.href} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="text-center pt-8 border-t border-white/10">
        <p class="text-gray-400 text-sm">
          © {currentYear} {siteConfig.brandName}. Всі права захищені.
        </p>
      </div>
    </div>
  </div>
</footer>
