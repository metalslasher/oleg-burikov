---
import content from '../content/home-uk.json';

const { footer } = content;
const currentYear = new Date().getFullYear();
---

<footer class="py-16 md:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Footer Cards Grid - matching WorkProcess style -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 mb-12">
      
      <!-- Brand Column Card -->
      <div class="relative h-full rounded-3xl bg-white/5 border border-white/10 p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300 group">
        <!-- Icon Badge -->
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent-500/20 group-hover:bg-accent-500/30 transition-colors">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
        </div>
        
        <h3 class="text-xl md:text-2xl font-bold text-white mb-2">{content.header.logo}</h3>
        <p class="text-sm font-medium text-accent-400 mb-4 uppercase tracking-wider">Digital Agency</p>
        <p class="text-gray-300 leading-relaxed mb-6">{footer.tagline}</p>
        
        <!-- Social Icons -->
        <div class="flex gap-3">
          {footer.social.links.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group/social w-10 h-10 bg-accent-500/20 rounded-xl flex items-center justify-center hover:bg-gradient-to-br hover:from-accent-500 hover:to-primary-500 transition-all duration-300 hover:scale-110"
              aria-label={social.platform}
            >
              {social.icon === 'facebook' && (
                <svg class="w-5 h-5 text-accent-400 group-hover/social:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg class="w-5 h-5 text-accent-400 group-hover/social:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              )}
              {social.icon === 'linkedin' && (
                <svg class="w-5 h-5 text-accent-400 group-hover/social:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation Column Card -->
      <div class="relative h-full rounded-3xl bg-white/5 border border-white/10 p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300 group">
        <!-- Icon Badge -->
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent-500/20 group-hover:bg-accent-500/30 transition-colors">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </div>
        </div>
        <h4 class="text-xl md:text-2xl font-bold text-white mb-2">{footer.menu.title}</h4>
        <p class="text-sm font-medium text-accent-400 mb-6 uppercase tracking-wider">Навігація</p>
        
        <ul class="space-y-3">
          {footer.menu.links.map((link) => (
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 mt-1">
                <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <a href={link.href} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Column Card -->
      <div class="relative h-full rounded-3xl bg-white/5 border border-white/10 p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300 group">
        <!-- Icon Badge -->
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent-500/20 group-hover:bg-accent-500/30 transition-colors">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
        
        <h4 class="text-xl md:text-2xl font-bold text-white mb-2">{footer.contact.title}</h4>
        <p class="text-sm font-medium text-accent-400 mb-6 uppercase tracking-wider">Зв'яжіться з нами</p>
        
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <a href={`mailto:${footer.contact.email}`} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
              {footer.contact.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <a href={`tel:${footer.contact.phone}`} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
              {footer.contact.phone}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-gray-300 leading-relaxed">{footer.contact.address}</span>
          </li>
        </ul>
      </div>

      <!-- Legal Column Card -->
      <div class="relative h-full rounded-3xl bg-white/5 border border-white/10 p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300 group">
        <!-- Icon Badge -->
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent-500/20 group-hover:bg-accent-500/30 transition-colors">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
        
        <h4 class="text-xl md:text-2xl font-bold text-white mb-2">{footer.legal.title}</h4>
        <p class="text-sm font-medium text-accent-400 mb-6 uppercase tracking-wider">Документи</p>
        
        <ul class="space-y-3">
          {footer.legal.links.map((link) => (
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 mt-1">
                <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <a href={link.href} class="text-gray-300 hover:text-white transition-colors leading-relaxed">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

      <!-- Copyright -->
      <div class="text-center pt-8 border-t border-white/10">
        <p class="text-gray-400 text-sm">
          © {currentYear} {content.header.logo}. Всі права захищені.
        </p>
      </div>
    </div>
  </div>
</footer>
