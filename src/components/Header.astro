---
import content from '../content/home-uk.json';
import { siteConfig } from '../config/site';

const { header } = content;
const nonce = Astro.locals.cspNonce;
const languages = [
  { code: 'uk', label: 'UA', name: 'Українська', active: true },
  { code: 'en', label: 'EN', name: 'English', active: false },
];
---

<header id="header" class="site-header fixed top-0 left-0 right-0 z-50">
  <nav
    class="header-shell px-4 sm:px-6 lg:px-8"
    aria-label="Основна навігація"
  >
    <div class="flex items-center justify-between h-16 sm:h-18">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <a href="/" class="brand-logo" aria-label={siteConfig.personName}>
            <span class="brand-logo__name">{header.logo}</span>
          </a>
        </div>

        <!-- Desktop Navigation (Center) -->
        <div class="hidden lg:flex items-center space-x-8">
          {header.nav.map((item) => (
            <a
              href={item.href}
              class="text-[15px] text-gray-300 hover:text-white font-medium transition-colors"
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="header-right">
          <!-- Right Side Buttons (Desktop / Tablet) -->
          <div class="hidden md:flex items-center gap-3">
            <a
              href="#contact"
              data-gtm-event="cta_click"
              data-gtm-label="header_consultation"
              data-gtm-location="header_desktop"
              class="header-cta"
            >
              <span>{header.cta}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H9m8 0v8" />
              </svg>
            </a>

            <div class="language-switch" aria-label="Зміна мови сайту">
              {languages.map((language) => (
                <button
                  type="button"
                  class:list={['language-switch__item', language.active && 'is-active']}
                  aria-pressed={language.active ? 'true' : 'false'}
                  aria-label={language.name}
                >
                  {language.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-button"
            class="mobile-menu-toggle lg:hidden inline-flex items-center justify-center p-2 text-gray-300 hover:text-white focus:outline-none"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Відкрити меню"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden lg:hidden pb-4 mt-2">
        <div class="flex flex-col space-y-2 pt-4">
          {header.nav.map((item) => (
            <a
              href={item.href}
              class="block text-gray-300 hover:text-white hover:bg-white/10 font-medium py-3 px-4 rounded-xl transition-all mobile-nav-link"
            >
              {item.label}
            </a>
          ))}
          <div class="mobile-menu-actions">
            <a
              href="#contact"
              data-gtm-event="cta_click"
              data-gtm-label="header_consultation"
              data-gtm-location="header_mobile"
              class="header-mobile-cta mobile-nav-link"
            >
              <span>{header.cta}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H9m8 0v8" />
              </svg>
            </a>

            <div class="language-switch language-switch--mobile" aria-label="Зміна мови сайту">
              {languages.map((language) => (
                <button
                  type="button"
                  class:list={['language-switch__item', language.active && 'is-active']}
                  aria-pressed={language.active ? 'true' : 'false'}
                  aria-label={language.name}
                >
                  {language.label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>
</header>

<style>
  .site-header {
    transition: transform 220ms ease;
  }

  .header-shell {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: none;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-header.is-scrolled .header-shell,
  .site-header.is-menu-open .header-shell {
    border-bottom-color: rgba(255, 255, 255, 0.16);
    background: rgba(15, 20, 25, 0.65);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(32px);
  }

  .brand-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: white;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .brand-logo:hover {
    opacity: 0.92;
  }

  .header-right {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .brand-logo__name {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: currentColor;
    font-size: clamp(1.18rem, 1.05rem + 0.45vw, 1.45rem);
    font-weight: 950;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .brand-logo__name::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(249 115 22), transparent 86%);
    transform: scaleX(0.36);
    transform-origin: left;
    opacity: 0.9;
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }

  .brand-logo:hover .brand-logo__name::after,
  .site-header.is-scrolled .brand-logo__name::after,
  .site-header.is-menu-open .brand-logo__name::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    height: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid rgba(249, 115, 22, 0.34);
    border-radius: 0.55rem;
    background: rgba(249, 115, 22, 0.08);
    padding: 0.24rem;
  }

  .language-switch__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    min-height: calc(2.75rem - 0.48rem - 2px);
    border-radius: 0.38rem;
    color: rgb(254 215 170);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .language-switch__item:hover {
    background: rgba(249, 115, 22, 0.16);
    color: white;
  }

  .language-switch__item.is-active {
    background: rgb(249 115 22);
    color: white;
  }

  .header-cta,
  .header-mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid rgb(249 115 22);
    border-radius: 0.55rem;
    background: rgb(249 115 22);
    padding: 0 1rem;
    color: white;
    font-size: 0.9rem;
    font-weight: 820;
    white-space: nowrap;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .header-cta:hover,
  .header-mobile-cta:hover {
    border-color: rgb(251 146 60);
    background: rgb(251 146 60);
    box-shadow: 0 18px 36px -28px rgba(249, 115, 22, 0.9);
    color: white;
    transform: translateY(-1px);
  }

  .mobile-menu-toggle {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .mobile-menu-toggle:hover {
    border-color: rgba(249, 115, 22, 0.42);
    background: rgba(249, 115, 22, 0.12);
  }

  .header-mobile-cta {
    min-width: 0;
    padding: 0 0.85rem;
    font-size: clamp(0.78rem, 2.45vw, 0.9rem);
    text-align: center;
  }

  .header-mobile-cta span {
    min-width: 0;
  }

  .mobile-menu-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem 0 0;
  }

  .language-switch--mobile {
    width: fit-content;
    margin: 0;
    justify-self: end;
  }

  @supports not ((backdrop-filter: blur(1px))) {
    .site-header.is-scrolled .header-shell,
    .site-header.is-menu-open .header-shell {
      background: rgba(15, 20, 25, 0.92);
    }
  }
</style>

<script is:inline nonce={nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('header');
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    const updateHeaderState = () => {
      header?.classList.toggle('is-scrolled', window.scrollY > 8);
    };

    updateHeaderState();
    window.addEventListener('scroll', updateHeaderState, { passive: true });

    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', () => {
        const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileMenu.classList.toggle('hidden');
        header?.classList.toggle('is-menu-open', !isExpanded);
      });

      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
      mobileNavLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          menuButton?.setAttribute('aria-expanded', 'false');
          header?.classList.remove('is-menu-open');
        });
      });
    }
  });
</script>


