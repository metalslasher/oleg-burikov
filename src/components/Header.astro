---
import content from '../content/home-uk.json';
import { siteConfig } from '../config/site';

const { header } = content;
const isHomePage = Astro.url.pathname === '/';
const resolveNavHref = (href: string) => isHomePage && href.startsWith('/#') ? href.slice(1) : href;
const languages = [
  { code: 'uk', label: 'UA', name: 'Українська', active: true },
  { code: 'en', label: 'EN', name: 'English', active: false },
];
---

<header id="header" class="site-header fixed top-0 left-0 right-0 z-50">
  <nav
    class="header-shell px-4 sm:px-6 lg:px-8"
    aria-label="Основна навігація"
  >
    <div class="flex items-center justify-between h-16 sm:h-18">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <a href="/" class="brand-logo" aria-label={siteConfig.personName}>
            <span class="brand-logo__name">{header.logo}</span>
          </a>
        </div>

        <!-- Desktop Navigation (Center) -->
        <div class="hidden lg:flex items-center space-x-8">
          {header.nav.map((item) => (
            <a
              href={resolveNavHref(item.href)}
              class="text-[15px] text-gray-300 hover:text-white font-medium transition-colors"
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="header-right">
          <!-- Right Side Buttons (Desktop / Tablet) -->
          <div class="hidden md:flex items-center gap-3">
            <a
              href="#contact"
              data-gtm-event="cta_click"
              data-gtm-label="header_consultation"
              data-gtm-location="header_desktop"
              class="header-cta"
            >
              <span>{header.cta}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H9m8 0v8" />
              </svg>
            </a>

            <div class="language-switch" aria-label="Зміна мови сайту">
              {languages.map((language) => (
                <button
                  type="button"
                  class:list={['language-switch__item', language.active && 'is-active']}
                  aria-pressed={language.active ? 'true' : 'false'}
                  aria-label={language.name}
                >
                  {language.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-button"
            class="mobile-menu-toggle lg:hidden inline-flex items-center justify-center p-2 text-gray-300 hover:text-white focus:outline-none"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Відкрити меню"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden lg:hidden pb-4 mt-2">
        <div class="flex flex-col space-y-2 pt-4">
          {header.nav.map((item) => (
            <a
              href={resolveNavHref(item.href)}
              class="block text-gray-300 hover:text-white hover:bg-white/10 font-medium py-3 px-4 rounded-xl transition-all mobile-nav-link"
            >
              {item.label}
            </a>
          ))}
          <div class="mobile-menu-actions">
            <a
              href="#contact"
              data-gtm-event="cta_click"
              data-gtm-label="header_consultation"
              data-gtm-location="header_mobile"
              class="header-mobile-cta mobile-nav-link"
            >
              <span>{header.cta}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H9m8 0v8" />
              </svg>
            </a>

            <div class="language-switch language-switch--mobile" aria-label="Зміна мови сайту">
              {languages.map((language) => (
                <button
                  type="button"
                  class:list={['language-switch__item', language.active && 'is-active']}
                  aria-pressed={language.active ? 'true' : 'false'}
                  aria-label={language.name}
                >
                  {language.label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>
</header>

<style>
  .site-header {
    transition: transform 220ms ease;
  }

  .header-shell {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: none;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-header.is-scrolled .header-shell,
  .site-header.is-menu-open .header-shell {
    border-bottom-color: rgba(255, 255, 255, 0.16);
    background: rgba(15, 20, 25, 0.65);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(32px);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: white;
  }

  .header-right {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .brand-logo__name {
    display: inline-flex;
    align-items: center;
    color: currentColor;
    font-size: clamp(1.42rem, 1.24rem + 0.55vw, 1.78rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .language-switch__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.55rem;
    background: rgba(2, 6, 23, 0.3);
    color: rgb(209 213 219);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: 0;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease;
  }

  .language-switch__item:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.045);
    color: white;
  }

  .language-switch__item.is-active {
    border-color: rgba(249, 115, 22, 0.68);
    background: rgba(249, 115, 22, 0.055);
    box-shadow:
      0 0 0 1px rgba(249, 115, 22, 0.12),
      inset 0 0 18px rgba(249, 115, 22, 0.08);
    color: rgb(249 115 22);
    text-shadow: 0 0 14px rgba(249, 115, 22, 0.35);
  }

  .header-cta,
  .header-mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid rgb(249 115 22);
    border-radius: 0.55rem;
    background: rgb(249 115 22);
    padding: 0 1rem;
    color: white;
    font-size: 0.9rem;
    font-weight: 820;
    white-space: nowrap;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .header-cta:hover,
  .header-mobile-cta:hover {
    border-color: rgb(251 146 60);
    background: rgb(251 146 60);
    box-shadow: 0 18px 36px -28px rgba(249, 115, 22, 0.9);
    color: white;
    transform: translateY(-1px);
  }

  .mobile-menu-toggle {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .mobile-menu-toggle:hover {
    border-color: rgba(249, 115, 22, 0.42);
    background: rgba(249, 115, 22, 0.12);
  }

  .header-mobile-cta {
    min-width: 0;
    padding: 0 0.85rem;
    font-size: clamp(0.78rem, 2.45vw, 0.9rem);
    text-align: center;
  }

  .header-mobile-cta span {
    min-width: 0;
  }

  .mobile-menu-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem 0 0;
  }

  .language-switch--mobile {
    width: fit-content;
    margin: 0;
    justify-self: end;
  }

  @supports not ((backdrop-filter: blur(1px))) {
    .site-header.is-scrolled .header-shell,
    .site-header.is-menu-open .header-shell {
      background: rgba(15, 20, 25, 0.92);
    }
  }
</style>
