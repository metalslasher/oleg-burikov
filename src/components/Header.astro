---
import { navigation, siteConfig } from '../config/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isHome = path === '/';
const resolveHref = (href: string) => (isHome && href.startsWith('/#') ? href.slice(1) : href);
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header id="header" class="header" data-header>
  <div class="header__bar wrap">
    <a href="/" class="logo">
      <span class="logo__mark" aria-hidden="true">OB</span>
      <span class="logo__name">{siteConfig.personName}</span>
    </a>

    <nav class="nav" aria-label="Основна навігація">
      {navigation.map((item) => (
        <a href={resolveHref(item.href)} class:list={['nav__link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <a
        href="#contact"
        class="btn btn--primary header__cta"
        data-gtm-event="cta_click"
        data-gtm-label="header_consultation"
        data-gtm-location="header_desktop"
      >
        Обговорити проєкт
        <Icon name="arrow-up-right" />
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Відкрити меню"
        data-menu-toggle
      >
        <span class="menu-toggle__open"><Icon name="menu" size={22} /></span>
        <span class="menu-toggle__close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <nav class="wrap mobile-menu__nav" aria-label="Мобільна навігація">
      {navigation.map((item, index) => (
        <a href={resolveHref(item.href)} class="mobile-menu__link" data-menu-link style={`--i:${index}`}>
          <span class="mobile-menu__index">0{index + 1}</span>
          {item.label}
        </a>
      ))}
      <a
        href="#contact"
        class="btn btn--primary mobile-menu__cta"
        data-menu-link
        data-gtm-event="cta_click"
        data-gtm-label="header_consultation"
        data-gtm-location="header_mobile"
      >
        Обговорити проєкт
        <Icon name="arrow-up-right" />
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      backdrop-filter 250ms ease;
  }

  .header.is-scrolled,
  .header.is-open {
    border-bottom-color: var(--line);
    background: rgb(10 11 13 / 0.78);
    backdrop-filter: blur(18px) saturate(140%);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-paper);
  }

  .logo__mark {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 10px;
    background: var(--color-signal);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: transform 400ms var(--ease-out);
  }

  .logo:hover .logo__mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .logo__name {
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .nav {
    display: none;
    gap: 0.25rem;
  }

  .nav__link {
    position: relative;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.93rem;
    font-weight: 600;
    transition: color 200ms ease, background-color 200ms ease;
  }

  .nav__link:hover {
    color: var(--color-paper);
    background: rgb(255 255 255 / 0.05);
  }

  .nav__link.is-active {
    color: var(--color-paper);
  }

  .nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-signal);
    transform: translateX(-50%);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header__cta {
    display: none;
    min-height: 2.6rem;
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
  }

  .menu-toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--color-paper);
  }

  .menu-toggle__close,
  .header.is-open .menu-toggle__open {
    display: none;
  }

  .header.is-open .menu-toggle__close {
    display: block;
  }

  .menu-toggle span {
    line-height: 0;
  }

  .mobile-menu {
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    border-top: 1px solid var(--line);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    padding-block: 1.5rem 2rem;
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 7vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    animation: menu-in 450ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  .mobile-menu__index {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .mobile-menu__cta {
    margin-top: 2rem;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (min-width: 640px) {
    .header__cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1000px) {
    .nav {
      display: flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }

</style>
