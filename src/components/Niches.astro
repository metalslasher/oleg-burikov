---
import content from '../content/home-uk.json';

const { niches } = content;
---

<section id="niches" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
            Контексти
          </p>
          <h2 class="text-fluid-4xl font-bold leading-tight text-white">
            {niches.title}
          </h2>
        </div>
        {niches.subtitle && (
          <p class="text-fluid-lg leading-relaxed text-gray-400">
            {niches.subtitle}
          </p>
        )}
      </div>

      <div class="niche-groups">
        {niches.groups.map((group) => (
          <article class="niche-group">
            <h3>{group.title}</h3>
            <div>
              {group.items.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .niche-groups {
    display: grid;
    gap: 1px;
    overflow: hidden;
    margin-top: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .niche-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .niche-groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .niche-group {
    background: rgba(2, 6, 23, 0.58);
    padding: 1.2rem;
  }

  @media (min-width: 768px) {
    .niche-group {
      min-height: 12.5rem;
      padding: 1.35rem;
    }
  }

  .niche-group h3 {
    color: white;
    font-size: 1.05rem;
    font-weight: 820;
  }

  .niche-group div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.15rem;
  }

  .niche-group span {
    display: inline-flex;
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.38rem 0.65rem;
    color: rgb(209 213 219);
    font-size: 0.88rem;
    font-weight: 720;
  }
</style>
