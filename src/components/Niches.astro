---
import content from '../content/home-uk.json';

const { niches } = content;

type NicheItem = {
  title: string;
  icon: string;
};

const nicheItems = niches.items as NicheItem[];

const iconMap: Record<string, string> = {
  ecommerce: '<path d="M4 5h2l2 10h9.5l2-7H7.2" /><path d="M9.2 19h.01" /><path d="M17 19h.01" />',
  local: '<path d="M12 21s5.8-5.6 5.8-10.3a5.8 5.8 0 1 0-11.6 0C6.2 15.4 12 21 12 21Z" /><path d="M12 12.6a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4Z" />',
  realestate: '<path d="M4 11.2 12 5l8 6.2" /><path d="M6.5 10.5v9h11v-9" /><path d="M10 19.5v-5h4v5" />',
  education: '<path d="m3.5 8.2 8.5-4 8.5 4-8.5 4-8.5-4Z" /><path d="M6.5 11.2v3.5c0 1.9 2.5 3.4 5.5 3.4s5.5-1.5 5.5-3.4v-3.5" />',
  fintech: '<rect x="3.8" y="5.5" width="16.4" height="13" rx="2.2" /><path d="M3.8 10h16.4" /><path d="M7.5 15.3h3.2" />',
  saas: '<rect x="4" y="5" width="16" height="5.3" rx="1.6" /><path d="M7.2 7.7h.01" /><path d="M10 7.7h6.5" /><rect x="4" y="13.7" width="16" height="5.3" rx="1.6" /><path d="M7.2 16.4h.01" /><path d="M10 16.4h6.5" />',
  auto: '<circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="2.2" /><path d="M12 3.5v6.3M20.5 12h-6.3M12 20.5v-6.3M3.5 12h6.3" />',
  medicine: '<path d="M11 2v2M5 2v2" /><path d="M5 3H4a2 2 0 0 0-2 2v3a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1" /><path d="M8 15a6 6 0 0 0 12 0v-3" /><circle cx="20" cy="10" r="2" />',
  food: '<path d="M3 2v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V2M7 2v20" /><path d="M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3M21 15v7" />',
  mobile: '<rect x="6" y="2.5" width="12" height="19" rx="2.2" /><path d="M10 5.5h4M12 18.5h.01" />',
};
---

<section id="niches" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
          Ніші
        </p>
        <h2 class="text-fluid-4xl font-bold leading-tight text-white">
          {niches.title}
        </h2>
        {niches.subtitle && (
          <p class="mt-4 text-fluid-lg leading-relaxed text-gray-400">
            {niches.subtitle}
          </p>
        )}
      </div>

      <div class="niche-slider" data-niche-slider>
        <div class="niche-grid" data-niche-track>
          {nicheItems.map((item, index) => (
            <article class="niche-card" data-niche-card data-slide-index={index}>
              <div class="niche-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <g set:html={iconMap[item.icon] || iconMap.ecommerce} />
                </svg>
              </div>
              <h3>{item.title}</h3>
            </article>
          ))}
          {nicheItems.map((item, index) => (
            <article class="niche-card niche-card--clone" data-niche-card data-slide-index={index} aria-hidden="true">
              <div class="niche-card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <g set:html={iconMap[item.icon] || iconMap.ecommerce} />
                </svg>
              </div>
              <h3>{item.title}</h3>
            </article>
          ))}
        </div>

        <div class="niche-controls" aria-label="Керування слайдером ніш">
          <p class="niche-counter" aria-live="polite">
            <span data-niche-current>01</span>
            <span aria-hidden="true">/</span>
            <span>{String(nicheItems.length).padStart(2, '0')}</span>
          </p>
          <div class="niche-arrows">
            <button type="button" class="niche-arrow" data-niche-prev aria-label="Попередня ніша">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
              </svg>
            </button>
            <button type="button" class="niche-arrow" data-niche-next aria-label="Наступна ніша">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .niche-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
  }

  .niche-card.niche-card--clone,
  .niche-controls {
    display: none;
  }

  @media (min-width: 768px) {
    .niche-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .niche-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .niche-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 7.5rem;
    align-items: center;
    gap: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 1rem;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .niche-card:hover {
    transform: translateY(-2px);
    border-color: rgba(249, 115, 22, 0.42);
    background: rgba(255, 255, 255, 0.07);
  }

  .niche-card__icon {
    display: inline-flex;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    background: rgba(249, 115, 22, 0.12);
    color: rgb(253 186 116);
  }

  .niche-card__icon svg {
    width: 1.45rem;
    height: 1.45rem;
    overflow: visible;
  }

  .niche-card h3 {
    min-width: 0;
    color: white;
    font-size: clamp(1rem, 0.96rem + 0.18vw, 1.12rem);
    font-weight: 820;
    line-height: 1.2;
  }

  @media (max-width: 767px) {
    .niche-slider {
      margin-top: 2.5rem;
    }

    .niche-grid {
      display: flex;
      gap: 0.75rem;
      margin-top: 0;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
      touch-action: pan-x pan-y;
    }

    .niche-grid::-webkit-scrollbar {
      display: none;
    }

    .niche-card {
      flex: 0 0 calc(100% - 2.75rem);
      min-height: 8.25rem;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      background: #121b2d;
      border-color: rgba(148, 163, 184, 0.22);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
      transition: none;
    }

    .niche-card:hover {
      transform: none;
    }

    .niche-card__icon {
      background: #342629;
    }

    .niche-card.niche-card--clone {
      display: flex;
    }

    .niche-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1rem;
    }

    .niche-counter {
      display: flex;
      gap: 0.35rem;
      color: rgb(148 163 184);
      font-size: 0.8rem;
      font-variant-numeric: tabular-nums;
      font-weight: 700;
    }

    .niche-counter span:first-child {
      color: rgb(251 146 60);
    }

    .niche-arrows {
      display: flex;
      gap: 0.5rem;
    }

    .niche-arrow {
      display: inline-flex;
      width: 2.75rem;
      height: 2.75rem;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(148, 163, 184, 0.22);
      border-radius: 0.55rem;
      background: #121b2d;
      color: white;
    }

    .niche-arrow:active {
      border-color: rgba(249, 115, 22, 0.65);
      color: rgb(251 146 60);
    }

    .niche-arrow svg {
      width: 1.15rem;
      height: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .niche-grid {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const AUTOPLAY_DELAY = 3500;

  const initNicheSlider = () => {
    const slider = document.querySelector<HTMLElement>('[data-niche-slider]');
    if (!slider || slider.dataset.initialized === 'true') return;

    const track = slider.querySelector<HTMLElement>('[data-niche-track]');
    const cards = Array.from(slider.querySelectorAll<HTMLElement>('[data-niche-card]'));
    const currentLabel = slider.querySelector<HTMLElement>('[data-niche-current]');
    const previousButton = slider.querySelector<HTMLButtonElement>('[data-niche-prev]');
    const nextButton = slider.querySelector<HTMLButtonElement>('[data-niche-next]');
    const originalCount = cards.length / 2;

    if (!track || !currentLabel || !previousButton || !nextButton || originalCount < 2) return;

    slider.dataset.initialized = 'true';
    let currentIndex = 0;
    let autoplayTimer = 0;
    let scrollTimer = 0;

    const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
    const cardStep = () => cards[1].offsetLeft - cards[0].offsetLeft;

    const updateCounter = (index: number) => {
      currentLabel.textContent = String((index % originalCount) + 1).padStart(2, '0');
    };

    const moveTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
      if (!isMobile()) return;

      currentIndex = index;
      const left = cardStep() * index;

      if (behavior === 'auto') {
        track.style.scrollBehavior = 'auto';
        track.scrollLeft = left;
        track.getBoundingClientRect();
        track.style.removeProperty('scroll-behavior');
      } else {
        track.scrollTo({ left, behavior });
      }
      updateCounter(index);
    };

    const stopAutoplay = () => window.clearInterval(autoplayTimer);
    const startAutoplay = () => {
      stopAutoplay();
      if (!isMobile() || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      autoplayTimer = window.setInterval(() => moveTo(currentIndex + 1), AUTOPLAY_DELAY);
    };

    const normalizePosition = () => {
      if (currentIndex < originalCount) return;
      currentIndex %= originalCount;
      moveTo(currentIndex, 'auto');
    };

    const syncFromScroll = () => {
      if (!isMobile()) return;
      const step = cardStep();
      if (step <= 0) return;
      currentIndex = Math.round(track.scrollLeft / step);
      updateCounter(currentIndex);
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(normalizePosition, 180);
    };

    previousButton.addEventListener('click', () => {
      if (currentIndex <= 0) {
        moveTo(originalCount, 'auto');
        window.requestAnimationFrame(() => moveTo(originalCount - 1));
      } else {
        moveTo(currentIndex - 1);
      }
      startAutoplay();
    });

    nextButton.addEventListener('click', () => {
      moveTo(currentIndex + 1);
      startAutoplay();
    });

    track.addEventListener('scroll', syncFromScroll, { passive: true });
    track.addEventListener('pointerdown', stopAutoplay, { passive: true });
    track.addEventListener('pointerup', startAutoplay, { passive: true });
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });
    window.addEventListener('resize', () => {
      if (!isMobile()) {
        stopAutoplay();
        track.scrollLeft = 0;
        currentIndex = 0;
        updateCounter(0);
        return;
      }
      moveTo(currentIndex, 'auto');
      startAutoplay();
    });

    startAutoplay();
  };

  initNicheSlider();
  document.addEventListener('astro:page-load', initNicheSlider);
</script>
