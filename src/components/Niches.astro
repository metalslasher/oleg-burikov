---
import content from '../content/home-uk.json';

const { niches } = content;

const iconMap: Record<string, string> = {
  ecommerce: '<path d="M3 4h2l2.4 10.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H7" /><circle cx="10" cy="19" r="1.5" /><circle cx="17" cy="19" r="1.5" />',
  local: '<path d="M12 21s6-6.5 6-11a6 6 0 1 0-12 0c0 4.5 6 11 6 11z" /><circle cx="12" cy="10" r="2.5" />',
  realestate: '<path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" />',
  education: '<path d="M12 4l9 4-9 4-9-4 9-4z" /><path d="M5 12v4c0 2.2 3.1 4 7 4s7-1.8 7-4v-4" />',
  fintech: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /><path d="M7 15h3" />',
  saas: '<path d="M6 18h11a4 4 0 0 0 0-8 5.5 5.5 0 0 0-10-1A4.5 4.5 0 0 0 6 18z" />',
  leadgen: '<path d="M4 5h16l-6 7v5l-4 2v-7L4 5z" />',
  apparel: '<path d="M4 7l4-3 4 2 4-2 4 3-2 3-2-1v12H8V9l-2 1-2-3z" />',
  jewelry: '<path d="M6 4h12l4 6-10 10L2 10l4-6z" />',
  auto: '<rect x="4" y="7" width="16" height="12" rx="2" /><path d="M7 7V5h10v2" /><path d="M9 12h6" /><path d="M8 16h8" />',
  medicine: '<rect x="4" y="8" width="16" height="10" rx="2" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /><path d="M12 11v4" /><path d="M10 13h4" />',
  food: '<path d="M3 18h18" /><path d="M5 18a7 7 0 0 1 14 0" /><path d="M12 9V7" /><path d="M10 7h4" />',
};
---

<section id="niches" class="py-18 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <p class="text-fluid-sm font-semibold tracking-[0.18em] text-accent-400 uppercase mb-3">
        Ніші
      </p>
      <h2 class="text-fluid-4xl font-bold text-white mb-4">
        {niches.title}
      </h2>
      {niches.subtitle && (
        <p class="text-fluid-lg text-gray-400">
          {niches.subtitle}
        </p>
      )}
    </div>

    <div class="max-w-7xl mx-auto grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {niches.items.map((item) => (
        <div class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 px-5 py-5 md:px-6 md:py-6 hover:border-accent-500/40 hover:bg-white/10 transition-all duration-300">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/20 text-accent-400 group-hover:bg-accent-500/30 transition-colors">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <g set:html={iconMap[item.icon] || iconMap.ecommerce} />
            </svg>
          </div>
          <div>
            <div class="text-base md:text-lg font-semibold text-white">
              {item.title}
            </div>
            {item.subtitle && (
              <div class="text-sm text-gray-400">
                {item.subtitle}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
