---
import content from '../content/home-uk.json';
import { siteConfig } from '../config/site';

const { hero } = content;
const hasPortrait = Boolean(hero.portrait);
const secondaryHref = hero.secondaryHref || '#experience';
---

<section id="hero" class="relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(135deg,#020617_0%,#0f172a_58%,#111827_100%)]"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <div class="hero-container">
    <div class={`hero-shell ${hasPortrait ? '' : 'hero-shell--solo'}`}>
      <div class="hero-copy">
        <p class="hero-eyebrow">{hero.eyebrow}</p>

        <h1 class="hero-title">
          {hero.headline}
        </h1>

        <p class="hero-lead">{hero.subheadline}</p>

        <div class="hero-actions">
          <a
            href="#contact"
            data-gtm-event="cta_click"
            data-gtm-label="hero_primary"
            data-gtm-location="home_hero"
            class="hero-button hero-button--primary"
          >
            {hero.cta}
            <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>

          <a
            href={secondaryHref}
            data-gtm-event="cta_click"
            data-gtm-label="hero_secondary_experience"
            data-gtm-location="home_hero"
            class="hero-button hero-button--secondary"
          >
            {hero.ctaSecondary}
          </a>
        </div>

        <div class="hero-professional">
          <span>Потрібен спеціаліст у команду?</span>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            data-gtm-event="cta_click"
            data-gtm-label="hero_linkedin"
            data-gtm-location="home_hero"
          >
            {hero.professionalCta}
          </a>
        </div>
      </div>

      {hasPortrait && (
        <figure class="hero-photo">
          <div class="hero-photo__frame">
            <img
              src={hero.portrait}
              alt={hero.portraitAlt}
              width="560"
              height="680"
              class="hero-photo__image"
              loading="eager"
            />
          </div>
          <figcaption>{hero.photoCaption}</figcaption>
        </figure>
      )}
    </div>

    <div class="hero-proof">
      <div class="hero-focus" aria-label="Ключові напрями">
        {hero.focusAreas.map((item) => (
          <span>{item}</span>
        ))}
      </div>

      <div class="hero-metrics" aria-label="Ключові факти">
        {hero.metrics.map((metric) => (
          <div class="hero-metric">
            <div class="hero-metric__value">{metric.value}</div>
            <div class="hero-metric__label">{metric.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    overflow-x: clip;
  }

  .hero-container {
    width: calc(100% - 2rem);
    max-width: 78rem;
    margin: 0 auto;
    padding: 5.2rem 0 2.6rem;
  }

  @media (min-width: 640px) {
    .hero-container {
      width: calc(100% - 3rem);
      padding: 5.9rem 0 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      padding: 5.25rem 0 1.45rem;
    }
  }

  .hero-shell {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 0.58fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  @media (min-width: 1024px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.72fr);
      gap: clamp(3rem, 6vw, 5.5rem);
    }
  }

  .hero-shell--solo {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-eyebrow {
    margin-bottom: 1rem;
    color: rgb(251 146 60);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 820px;
    color: #fff;
    font-size: clamp(2.65rem, 5vw, 4rem);
    font-weight: 950;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 1.5rem;
    max-width: 700px;
    color: rgb(209 213 219);
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem);
    line-height: 1.58;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  @media (min-width: 520px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.25rem;
    border-radius: 0.55rem;
    padding: 0.85rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 800;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .hero-button:hover {
    transform: translateY(-1px);
  }

  .hero-button--primary {
    background: rgb(249 115 22);
    color: #fff;
  }

  .hero-button--primary:hover {
    background: rgb(251 146 60);
    box-shadow: 0 18px 36px -28px rgba(249, 115, 22, 0.9);
  }

  .hero-button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
  }

  .hero-button--secondary:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.075);
  }

  .hero-professional {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.65rem;
    margin-top: 1rem;
    color: rgb(148 163 184);
    font-size: 0.95rem;
  }

  .hero-professional a {
    color: rgb(253 186 116);
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: rgba(253, 186, 116, 0.35);
    text-underline-offset: 4px;
  }

  .hero-photo {
    width: min(100%, 310px);
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .hero-photo {
      width: 100%;
      max-width: 280px;
      margin: 0 0 0 auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-photo {
      max-width: 320px;
    }
  }

  .hero-photo__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.65rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
      rgb(15 23 42);
    box-shadow: 0 24px 70px -52px rgba(0, 0, 0, 0.95);
  }

  .hero-photo__frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, rgba(2, 6, 23, 0.68));
    pointer-events: none;
  }

  .hero-photo__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-photo figcaption {
    margin-top: 0.85rem;
    color: rgb(156 163 175);
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: center;
  }

  .hero-proof {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  @media (min-width: 1024px) {
    .hero-proof {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
      align-items: stretch;
      margin-top: 2.25rem;
    }
  }

  .hero-focus,
  .hero-metrics {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
  }

  .hero-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-content: center;
    padding: 1rem;
  }

  .hero-focus span {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 0.45rem;
    background: rgba(2, 6, 23, 0.45);
    color: rgb(229 231 235);
    padding: 0.35rem 0.65rem;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .hero-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero-metric {
    min-width: 0;
    padding: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-metric:first-child {
    border-top: 0;
  }

  @media (min-width: 640px) {
    .hero-metric {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-metric:first-child {
      border-left: 0;
    }
  }

  .hero-metric__value {
    color: rgb(251 146 60);
    font-size: clamp(1.65rem, 1.35rem + 1vw, 2.35rem);
    font-weight: 950;
    line-height: 1;
  }

  .hero-metric__label {
    margin-top: 0.45rem;
    color: rgb(156 163 175);
    font-size: 0.86rem;
    line-height: 1.35;
  }

  @media (max-width: 639px) {
    .hero-container {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .hero-shell {
      gap: 1.65rem;
    }

    .hero-eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }

    .hero-title {
      font-size: clamp(2rem, 9vw, 2.45rem);
    }

    .hero-lead {
      font-size: 1.04rem;
    }

    .hero-photo {
      width: min(100%, 160px);
    }

    .hero-photo figcaption {
      display: none;
    }

    .hero-proof {
      display: none;
    }

    .hero-actions {
      align-items: stretch;
      gap: 0.65rem;
      margin-top: 1.45rem;
    }

    .hero-button--secondary {
      align-self: flex-start;
      width: auto;
      min-height: auto;
      justify-content: flex-start;
      border: 0;
      background: transparent;
      padding: 0.2rem 0;
      color: rgb(253 186 116);
    }

    .hero-button--secondary:hover {
      background: transparent;
      color: white;
    }

    .hero-professional {
      margin-top: 0.55rem;
      font-size: 0.86rem;
    }

    .hero-professional span {
      display: none;
    }
  }
</style>
