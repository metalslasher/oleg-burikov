---
import content from '../content/home-uk.json';

const { hero } = content;
const hasPortrait = Boolean(hero.portrait);
const secondaryHref = hero.secondaryHref || '#experience';
const headlineLines = hero.headlineLines || [hero.headline];
---

<section id="hero" class="relative isolate overflow-hidden">
  <div class="hero-container">
    <div class={`hero-shell ${hasPortrait ? '' : 'hero-shell--solo'}`}>
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span aria-hidden="true"></span>
          {hero.eyebrow}
        </p>

        <h1 class="hero-title">
          {headlineLines.map((line, index) => (
            <span>
              {line}
              {index === headlineLines.length - 1 && hero.headlineAccent && (
                <> <strong>{hero.headlineAccent}</strong></>
              )}
            </span>
          ))}
        </h1>

        <p class="hero-lead">{hero.subheadline}</p>

        <div class="hero-actions">
          <a
            href="#contact"
            data-gtm-event="cta_click"
            data-gtm-label="hero_primary"
            data-gtm-location="home_hero"
            class="hero-button hero-button--primary"
          >
            {hero.cta}
          </a>

          <a
            href={secondaryHref}
            data-gtm-event="cta_click"
            data-gtm-label="hero_secondary_cases"
            data-gtm-location="home_hero"
            class="hero-button hero-button--secondary"
          >
            {hero.ctaSecondary}
          </a>
        </div>
      </div>

      {hasPortrait && (
        <figure class="hero-photo">
          <div class="hero-photo__frame">
            <img
              src={hero.portrait}
              alt={hero.portraitAlt}
              width="1189"
              height="1058"
              class="hero-photo__image"
              loading="eager"
            />
          </div>
        </figure>
      )}
    </div>

    <div class="hero-proof">
      <div class="hero-metrics" aria-label="Ключові факти">
        {hero.metrics.map((metric, index) => (
          <div class="hero-metric">
            <div class="hero-metric__icon" aria-hidden="true">
              {index === 0 && (
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                  <path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"></path>
                </svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 2v20M17 5.5C15.9 4.6 14.4 4 12.6 4c-2.5 0-4.4 1.2-4.4 3.2 0 4.6 9.8 2.2 9.8 7.5 0 2.1-2 3.3-4.8 3.3-2.1 0-4-.7-5.4-1.9"></path>
                </svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M10 6V5a2 2 0 0 1 4 0v1M4 7h16v12H4zM4 12h16M9 12v2h6v-2"></path>
                </svg>
              )}
            </div>
            <div class="hero-metric__content">
              <div class="hero-metric__value">{metric.value}</div>
              <div class="hero-metric__label">{metric.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    overflow-x: clip;
  }

  .hero-container {
    width: calc(100% - 2rem);
    max-width: 80rem;
    margin: 0 auto;
    padding: 4.8rem 0 2.6rem;
  }

  @media (min-width: 640px) {
    .hero-container {
      width: calc(100% - 3rem);
      padding: 5.6rem 0 2.8rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      width: calc(100% - 4rem);
      padding: 5.2rem 0 2.1rem;
    }
  }

  .hero-shell {
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1fr) minmax(250px, 0.72fr);
      gap: clamp(1.8rem, 4.5vw, 4.2rem);
    }
  }

  @media (min-width: 1024px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1fr) minmax(340px, 0.54fr);
      gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }
  }

  .hero-shell--solo {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2rem;
    margin-bottom: 1.2rem;
    border: 1px solid rgba(249, 115, 22, 0.68);
    border-radius: 0.38rem;
    background: rgba(2, 6, 23, 0.32);
    color: rgb(251 146 60);
    padding: 0.35rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero-eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(249 115 22);
    box-shadow: 0 0 16px rgba(249, 115, 22, 0.72);
  }

  .hero-title {
    max-width: 720px;
    color: #fff;
    font-size: clamp(2.45rem, 3.8vw, 3.25rem);
    font-weight: 950;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .hero-title span {
    display: block;
  }

  .hero-title strong {
    color: rgb(249 115 22);
    font-weight: inherit;
  }

  .hero-lead {
    margin-top: 1.25rem;
    max-width: 620px;
    color: rgb(209 213 219);
    font-size: clamp(1rem, 0.95rem + 0.28vw, 1.14rem);
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.55rem;
  }

  @media (min-width: 520px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.05rem;
    border-radius: 0.42rem;
    padding: 0.82rem 1.35rem;
    font-size: 0.96rem;
    font-weight: 850;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .hero-button:hover {
    transform: translateY(-1px);
  }

  .hero-button--primary {
    background: rgb(249 115 22);
    color: #fff;
  }

  .hero-button--primary:hover {
    background: rgb(251 146 60);
    box-shadow: 0 18px 36px -28px rgba(249, 115, 22, 0.9);
  }

  .hero-button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(2, 6, 23, 0.3);
    color: #fff;
  }

  .hero-button--secondary:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.07);
  }

  .hero-photo {
    position: relative;
    isolation: isolate;
    width: min(100%, 300px);
    margin: 0 auto;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hero-photo {
      width: 100%;
      max-width: 300px;
      margin: 0 0 0 auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-photo {
      width: 100%;
      max-width: 440px;
      min-height: clamp(29rem, 37vw, 33rem);
      align-self: stretch;
      margin-right: 0;
      transform: none;
    }
  }

  .hero-photo__frame {
    position: relative;
    z-index: 1;
    overflow: visible;
    aspect-ratio: 1189 / 1058;
    border-radius: 0;
    background: transparent;
  }

  @media (min-width: 1024px) {
    .hero-photo__frame {
      position: absolute;
      right: 0;
      bottom: -3.2rem;
      height: clamp(30rem, 40vw, 34.5rem);
      max-height: 34.5rem;
      aspect-ratio: auto;
    }
  }

  .hero-photo__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  @media (min-width: 1024px) {
    .hero-photo__image {
      width: auto;
      max-width: none;
    }
  }

  .hero-proof {
    margin-top: clamp(1.5rem, 2.6vw, 2.25rem);
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 0.55rem;
    background: rgba(2, 6, 23, 0.52);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
  }

  @media (min-width: 720px) {
    .hero-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero-metric {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-metric:first-child {
    border-top: 0;
  }

  @media (min-width: 720px) {
    .hero-metric {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hero-metric:first-child {
      border-left: 0;
    }
  }

  .hero-metric__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 3.3rem;
    height: 3.3rem;
    border: 1px solid rgba(249, 115, 22, 0.72);
    border-radius: 999px;
    background: rgba(2, 6, 23, 0.42);
    color: rgb(249 115 22);
  }

  .hero-metric__icon svg {
    width: 1.45rem;
    height: 1.45rem;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-metric__content {
    min-width: 0;
  }

  .hero-metric__value {
    color: rgb(251 146 60);
    font-size: clamp(1.2rem, 1.02rem + 0.65vw, 1.6rem);
    font-weight: 950;
    line-height: 1.08;
  }

  .hero-metric__label {
    margin-top: 0.35rem;
    color: rgb(203 213 225);
    font-size: 0.86rem;
    line-height: 1.35;
  }

  @media (max-width: 767px) {
    .hero-shell {
      gap: 0.25rem;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .hero-photo {
      width: min(100%, 300px);
      margin-top: -0.75rem;
    }
  }

  @media (max-width: 639px) {
    .hero-container {
      padding-top: 2rem;
      padding-bottom: 1.25rem;
    }

    .hero-eyebrow {
      min-height: 1.85rem;
      margin-bottom: 1rem;
      padding: 0.32rem 0.58rem;
      font-size: 0.63rem;
      letter-spacing: 0.075em;
    }

    .hero-title {
      font-size: clamp(2.05rem, 9.2vw, 2.65rem);
      line-height: 1.1;
    }

    .hero-lead {
      margin-top: 1rem;
      font-size: 1rem;
      line-height: 1.62;
    }

    .hero-actions {
      align-items: stretch;
      gap: 0.7rem;
      margin-top: 1.05rem;
    }

    .hero-button {
      width: 100%;
      min-height: 2.9rem;
      padding: 0.75rem 1rem;
      font-size: 0.92rem;
    }

    .hero-button--secondary {
      background: rgba(2, 6, 23, 0.34);
    }

    .hero-photo {
      width: min(100%, 318px);
      margin-top: 0.35rem;
    }

    .hero-proof {
      margin-top: -0.15rem;
    }

    .hero-metric {
      gap: 0.85rem;
      padding: 0.95rem;
    }

    .hero-metric__icon {
      width: 2.75rem;
      height: 2.75rem;
    }

    .hero-metric__value {
      font-size: 1.15rem;
    }
  }
</style>
