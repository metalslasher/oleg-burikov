---
import content from '../content/home-uk.json';

const { hero } = content;
const highlightPhrase = 'Google Ads та Meta Ads';
const hasHighlight = hero.headline.includes(highlightPhrase);
const [headlinePrefix, headlineSuffix] = hasHighlight
  ? hero.headline.split(highlightPhrase)
  : [hero.headline, ''];
const subheadlineParts = hero.subheadline
  .split('.')
  .map((part) => part.trim())
  .filter(Boolean);
---

<section id="hero" class="relative min-h-0 sm:min-h-screen flex items-start sm:items-center justify-center overflow-hidden">
  <!-- Animated Background Elements -->
  <div class="absolute inset-0 overflow-hidden hidden">
    <div class="absolute top-1/4 -left-48 w-96 h-96 bg-primary-500/30 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 -right-48 w-96 h-96 bg-accent-500/30 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-500/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <!-- Floating 3D Tool Icons -->
  <div class="absolute inset-0 pointer-events-none z-0 hidden md:block">
    <!-- Google Ads Icon - Top Left -->
    <div 
      class="floating-icon absolute top-32 left-[8%] w-20 h-20 lg:w-24 lg:h-24 opacity-0"
      data-scroll-fade
      style="animation-delay: 0.2s;"
    >
      <div class="relative w-full h-full transform-gpu hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-2xl shadow-2xl animate-float" style="animation-delay: 0s;"></div>
        <div class="absolute inset-0 p-4 flex items-center justify-center">
          <img src="/icons/google-ads.png" alt="Google Ads" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- Meta Ads Icon - Top Right -->
    <div 
      class="floating-icon absolute top-32 right-[6%] w-20 h-20 lg:w-24 lg:h-24 opacity-0"
      data-scroll-fade
      style="animation-delay: 0.4s;"
    >
      <div class="relative w-full h-full transform-gpu hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-2xl shadow-2xl animate-float" style="animation-delay: 0.5s;"></div>
        <div class="absolute inset-0 p-4 flex items-center justify-center">
          <img src="/icons/facebook.png" alt="Meta Ads" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- YouTube Icon - Middle Left -->
    <div 
      class="floating-icon absolute top-[45%] left-[5%] w-20 h-20 lg:w-24 lg:h-24 opacity-0"
      data-scroll-fade
      style="animation-delay: 0.6s;"
    >
      <div class="relative w-full h-full transform-gpu hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-2xl shadow-2xl animate-float" style="animation-delay: 1s;"></div>
        <div class="absolute inset-0 p-4 flex items-center justify-center">
          <img src="/icons/youtube.png" alt="YouTube Ads" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- TikTok Icon - Bottom Left -->
    <div 
      class="floating-icon absolute bottom-32 left-[12%] w-18 h-18 lg:w-22 lg:h-22 opacity-0"
      data-scroll-fade
      style="animation-delay: 0.8s;"
    >
      <div class="relative w-full h-full transform-gpu hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-2xl shadow-2xl animate-float" style="animation-delay: 1.5s;"></div>
        <div class="absolute inset-0 p-3 flex items-center justify-center">
          <img src="/icons/tiktok-ads.png" alt="TikTok Ads" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- GA4 Icon - Bottom Right -->
    <div 
      class="floating-icon absolute bottom-28 right-[8%] w-20 h-20 lg:w-24 lg:h-24 opacity-0"
      data-scroll-fade
      style="animation-delay: 1s;"
    >
      <div class="relative w-full h-full transform-gpu hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-2xl shadow-2xl animate-float" style="animation-delay: 2s;"></div>
        <div class="absolute inset-0 p-4 flex items-center justify-center">
          <img src="/icons/ga4.png" alt="Google Analytics 4" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- Instagram Icon - Middle Right -->
    <div 
      class="floating-icon absolute top-[40%] right-[5%] w-20 h-20 lg:w-24 lg:h-24 opacity-0"
      data-scroll-fade
      style="animation-delay: 0.7s;"
    >
      <div class="relative w-full h-full transform-gpu hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-2xl shadow-2xl animate-float" style="animation-delay: 1.2s;"></div>
        <div class="absolute inset-0 p-4 flex items-center justify-center">
          <img src="/icons/instagram.png" alt="Instagram Ads" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-20 pt-8 sm:pt-10 md:pt-40 pb-12 sm:pb-16">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
        {hasHighlight ? (
          <>
            <span class="block sm:inline sm:mr-2">{headlinePrefix.trim()}</span>
            <span class="block sm:inline sm:mr-2">
              <span class="text-accent-400">Google Ads</span>
              <span class="text-white"> та </span>
              <span class="text-accent-400">Meta Ads</span>
            </span>
            {headlineSuffix.trim() && (
              <span class="block sm:inline">{headlineSuffix.trim()}</span>
            )}
          </>
        ) : (
          hero.headline
        )}
      </h1>

      <div class="text-gray-300 mb-8 sm:mb-10 leading-relaxed max-w-3xl mx-auto">
        <div class="flex flex-wrap justify-center gap-2 sm:gap-0 text-sm sm:text-xl md:text-2xl">
          {subheadlineParts.map((part, index) => (
            <span class="inline-flex items-center">
              <span class="rounded-full bg-white/5 border border-white/10 px-3 py-1 sm:bg-transparent sm:border-transparent sm:px-0 sm:py-0">
                {part}
              </span>
              {index < subheadlineParts.length - 1 && (
                <span class="hidden sm:inline-flex items-center justify-center mx-2 h-[1em]">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-400/70"></span>
                </span>
              )}
            </span>
          ))}
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8 sm:mb-12">
        <a
          href="#contact"
          class="group relative inline-flex items-center justify-center bg-gradient-to-r from-accent-500 to-accent-600 text-white px-8 py-4 rounded-xl font-semibold text-lg hover:shadow-[0_0_40px_rgba(251,146,60,0.5)] transition-all duration-300 hover:scale-105 w-full sm:w-auto"
        >
          <span class="relative z-10 flex items-center gap-2">
            {hero.cta}
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-accent-600 to-accent-700 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a
          href="#cases"
          class="inline-flex items-center justify-center bg-white/10 border border-white/20 backdrop-blur-sm text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/15 transition-all duration-200 w-full sm:w-auto"
        >
          {hero.ctaSecondary}
        </a>
      </div>

      <!-- Animated Metrics Badge -->
      <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm text-white">
        <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
        <span id="animated-metric" class="text-sm font-medium">{hero.metricsLabel}</span>
      </div>

      <!-- Scroll Indicator (Mobile) -->
      <div class="mt-6 flex justify-center sm:hidden animate-bounce">
        <svg class="w-6 h-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce hidden sm:block">
        <svg class="w-6 h-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ metrics: hero.metrics }}>
  window.__HERO_METRICS__ = metrics;
</script>

<script>
  // Animated metrics rotation
  document.addEventListener('DOMContentLoaded', () => {
    const metricElement = document.getElementById('animated-metric');
    
    const metricsData = typeof window !== 'undefined' 
      ? (window as any).__HERO_METRICS__ || []
      : [];
    
    let currentIndex = 0;
    
    function updateMetric() {
      if (metricElement && metricsData.length > 0) {
        // Fade out
        metricElement.style.opacity = '0';
        metricElement.style.transform = 'translateY(-10px)';
        
        setTimeout(() => {
          // Change text
          currentIndex = (currentIndex + 1) % metricsData.length;
          metricElement.textContent = metricsData[currentIndex];
          
          // Fade in
          metricElement.style.opacity = '1';
          metricElement.style.transform = 'translateY(0)';
        }, 300);
      }
    }
    
    // Add transition styles
    if (metricElement) {
      metricElement.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      
      // Rotate metrics every 3 seconds
      if (metricsData.length > 0) {
        setInterval(updateMetric, 3000);
      }
    }

    // Scroll-triggered fade-in animation for floating icons
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in-visible');
        }
      });
    }, observerOptions);

    // Observe all floating icons
    const floatingIcons = document.querySelectorAll('[data-scroll-fade]');
    floatingIcons.forEach(icon => {
      observer.observe(icon);
    });

    // Parallax effect on scroll for icons
    let ticking = false;
    
    function updateIconsPosition() {
      const scrolled = window.scrollY;
      const icons = document.querySelectorAll('.floating-icon');
      
      icons.forEach((icon, index) => {
        const speed = 0.3 + (index * 0.1); // Different speeds for each icon
        const yPos = -(scrolled * speed);
        (icon as HTMLElement).style.transform = `translateY(${yPos}px)`;
      });
      
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateIconsPosition);
        ticking = true;
      }
    });
  });
</script>

<style>
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-10px) rotate(2deg);
    }
    50% {
      transform: translateY(-5px) rotate(-2deg);
    }
    75% {
      transform: translateY(-15px) rotate(1deg);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .floating-icon {
    transition: opacity 0.8s ease-out, transform 0.3s ease-out;
  }

  .fade-in-visible {
    opacity: 1 !important;
    animation: fadeInScale 0.8s ease-out forwards;
  }

  @keyframes fadeInScale {
    0% {
      opacity: 0;
      transform: scale(0.8) translateY(20px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* 3D effect shadows */
  .floating-icon > div > div:first-child {
    box-shadow: 
      0 10px 40px rgba(0, 0, 0, 0.3),
      0 0 80px rgba(var(--shadow-color, 99, 102, 241), 0.4);
  }

  .floating-icon:hover > div > div:first-child {
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.4),
      0 0 100px rgba(var(--shadow-color, 99, 102, 241), 0.6);
  }
</style>
