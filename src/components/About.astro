---
import content from '../content/home-uk.json';

const { about } = content;
const nonce = Astro.locals.cspNonce;
const introParagraphs = about.intro
  .split('\n\n')
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<section id="about" class="py-20 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-6xl mx-auto text-center">
        <p class="text-fluid-sm font-semibold tracking-[0.16em] text-accent-400 uppercase mb-4">
          Про агенцію
        </p>
        <h2 class="text-fluid-4xl font-bold text-white mb-5">
          {about.title}
        </h2>
        {about.subtitle && (
          <p class="text-fluid-lg text-gray-300 leading-relaxed max-w-3xl mx-auto mb-4">
            {about.subtitle}
          </p>
        )}
        {introParagraphs.length > 0 && (
          <div class="grid lg:grid-cols-2 gap-6 md:gap-8 text-fluid-lg text-gray-300 leading-relaxed text-left">
            {introParagraphs.map((paragraph) => (
              <p class="m-0">{paragraph}</p>
            ))}
          </div>
        )}
      </div>

      <!-- Advantages -->
      <div class="mt-12 md:mt-14">
        <div class="grid md:grid-cols-2 gap-5 md:gap-6">
          {about.advantages.map((advantage) => (
            <div
              class="relative rounded-2xl border border-white/10 bg-white/5 p-5 md:p-6 hover:bg-white/10 transition-all duration-200 hover:-translate-y-1"
            >
              <div
                class="absolute inset-y-4 left-0 w-1 rounded-full bg-gradient-to-b from-accent-400 to-primary-400"
              ></div>

              <div class="pl-5 md:pl-6">
                <div class="mb-2 flex items-center gap-2">
                  <div
                    class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-accent-500/20 text-accent-400"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <h3 class="text-base md:text-lg font-semibold text-white">
                    {advantage.title}
                  </h3>
                </div>
                <p class="text-sm md:text-base text-gray-400 leading-relaxed">
                  {advantage.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-12 md:mt-14">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
          {about.stats.map((stat) => (
            <div class="relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-5 md:p-6">
              <div class="relative z-10">
                <div
                  class="text-3xl md:text-4xl font-black text-accent-400 mb-1"
                  data-countup
                >
                  {stat.value}
                </div>
                <div class="text-xs md:text-sm text-gray-400 font-medium">
                  {stat.label}
                </div>
              </div>
              <div class="absolute -bottom-2 -right-2 w-20 h-20 bg-accent-500/10 rounded-full blur-2xl"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script nonce={nonce}>
  const counters = Array.from(document.querySelectorAll('[data-countup]'));
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const parseCounter = (rawValue) => {
    const match = rawValue.match(/^([^0-9]*)(\d+(?:[.,]\d+)?)([^0-9]*)$/);
    if (!match) return null;

    const [, prefix, numberRaw, suffix] = match;
    const normalized = numberRaw.replace(',', '.');
    const target = Number.parseFloat(normalized);

    if (!Number.isFinite(target)) return null;

    const decimals = normalized.includes('.') ? normalized.split('.')[1].length : 0;
    return { prefix, suffix, target, decimals, raw: rawValue };
  };

  const animateCounter = (element) => {
    if (element.dataset.counted === 'true') return;

    const rawValue = element.textContent?.trim() ?? '';
    const data = parseCounter(rawValue);
    if (!data) return;

    element.dataset.counted = 'true';

    if (prefersReduced) {
      element.textContent = `${data.prefix}${data.target.toFixed(data.decimals)}${data.suffix}`;
      return;
    }

    const duration = 1200;
    const start = performance.now();

    const step = (now) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = data.target * eased;
      const value = data.decimals > 0 ? current.toFixed(data.decimals) : Math.round(current).toString();
      element.textContent = `${data.prefix}${value}${data.suffix}`;

      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };

    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.6 });

    counters.forEach((counter) => observer.observe(counter));
  } else {
    counters.forEach((counter) => animateCounter(counter));
  }
</script>
