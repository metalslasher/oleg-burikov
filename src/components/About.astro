---
import content from '../content/home-uk.json';

const { about } = content;
const introParagraphs = about.intro
  .split('\n\n')
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const iconMap: Record<string, string> = {
  experience:
    '<path d="M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4-3.9-3.8 5.4-.8L12 3z" />',
  roi:
    '<path d="M3 3v18h18" /><path d="M18 17l-5-5-4 4-5-5" />',
  transparency:
    '<path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6-10-6-10-6z" /><circle cx="12" cy="12" r="2.5" />',
  system:
    '<path d="M4 7h16" /><path d="M4 17h16" /><path d="M7 4v6" /><path d="M17 14v6" />',
};
---

<section id="about" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div class="about-copy">
          <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
            {about.sectionLabel}
          </p>
          <h2 class="text-fluid-4xl font-bold leading-tight text-white">
            {about.title}
          </h2>

          {about.subtitle && (
            <p class="mt-5 text-fluid-lg leading-relaxed text-gray-300">
              {about.subtitle}
            </p>
          )}

          <div class="mt-6 space-y-5 text-base leading-relaxed text-gray-400 md:text-lg">
            {introParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="about-callout">
            {about.callout}
          </div>
        </div>

        <div class="about-side">
          <div class="about-signals">
            {about.signals.map((signal) => (
              <span>{signal}</span>
            ))}
          </div>

          <div class="about-advantages">
            {about.advantages.map((advantage) => (
              <article class="about-advantage">
                <div class="about-advantage__icon">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <g set:html={iconMap[advantage.icon] || iconMap.experience} />
                  </svg>
                </div>
                <div>
                  <h3>{advantage.title}</h3>
                  <p>{advantage.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-copy {
    max-width: 700px;
  }

  .about-callout {
    margin-top: 2rem;
    border-left: 3px solid rgb(249 115 22);
    padding-left: 1.25rem;
    color: white;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem);
    font-weight: 760;
    line-height: 1.55;
  }

  .about-side {
    display: grid;
    gap: 1.25rem;
  }

  .about-signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    padding: 1rem;
  }

  .about-signals span {
    display: inline-flex;
    border-radius: 0.45rem;
    background: rgba(2, 6, 23, 0.5);
    padding: 0.45rem 0.7rem;
    color: rgb(229 231 235);
    font-size: 0.9rem;
    font-weight: 760;
  }

  .about-advantages {
    display: grid;
    gap: 0.9rem;
  }

  .about-advantage {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .about-advantage {
      padding: 1.15rem;
    }
  }

  .about-advantage__icon {
    display: inline-flex;
    height: 2.55rem;
    width: 2.55rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    background: rgba(249, 115, 22, 0.13);
    color: rgb(253 186 116);
  }

  .about-advantage h3 {
    color: white;
    font-size: 1.05rem;
    font-weight: 820;
  }

  .about-advantage p {
    margin-top: 0.35rem;
    color: rgb(156 163 175);
    line-height: 1.6;
  }
</style>
