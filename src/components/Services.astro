---
import content from '../content/home-uk.json';

const { services } = content;

const iconMap: Record<string, string> = {
  google: '<circle cx="12" cy="12" r="7" /><circle cx="12" cy="12" r="3" />',
  meta: '<path d="M4 15.5c1.2-5.1 3.2-7 5.1-7 1.4 0 2.4 1 3.5 2.7 1.1-1.7 2.3-2.7 3.8-2.7 2.1 0 3.6 1.9 3.6 4.2 0 2.2-1.2 3.8-2.9 3.8-1.4 0-2.5-.9-4.2-3.5-1.7 2.6-2.9 3.5-4.4 3.5-1.9 0-3.2-1.4-4.5-1z" />',
  analytics: '<path d="M4 20h16" /><path d="M6 20v-6" /><path d="M12 20V6" /><path d="M18 20v-9" />',
  consulting: '<path d="M9 18h6" /><path d="M10 21h4" /><path d="M12 3a6 6 0 0 0-3 11.2V17h6v-2.8A6 6 0 0 0 12 3z" />',
  website: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /><path d="M8 15h4" />',
  creative: '<path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z" /><path d="M13.5 7.5l3 3" />',
};
---

<section id="services" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-fluid-4xl font-bold leading-tight text-white">
        {services.title}
      </h2>

      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {services.items.map((service, index) => (
          <a
            href={service.slug ? `/services/${service.slug}` : '/services'}
            class="service-card group"
            aria-label={`Детальніше про ${service.title}`}
          >
            <div class="service-card__top">
              <div class="service-card__index">{String(index + 1).padStart(2, '0')}</div>
              <div class="service-card__icon">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <g set:html={iconMap[service.icon] || iconMap.analytics} />
                </svg>
              </div>
            </div>

            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-card {
    display: flex;
    min-height: 15.5rem;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 1.35rem;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  @media (min-width: 768px) {
    .service-card {
      padding: 1.6rem;
    }
  }

  .service-card:hover {
    transform: translateY(-2px);
    border-color: rgba(249, 115, 22, 0.45);
    background: rgba(255, 255, 255, 0.07);
  }

  .service-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .service-card__index {
    color: rgba(255, 255, 255, 0.36);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .service-card__icon {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    background: rgba(249, 115, 22, 0.14);
    color: rgb(253 186 116);
  }

  .service-card h3 {
    color: white;
    font-size: clamp(1.35rem, 1.15rem + 0.65vw, 1.9rem);
    font-weight: 850;
    line-height: 1.15;
  }

  .service-card p {
    margin-top: 0.95rem;
    color: rgb(156 163 175);
    line-height: 1.65;
  }
</style>
