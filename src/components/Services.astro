---
import content from '../content/home-uk.json';

const { services } = content;
---

<section id="services" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
          {services.eyebrow}
        </p>
        <h2 class="text-fluid-4xl font-bold leading-tight text-white">
          {services.title}
        </h2>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {services.items.map((service, index) => (
          <a
            href={service.slug ? `/services/${service.slug}` : '/services'}
            class="service-card group"
            aria-label={`Детальніше про ${service.title}`}
          >
            <div class="service-card__top">
              <div class="service-card__index">{String(index + 1).padStart(2, '0')}</div>
              <div class="service-card__icon">
                <span aria-hidden="true">{service.icon}</span>
              </div>
            </div>

            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-card {
    display: flex;
    min-height: 15.5rem;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 1.35rem;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  @media (min-width: 768px) {
    .service-card {
      padding: 1.6rem;
    }
  }

  .service-card:hover {
    transform: translateY(-2px);
    border-color: rgba(249, 115, 22, 0.45);
    background: rgba(255, 255, 255, 0.07);
  }

  .service-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .service-card__index {
    color: rgba(255, 255, 255, 0.36);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .service-card__icon {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.06);
  }

  .service-card__icon span {
    display: block;
    font-size: 1.45rem;
    line-height: 1;
  }

  .service-card h3 {
    color: white;
    font-size: clamp(1.35rem, 1.15rem + 0.65vw, 1.9rem);
    font-weight: 850;
    line-height: 1.15;
  }

  .service-card p {
    margin-top: 0.95rem;
    color: rgb(156 163 175);
    line-height: 1.65;
  }
</style>
