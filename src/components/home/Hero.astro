---
import { proofStats } from '../../data/profile';
import { heroKpis } from '../../data/cases';
import Icon from '../Icon.astro';

const headline = ['Маркетинг,', 'який', 'приводить', 'клієнтів', 'і'];
const accent = ['збільшує', 'прибуток'];
const initial = heroKpis.slice(0, 3);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg grid-bg" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title display" aria-label={`${headline.join(' ')} ${accent.join(' ')}`}>
        {[...headline, ...accent].map((word, index) => (
          <span class="hero__word" aria-hidden="true" style={`--w:${index}`}>
            <span class:list={[index >= headline.length && 'is-accent']}>{word}</span>
          </span>
        ))}
      </h1>

      <p class="hero__lead lead">
        Допомагаю запускати й масштабувати бізнес під ключ: від стратегії та сайту до креативів, реклами в Google, Meta і
        TikTok та аналітики, яка показує реальний результат.
      </p>

      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary" data-gtm-event="cta_click" data-gtm-label="hero_primary" data-gtm-location="home_hero">
          Обговорити проєкт
          <Icon name="arrow-up-right" />
        </a>
        <a href="/cases" class="btn btn--ghost" data-gtm-event="cta_click" data-gtm-label="hero_secondary_cases" data-gtm-location="home_hero">
          Дивитися кейси
        </a>
      </div>

      <a href="/about" class="hero__hire" data-gtm-event="cta_click" data-gtm-label="hero_hire" data-gtm-location="home_hero">
        Шукаєте маркетолога в команду? <span>Резюме і досвід</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="hero__visual" data-hero-kpis data-pool={JSON.stringify(heroKpis)}>
      <img
        class="hero__photo"
        src="/images/oleg-burikov-hero-cutout.webp"
        alt="Олег Буріков, performance-маркетолог"
        width="1189"
        height="1058"
        fetchpriority="high"
        decoding="async"
      />

      {initial.map((kpi, index) => (
        <a href={`/cases/${kpi.slug}`} class={`kpi kpi--${index}`} data-kpi-slot={index}>
          <span class="kpi__label">{kpi.label}</span>
          <span class="kpi__value">{kpi.from && <s>{kpi.from}</s>}{kpi.value}</span>
          <span class:list={['kpi__note', kpi.positive && 'up']}>{kpi.note}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="wrap">
    <dl class="proof">
      {proofStats.map((stat, index) => (
        <div class="proof__item" data-reveal style={`--reveal-i:${index}`}>
          <dt class="proof__label">{stat.label}</dt>
          <dd class="proof__value">
            <span class="num" data-count>{stat.value}</span>
            <span class="proof__suffix">{stat.suffix}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { initHeroKpis } from '../../scripts/heroKpis';
  initHeroKpis();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 4.5rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 35%, #000 20%, transparent 75%);
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    top: 8%;
    right: -10%;
    width: min(60vw, 46rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 90 31 / 0.32), rgb(255 90 31 / 0.06) 45%, transparent 70%);
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2rem;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.1rem + 2.8vw, 3.2rem);
    line-height: 1.06;
  }

  /* Word-by-word reveal: each word slides up from behind a mask */
  .hero__word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }

  .hero__word {
    margin-right: 0.24em;
  }

  .hero__word > span {
    display: inline-block;
  }

  .is-accent {
    color: var(--color-signal);
  }

  .js .hero__word > span {
    animation: word-up 900ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--w) * 70ms);
  }

  @keyframes word-up {
    from {
      transform: translateY(105%);
    }
  }

  .hero__lead {
    max-width: 36rem;
    margin-top: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__hire {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin-top: 1.75rem;
    color: var(--color-faint);
    font-size: 0.9rem;
  }

  .hero__hire span {
    color: var(--color-paper);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }

  .hero__hire:hover span {
    text-decoration-color: var(--color-signal);
  }

  .hero__hire svg {
    color: var(--color-signal);
    transition: transform 200ms var(--ease-out);
  }

  .hero__hire:hover svg {
    transform: translateX(3px);
  }

  /* Portrait composition */
  .hero__visual {
    position: relative;
    width: min(100%, 33rem);
    margin-inline: auto;
    aspect-ratio: 1189 / 1058;
  }

  .hero__photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
  }

  .kpi {
    position: absolute;
    display: grid;
    gap: 0.15rem;
    min-width: 10rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: rgb(16 18 22 / 0.92);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.45);
    animation: float 7s ease-in-out infinite;
    transition:
      border-color 200ms ease,
      opacity 450ms ease,
      filter 450ms ease,
      translate 450ms var(--ease-out);
  }

  .kpi:hover {
    border-color: var(--color-signal);
  }

  /* Card is being swapped by heroKpis.ts */
  .kpi.is-leaving {
    opacity: 0;
    filter: blur(4px);
    translate: 0 -10px;
  }

  .kpi.is-entering {
    opacity: 0;
    filter: blur(4px);
    translate: 0 10px;
    transition: none;
  }

  .kpi__label {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .kpi__value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .kpi__value :global(s) {
    margin-right: 0.35rem;
    color: var(--color-faint);
    font-size: 0.8rem;
    text-decoration-color: var(--color-signal);
  }

  .kpi__note {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .kpi__note.up {
    color: var(--color-up);
  }

  .kpi--0 {
    top: 14%;
    left: -4%;
  }

  .kpi--1 {
    top: 44%;
    right: -4%;
    animation-delay: -2.5s;
  }

  .kpi--2 {
    bottom: 8%;
    left: 2%;
    animation-delay: -4.5s;
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 520px) {
    .kpi {
      min-width: 0;
      padding: 0.55rem 0.7rem;
    }

    .kpi__value {
      font-size: 1.05rem;
    }

    .kpi--0 {
      left: 0;
    }

    .kpi--1 {
      right: 0;
    }

    .kpi--2 {
      display: none;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Proof strip */
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 860px) {
    .proof {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .proof__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem 0 0;
  }

  .proof__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .proof__value .num {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    line-height: 1;
  }

  .proof__suffix {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .proof__label {
    max-width: 15rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }
</style>
