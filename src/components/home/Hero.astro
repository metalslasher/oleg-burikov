---
import { proofStats } from '../../data/profile';
import { siteConfig } from '../../config/site';
import Icon from '../Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg grid-bg" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>
        {siteConfig.jobTitle}<span class="hero__loc"> · Київ / remote</span>
      </p>

      <h1 id="hero-title" class="hero__title display">
        <span class="hero__line">Реклама, що приносить</span>
        <span class="hero__line"><em>клієнтів</em>, а не кліки</span>
      </h1>

      <p class="hero__lead lead">
        Я Олег Буріков. 6+ років будую системи залучення під ключ: Google, Meta і TikTok Ads, аналітика, воронка та
        звітність, у якій видно ціну клієнта — а не лише ціну кліка.
      </p>

      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary" data-gtm-event="cta_click" data-gtm-label="hero_primary" data-gtm-location="home_hero">
          Обговорити проєкт
          <Icon name="arrow-up-right" />
        </a>
        <a href="/cases" class="btn btn--ghost" data-gtm-event="cta_click" data-gtm-label="hero_secondary_cases" data-gtm-location="home_hero">
          Дивитися кейси
        </a>
      </div>

      <a href="/about" class="hero__hire" data-gtm-event="cta_click" data-gtm-label="hero_hire" data-gtm-location="home_hero">
        Шукаєте performance-маркетолога в команду? <span>Резюме і досвід</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="hero__visual">
      <div class="hero__ring" aria-hidden="true"></div>
      <img
        class="hero__photo"
        src="/images/oleg-burikov-hero-cutout.webp"
        alt="Олег Буріков, performance-маркетолог"
        width="1189"
        height="1058"
        fetchpriority="high"
        decoding="async"
      />

      <a href="/cases/b2b-saas-google-ads" class="kpi kpi--a" aria-label="Кейс B2B SaaS: CPL знизився з $1 130 до $144">
        <span class="kpi__label">CPL · B2B SaaS, США</span>
        <span class="kpi__value"><s>$1 130</s> $144</span>
        <span class="kpi__delta up">▼ 87%</span>
      </a>
      <a href="/cases/jewelry-ecommerce-google-meta-ads" class="kpi kpi--b" aria-label="Кейс ювелірного магазину: ROAS 8,46">
        <span class="kpi__label">ROAS · eCommerce</span>
        <span class="kpi__value">8,46</span>
        <svg class="kpi__spark" viewBox="0 0 120 32" aria-hidden="true">
          <polyline points="0,28 18,26 34,27 50,20 66,22 82,12 98,9 120,3" />
        </svg>
      </a>
      <a href="/cases/real-estate-kyiv-meta-ads" class="kpi kpi--c" aria-label="Кейс нерухомості: 865 лідів">
        <span class="kpi__label">Ліди · нерухомість</span>
        <span class="kpi__value">865</span>
        <span class="kpi__delta">по $13,75</span>
      </a>
    </div>
  </div>

  <div class="wrap">
    <dl class="proof">
      {proofStats.map((stat, index) => (
        <div class="proof__item" data-reveal style={`--reveal-i:${index}`}>
          <dt class="proof__label">{stat.label}</dt>
          <dd class="proof__value">
            <span class="num" data-count>{stat.value}</span>
            <span class="proof__suffix">{stat.suffix}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 4.5rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 35%, #000 20%, transparent 75%);
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    top: 8%;
    right: -10%;
    width: min(60vw, 46rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 90 31 / 0.32), rgb(255 90 31 / 0.06) 45%, transparent 70%);
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      gap: 2rem;
    }
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-up);
    box-shadow: 0 0 0 0 rgb(61 220 151 / 0.6);
    animation: live 2.2s infinite;
  }

  @keyframes live {
    70% {
      box-shadow: 0 0 0 8px rgb(61 220 151 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(61 220 151 / 0);
    }
  }

  @media (max-width: 420px) {
    .hero__loc {
      display: none;
    }
  }

  .hero__title {
    margin-top: 1.5rem;
    font-size: clamp(2.35rem, 1.2rem + 5.2vw, 5.1rem);
    line-height: 1.02;
  }

  .hero__line {
    display: block;
  }

  .js .hero__line {
    animation: rise 900ms var(--ease-out) both;
  }

  .js .hero__line:nth-child(2) {
    animation-delay: 120ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(6px);
    }
  }

  .hero__lead {
    max-width: 36rem;
    margin-top: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__hire {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin-top: 1.75rem;
    color: var(--color-faint);
    font-size: 0.9rem;
  }

  .hero__hire span {
    color: var(--color-paper);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }

  .hero__hire:hover span {
    text-decoration-color: var(--color-signal);
  }

  .hero__hire svg {
    color: var(--color-signal);
    transition: transform 200ms var(--ease-out);
  }

  .hero__hire:hover svg {
    transform: translateX(3px);
  }

  /* Portrait composition */
  .hero__visual {
    position: relative;
    width: min(100%, 30rem);
    margin-inline: auto;
    aspect-ratio: 1189 / 1058;
  }

  .hero__ring {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 78%;
    aspect-ratio: 1;
    border: 1px dashed rgb(255 255 255 / 0.14);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: spin 60s linear infinite;
  }

  .hero__ring::after {
    content: "";
    position: absolute;
    top: 12%;
    right: 9%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 18px var(--color-signal);
  }

  @keyframes spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .hero__photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
  }

  .kpi {
    position: absolute;
    display: grid;
    gap: 0.15rem;
    min-width: 9.5rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: rgb(16 18 22 / 0.92);

    box-shadow: 0 20px 50px rgb(0 0 0 / 0.45);
    animation: float 7s ease-in-out infinite;
    transition: border-color 200ms ease;
  }

  .kpi:hover {
    border-color: var(--color-signal);
  }

  .kpi__label {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .kpi__value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .kpi__value s {
    margin-right: 0.3rem;
    color: var(--color-faint);
    font-size: 0.8rem;
    text-decoration-color: var(--color-signal);
  }

  .kpi__delta {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .kpi__delta.up {
    color: var(--color-up);
  }

  .kpi__spark {
    width: 100%;
    height: 1.4rem;
    margin-top: 0.2rem;
  }

  .kpi__spark polyline {
    fill: none;
    stroke: var(--color-up);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: draw 1.6s 600ms var(--ease-out) forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .kpi--a {
    top: 14%;
    left: -4%;
  }

  .kpi--b {
    top: 42%;
    right: -4%;
    animation-delay: -2.5s;
  }

  .kpi--c {
    bottom: 10%;
    left: 2%;
    animation-delay: -4.5s;
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 520px) {
    .kpi {
      min-width: 0;
      padding: 0.55rem 0.7rem;
    }

    .kpi__value {
      font-size: 1.05rem;
    }

    .kpi--a {
      left: 0;
    }

    .kpi--b {
      right: 0;
    }

    .kpi--c {
      display: none;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Proof strip */
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 860px) {
    .proof {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .proof__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem 0 0;
  }

  .proof__value {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .proof__value .num {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    line-height: 1;
  }

  .proof__suffix {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .proof__label {
    max-width: 15rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }
</style>
