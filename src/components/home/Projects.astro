---
import { projects, showProjects } from '../../data/projects';
import { pad2 } from '../../lib/text';
import Icon from '../Icon.astro';

interface Props {
  /** Section number shown in the kicker, e.g. "03". */
  num: string;
}

const { num } = Astro.props;
---

{showProjects && (
  <section id="projects" class="section" aria-labelledby="projects-title" data-gtm-section="home_projects">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="kicker"><b>{num}</b> Власні проєкти</p>
          <h2 id="projects-title" class="h2" style="margin-top:1rem">Що я будую <em>сам</em></h2>
        </div>
        <p class="lead">
          Окрім клієнтської роботи, запускаю власні проєкти з нуля: від ідеї й сайту до аналітики та перших відвідувачів.
          Так я краще розумію продукт і юніт-економіку з боку власника.
        </p>
      </div>

      <div class="projects">
        {projects.map((project, index) => (
          <article class="project" data-reveal data-spotlight style={`--reveal-i:${index}`}>
            <div class="project__top">
              <span class="project__index">{pad2(index + 1)}</span>
              <span class="chip chip--mono">{project.kind}</span>
            </div>
            <h3 class="project__title">{project.title}</h3>
            <p class="project__text">{project.text}</p>

            <div class="project__scope">
              {project.scope.map((item) => <span><Icon name="check" size={14} />{item}</span>)}
            </div>

            <div class="project__foot">
              {project.result ? (
                <p class="project__result">
                  <b class="num">{project.result.value}</b>
                  <small>{project.result.label}</small>
                </p>
              ) : <span />}
              <ul class="project__stack">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
            </div>

            {project.url && (
              <a href={project.url} class="project__link" target="_blank" rel="noopener noreferrer" aria-label={`Відкрити ${project.title}`}>
                <Icon name="arrow-up-right" size={18} />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .projects {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .projects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--color-ink-2);
    overflow: hidden;
    transition: border-color 300ms ease, transform 400ms var(--ease-out);
  }

  .project::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), rgb(255 90 31 / 0.12), transparent 55%);
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  .project:hover {
    border-color: rgb(255 90 31 / 0.45);
  }

  .project:hover::before {
    opacity: 1;
  }

  .project__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project__index {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .project__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .project__text {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .project__scope {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .project__scope span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .project__scope :global(svg) {
    color: var(--color-signal);
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .project__result b {
    display: block;
    font-size: 1.6rem;
    line-height: 1.05;
  }

  .project__result small {
    color: var(--color-faint);
    font-size: 0.8rem;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .project__stack li + li::before {
    content: "· ";
  }

  .project__link {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
  }
</style>
