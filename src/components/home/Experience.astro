---
import { roles, niches } from '../../data/profile';
import Icon from '../Icon.astro';
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div>
        <p class="kicker"><b>05</b> Досвід</p>
        <h2 id="experience-title" class="h2" style="margin-top:1rem">Від media buying до <em>growth-систем</em></h2>
      </div>
      <p class="lead">
        Агенції, in-house команди й affiliate: США, Канада, Європа, Україна. Кожна роль додала окремий шар — від креативних
        тестів і Amazon до B2B-аналітики та роботи з CRM.
      </p>
    </div>

    <ol class="timeline">
      {roles.map((role, index) => (
        <li class="timeline__item" data-reveal style={`--reveal-i:${index}`}>
          <span class="timeline__years">{role.years}</span>
          <div class="timeline__company">
            <img src={role.logo} alt="" width="44" height="44" loading="lazy" decoding="async" />
            <div>
              <h3>{role.company}</h3>
              <p>{role.role}</p>
            </div>
          </div>
          <p class="timeline__summary">{role.summary}</p>
          <ul class="timeline__tags">
            {role.tags.slice(0, 3).map((tag) => <li class="chip chip--mono">{tag}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <div class="niches" data-reveal>
      <p class="niches__title">Ніші, з якими працював</p>
      <ul>
        {niches.map((niche) => <li class="chip">{niche}</li>)}
      </ul>
    </div>

    <a href="/about" class="link-arrow" style="margin-top:2rem" data-gtm-event="cta_click" data-gtm-label="experience_about" data-gtm-location="home_experience">
      Детальніше про досвід і навички <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>

<style>
  .timeline {
    border-top: 1px solid var(--line);
  }

  .timeline__item {
    display: grid;
    gap: 0.75rem 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .timeline__item {
      grid-template-columns: 9rem minmax(0, 1fr) minmax(0, 1.3fr) 13rem;
      align-items: center;
    }
  }

  .timeline__years {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .timeline__company {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .timeline__company img {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: #fff;
    object-fit: cover;
  }

  .timeline__company h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .timeline__company p {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .timeline__summary {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  @media (min-width: 900px) {
    .timeline__tags {
      justify-content: flex-end;
    }
  }

  .niches {
    margin-top: 3rem;
  }

  .niches__title {
    margin-bottom: 1rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .niches ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .niches .chip {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .niches .chip:hover {
    border-color: var(--color-signal);
  }
</style>
