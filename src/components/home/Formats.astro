---
import { businessFormats, teamOffer } from '../../data/profile';
import Icon from '../Icon.astro';
import { siteConfig } from '../../config/site';

interface Props {
  /** Section number shown in the kicker, e.g. "03". */
  num: string;
}

const { num } = Astro.props;
---

<section id="formats" class="section" aria-labelledby="formats-title" data-gtm-section="home_formats">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker"><b>{num}</b> Формати співпраці</p>
      <h2 id="formats-title" class="h2">Як можемо <em>працювати</em></h2>
    </div>

    <div class="formats">
      {businessFormats.map((format, index) => (
        <article class="format" data-reveal style={`--reveal-i:${index}`}>
          <div class="format__head">
            <h3>{format.title}</h3>
            <span class="chip chip--mono">{format.duration}</span>
          </div>
          <p class="format__text">{format.text}</p>
          <ul class="format__points">
            {format.points.map((point) => (
              <li><Icon name="check" size={16} />{point}</li>
            ))}
          </ul>
          <a
            href="#contact"
            class="link-arrow format__link"
            data-contact-service={index === 0 ? 'Аудит' : 'Реклама під ключ'}
            data-gtm-event="cta_click"
            data-gtm-label={`format_${index + 1}`}
            data-gtm-location="home_formats"
          >
            Обговорити <Icon name="arrow-right" size={16} />
          </a>
        </article>
      ))}

      <article class="team" data-reveal>
        <p class="team__kicker">Для команд і роботодавців</p>
        <h3 class="team__title">Шукаєте performance-маркетолога в команду?</h3>
        <p class="team__text">{teamOffer.text}</p>
        <dl class="team__facts">
          {teamOffer.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <div class="team__actions">
          <a href="/about" class="btn btn--dark" data-gtm-event="cta_click" data-gtm-label="team_cv" data-gtm-location="home_formats">
            Резюме і досвід <Icon name="arrow-right" />
          </a>
          <a
            href="#contact"
            class="btn btn--outline-dark"
            data-contact-service="Вакансія / робота в команді"
            data-gtm-event="cta_click"
            data-gtm-label="team_contact"
            data-gtm-location="home_formats"
          >
            Запропонувати роль
          </a>
          <a href={siteConfig.social.djinni} target="_blank" rel="noopener noreferrer" class="team__djinni" data-gtm-event="social_click" data-gtm-label="djinni" data-gtm-location="home_formats">
            Профіль на Djinni <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .formats {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 760px) {
    .formats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .team {
      grid-column: 1 / -1;
    }
  }

  .format {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--color-ink-2);
  }

  .format__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .format h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .format__text {
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  .format__points {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.93rem;
  }

  .format__points li {
    display: flex;
    gap: 0.55rem;
  }

  .format__points svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--color-signal);
  }

  .format__link {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Inverted card: stands out for the second audience */
  .team {
    display: grid;
    gap: 1.25rem 3rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: calc(var(--radius) * 1.4);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  @media (min-width: 960px) {
    .team {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas:
        "kicker facts"
        "title facts"
        "text facts"
        "actions facts";
    }

    .team__kicker { grid-area: kicker; }
    .team__title { grid-area: title; }
    .team__text { grid-area: text; }
    .team__actions { grid-area: actions; }
    .team__facts { grid-area: facts; align-self: center; }
  }

  .team__kicker {
    color: #b53a0c;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .team__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .team__text {
    color: #3c3d42;
  }

  .team__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgb(10 11 13 / 0.12);
    border-radius: var(--radius);
    background: rgb(10 11 13 / 0.12);
  }

  .team__facts div {
    padding: 1rem 1.1rem;
    background: var(--color-paper);
  }

  .team__facts dt {
    color: #6b6c72;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .team__facts dd {
    margin-top: 0.3rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .team__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .team__djinni {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.5rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgb(10 11 13 / 0.3);
    text-underline-offset: 0.3em;
  }

  .team__djinni:hover {
    text-decoration-color: var(--color-ink);
  }

  .btn--dark {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn--dark:hover {
    background: #26282e;
  }

  .btn--outline-dark {
    border-color: rgb(10 11 13 / 0.25);
    color: var(--color-ink);
  }

  .btn--outline-dark:hover {
    border-color: var(--color-ink);
  }

  .team :focus-visible {
    outline-color: var(--color-ink);
  }
</style>
