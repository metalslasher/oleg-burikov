---
import content from '../content/home-uk.json';

const { cases } = content;
const featuredCount = cases.featuredCount || 4;
const featuredCases = cases.items.slice(0, featuredCount);
---

<section id="cases" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
            Кейси
          </p>
          <h2 class="text-fluid-4xl font-bold leading-tight text-white">
            {cases.title}
          </h2>
        </div>
        <p class="text-fluid-lg leading-relaxed text-gray-400">
          {cases.subtitle}
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {featuredCases.map((caseItem, index) => {
          const caseSlug = `case-${index + 1}`;

          return (
            <a
              href={`/cases/${caseSlug}`}
              class="case-card group"
              data-case-card
            >
              <div class="case-card__head">
                <span>{caseItem.industry}</span>
                <svg class="h-5 w-5 text-gray-500 transition-all group-hover:translate-x-1 group-hover:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </div>

              <h3>{caseItem.client}</h3>

              <div class="case-card__body">
                <div>
                  <p class="case-card__label">Задача</p>
                  <p>{caseItem.challenge}</p>
                </div>
                <div>
                  <p class="case-card__label">Що зроблено</p>
                  <p>{caseItem.solution}</p>
                </div>
              </div>

              <div class="case-card__results">
                {caseItem.results.map((result: { value: string; metric: string; description?: string }) => (
                  <div>
                    <strong>{result.value}</strong>
                    <span>{result.metric}</span>
                    {result.description && <small>{result.description}</small>}
                  </div>
                ))}
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/cases"
          data-gtm-event="cta_click"
          data-gtm-label="cases_all"
          data-gtm-location="home_cases"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/5 px-6 py-3 font-bold text-white transition-colors hover:border-accent-400/60 hover:bg-white/10"
        >
          Переглянути всі кейси
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .case-card {
    display: flex;
    min-height: 24rem;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 1.25rem;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  @media (min-width: 768px) {
    .case-card {
      padding: 1.5rem;
    }
  }

  .case-card:hover {
    transform: translateY(-2px);
    border-color: rgba(249, 115, 22, 0.42);
    background: rgba(255, 255, 255, 0.065);
  }

  .case-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .case-card__head span {
    display: inline-flex;
    border-radius: 0.45rem;
    background: rgba(249, 115, 22, 0.14);
    padding: 0.35rem 0.65rem;
    color: rgb(253 186 116);
    font-size: 0.78rem;
    font-weight: 820;
  }

  .case-card h3 {
    color: white;
    font-size: clamp(1.35rem, 1.15rem + 0.65vw, 1.85rem);
    font-weight: 850;
    line-height: 1.15;
  }

  .case-card__body {
    display: grid;
    gap: 1rem;
    margin-top: 1.35rem;
  }

  .case-card__body p:not(.case-card__label) {
    color: rgb(156 163 175);
    line-height: 1.58;
  }

  .case-card__label {
    margin-bottom: 0.35rem;
    color: rgb(107 114 128);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .case-card__results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: auto;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.1);
  }

  .case-card__results div {
    background: rgba(2, 6, 23, 0.5);
    padding: 0.95rem;
  }

  .case-card__results strong {
    display: block;
    color: rgb(251 146 60);
    font-size: clamp(1.4rem, 1.15rem + 0.9vw, 2rem);
    font-weight: 950;
    line-height: 1;
  }

  .case-card__results span {
    display: block;
    margin-top: 0.35rem;
    color: rgb(229 231 235);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .case-card__results small {
    display: block;
    margin-top: 0.15rem;
    color: rgb(107 114 128);
    font-size: 0.76rem;
    line-height: 1.35;
  }
</style>
