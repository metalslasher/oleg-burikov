---
import content from '../content/home-uk.json';

const nonce = Astro.locals.cspNonce;
const { cases } = content;

const caseSlides = cases.items.map((caseItem, index) => ({
  ...caseItem,
  slug: `case-${index + 1}`,
}));

const loopedCases = [0, 1, 2].flatMap((setIndex) =>
  caseSlides.map((caseItem) => ({
    ...caseItem,
    setIndex,
    isPrimary: setIndex === 1,
  })),
);
---

<section id="cases" class="py-16 md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
          Кейси
        </p>
        <h2 class="text-fluid-4xl font-bold leading-tight text-white">
          Результати моїх проєктів
        </h2>
      </div>

      <div class="case-carousel" data-case-carousel aria-label="Кейси та результати">
        <div class="case-carousel__viewport" data-case-viewport tabindex="0">
          <div class="case-carousel__track" data-case-track>
            {loopedCases.map((caseItem, index) => {
              const isDuplicate = !caseItem.isPrimary;
              const displayIndex = (index % caseSlides.length) + 1;

              return (
                <a
                  href={`/cases/${caseItem.slug}`}
                  class="case-card group"
                  data-case-card
                  aria-hidden={isDuplicate ? 'true' : undefined}
                  tabindex={isDuplicate ? -1 : undefined}
                >
                  <div class="case-card__head">
                    <span>{caseItem.industry}</span>
                    <small>{String(displayIndex).padStart(2, '0')}</small>
                  </div>

                  <h3>{caseItem.client}</h3>

                  <div class="case-card__results">
                    {caseItem.results.slice(0, 2).map((result: { value: string; metric: string; description?: string }) => (
                      <div>
                        <strong>{result.value}</strong>
                        <span>{result.metric}</span>
                        {result.description && <small>{result.description}</small>}
                      </div>
                    ))}
                  </div>

                  <div class="case-card__action">
                    <span>Детальніше</span>
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline nonce={nonce}>
  (() => {
  const initCaseCarousel = () => {
    if (document.querySelector('[data-case-carousel][data-carousel-ready="true"]')) return;

    const carousel = document.querySelector('[data-case-carousel]');
    const viewport = document.querySelector('[data-case-viewport]');
    const track = document.querySelector('[data-case-track]');

    if (!carousel || !viewport || !track) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let loopWidth = 0;
    let autoTimer = 0;
    let isPaused = false;
    let pauseTimer = 0;
    let lastTimestamp = Date.now();

    const measure = () => {
      loopWidth = track.scrollWidth / 3;
      if (loopWidth > 0 && viewport.scrollLeft < 1) {
        viewport.scrollLeft = loopWidth;
      }
    };

    const normalizeScroll = () => {
      if (!loopWidth) return;

      if (viewport.scrollLeft >= loopWidth * 2) {
        viewport.scrollLeft -= loopWidth;
      }

      if (viewport.scrollLeft <= 0) {
        viewport.scrollLeft += loopWidth;
      }
    };

    const step = () => {
      const timestamp = Date.now();
      const delta = timestamp - lastTimestamp;
      lastTimestamp = timestamp;

      if (!isPaused && !document.hidden && !reducedMotion.matches) {
        viewport.scrollLeft += delta * 0.035;
        normalizeScroll();
      }
    };

    const pauseTemporarily = (duration = 1600) => {
      isPaused = true;
      window.clearTimeout(pauseTimer);
      pauseTimer = window.setTimeout(() => {
        isPaused = false;
      }, duration);
    };

    measure();
    autoTimer = window.setInterval(step, 16);

    viewport.addEventListener('scroll', normalizeScroll, { passive: true });
    window.addEventListener('resize', measure);

    carousel.addEventListener('focusin', () => {
      isPaused = true;
    });

    carousel.addEventListener('focusout', () => {
      isPaused = false;
    });

    carousel.addEventListener('wheel', () => {
      pauseTemporarily();
    }, { passive: true });

    carousel.addEventListener('pointerdown', () => {
      pauseTemporarily();
    });

    carousel.addEventListener('touchstart', () => {
      pauseTemporarily();
    }, { passive: true });

    carousel.addEventListener('touchend', () => {
      pauseTemporarily();
    }, { passive: true });

    window.addEventListener('pagehide', () => {
      window.clearTimeout(pauseTimer);
      window.clearInterval(autoTimer);
    });

    carousel.setAttribute('data-carousel-ready', 'true');
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaseCarousel, { once: true });
  } else {
    initCaseCarousel();
  }
  })();
</script>

<style>
  .case-carousel {
    position: relative;
    margin-top: clamp(2rem, 4vw, 3.25rem);
  }

  .case-carousel__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .case-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .case-carousel__track {
    display: flex;
    width: max-content;
    gap: 1rem;
    padding: 0.25rem 0.25rem 0.5rem;
  }

  .case-card {
    display: flex;
    flex: 0 0 min(85vw, 25.5rem);
    min-height: 20rem;
    flex-direction: column;
    border: 1px solid rgb(255 255 255 / 0.11);
    border-radius: 0.65rem;
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.075), rgb(255 255 255 / 0.025)),
      rgb(2 6 23 / 0.36);
    padding: 1.1rem;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  @media (min-width: 768px) {
    .case-carousel__track {
      gap: 1.25rem;
    }

    .case-card {
      flex-basis: clamp(23rem, 31vw, 28rem);
      min-height: 21.5rem;
      padding: 1.35rem;
    }
  }

  .case-card:hover {
    transform: translateY(-2px);
    border-color: rgb(249 115 22 / 0.45);
    background:
      linear-gradient(145deg, rgb(249 115 22 / 0.1), rgb(255 255 255 / 0.035)),
      rgb(2 6 23 / 0.44);
  }

  .case-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .case-card__head span {
    display: inline-flex;
    border-radius: 0.45rem;
    background: rgb(249 115 22 / 0.14);
    padding: 0.35rem 0.65rem;
    color: rgb(253 186 116);
    font-size: 0.78rem;
    font-weight: 820;
  }

  .case-card__head small {
    color: rgb(255 255 255 / 0.25);
    font-size: 0.85rem;
    font-weight: 850;
  }

  .case-card h3 {
    color: white;
    font-size: clamp(1.3rem, 1.12rem + 0.55vw, 1.72rem);
    font-weight: 850;
    line-height: 1.14;
  }

  .case-card__results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 1.35rem;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 0.55rem;
    background: rgb(255 255 255 / 0.11);
  }

  .case-card__results div {
    min-width: 0;
    background: rgb(2 6 23 / 0.56);
    padding: 0.9rem;
  }

  .case-card__results strong {
    display: block;
    color: rgb(251 146 60);
    font-size: clamp(1.35rem, 1.05rem + 0.8vw, 1.9rem);
    font-weight: 950;
    line-height: 1;
  }

  .case-card__results span {
    display: block;
    margin-top: 0.35rem;
    color: rgb(229 231 235);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .case-card__results small {
    display: block;
    margin-top: 0.15rem;
    color: rgb(107 114 128);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .case-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.25rem;
    color: rgb(253 186 116);
    font-weight: 850;
  }

  @media (max-width: 639px) {
    .case-card {
      min-height: 19.5rem;
    }
  }
</style>
