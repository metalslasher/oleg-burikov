---
import content from '../content/home-uk.json';

const { cases } = content;
---

<section id="cases" class="py-20 md:py-28">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <p class="text-fluid-sm font-semibold tracking-[0.18em] text-accent-400 uppercase mb-3">
        Портфоліо
      </p>
      <h2 class="text-fluid-4xl font-bold text-white mb-4">
        {cases.title}
      </h2>
      <p class="text-fluid-lg text-gray-400">
        {cases.subtitle}
      </p>
    </div>

    <!-- Cases Bento Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-7xl mx-auto">
      {cases.items.map((caseItem, index) => {
        const span = index === 0 ? 'md:col-span-2 lg:col-span-2' : 
                     index === 2 ? 'md:col-span-1 lg:col-span-2' :
                     index === 3 ? 'md:col-span-2 lg:col-span-1' :
                     index === 4 ? 'md:col-span-1 lg:col-span-2' : 'md:col-span-1';
        const caseSlug = `case-${index + 1}`;
        
        return (
        <a
          href={`/cases/${caseSlug}`}
          class={`group relative overflow-hidden rounded-3xl bg-white/5 border border-white/10 ${span} p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300 hover:-translate-y-2 block cursor-pointer`}
        >
          <!-- Card Header -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-500/20 text-xs font-semibold text-accent-400">
                {caseItem.industry}
              </div>
              <svg class="w-5 h-5 text-gray-500 group-hover:text-accent-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-2 group-hover:text-accent-400 transition-colors">
              {caseItem.client}
            </h3>
          </div>

          <!-- Challenge & Solution -->
          <div class="space-y-4 mb-6">
            <div>
              <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Завдання</p>
              <p class="text-sm text-gray-300 leading-relaxed">{caseItem.challenge}</p>
            </div>
            <div>
              <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Рішення</p>
              <p class="text-sm text-gray-300 leading-relaxed">{caseItem.solution}</p>
            </div>
          </div>

          <!-- Results - Highlight -->
          <div class="border-t-2 border-white/10 pt-6">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Результати</p>
            <div class="grid grid-cols-2 gap-4">
              {caseItem.results.map((result: { value: string; metric: string; description?: string; period?: string }) => (
                <div class="relative">
                  <div class="text-3xl md:text-4xl font-black text-accent-400">
                    {result.value}
                  </div>
                  <div class="text-xs text-gray-400 mt-1 font-medium">
                    {result.metric}
                  </div>
                  {(result.period || result.description) && (
                    <div class="text-xs text-gray-500 mt-0.5">
                      {result.period || result.description}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </a>
        );
      })}
    </div>
  </div>
</section>
