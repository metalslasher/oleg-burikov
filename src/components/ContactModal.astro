---
import content from '../content/home-uk.json';
import SocialLinks from './SocialLinks.astro';

const { cta } = content;
---

<dialog
  id="contact-modal"
  class="contact-modal"
  aria-labelledby="contact-modal-title"
>
  <div class="contact-modal__panel">
    <button
      type="button"
      class="contact-modal__close"
      aria-label="Закрити форму"
      data-contact-modal-close
    >
      <span aria-hidden="true">&times;</span>
    </button>

    <header class="contact-modal__header">
      <h2 id="contact-modal-title">Зв'язатися зі мною</h2>
    </header>

    <form id="contact-form" data-gtm-event="lead_submit" novalidate>
      <div class="contact-modal__fields">
        <div class="contact-modal__field">
          <label for="contact-name">
            {cta.form.fields.name.label} <span>*</span>
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            autocomplete="name"
            required
            placeholder={cta.form.fields.name.placeholder}
          />
          <p class="error-message hidden"></p>
        </div>

        <div class="contact-modal__field">
          <label for="contact-phone">
            {cta.form.fields.phone.label} <span>*</span>
          </label>
          <input
            type="tel"
            id="contact-phone"
            name="phone"
            autocomplete="tel"
            required
            placeholder={cta.form.fields.phone.placeholder}
          />
          <p class="error-message hidden"></p>
        </div>

        <div class="contact-modal__field contact-modal__field--full">
          <label for="contact-method">
            {cta.form.fields.contact_method.label} <span>*</span>
          </label>
          <select
            id="contact-method"
            name="contact_method"
            autocomplete="off"
            required
          >
            <option value="">{cta.form.fields.contact_method.placeholder}</option>
            {cta.form.fields.contact_method.options?.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
          <p class="error-message hidden"></p>
        </div>

        <div class="contact-modal__field contact-modal__field--full">
          <label for="contact-message">{cta.form.fields.message.label}</label>
          <textarea
            id="contact-message"
            name="message"
            autocomplete="off"
            rows="3"
            placeholder={cta.form.fields.message.placeholder}
          ></textarea>
          <p class="error-message hidden"></p>
        </div>
      </div>

      <button type="submit" id="submit-btn">
        <span id="submit-text">{cta.form.submit}</span>
      </button>
    </form>

    <div class="contact-modal__socials">
      <span>Або напишіть напряму</span>
      <SocialLinks location="contact_modal" />
    </div>
  </div>
</dialog>

<style>
  :global(html.contact-modal-is-open) {
    overflow: hidden;
  }

  .contact-modal {
    width: min(46rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: visible;
    border: 0;
    background: transparent;
    padding: 0;
    color: white;
  }

  .contact-modal::backdrop {
    background: rgb(2 6 23 / 0.78);
    backdrop-filter: blur(12px);
  }

  .contact-modal[open] {
    animation: modal-fade-in 180ms ease-out;
  }

  .contact-modal__panel {
    position: relative;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.7rem;
    background:
      linear-gradient(145deg, rgb(249 115 22 / 0.08), transparent 34%),
      rgb(9 15 29);
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.55);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    scrollbar-width: thin;
    scrollbar-color: rgb(249 115 22 / 0.6) transparent;
  }

  .contact-modal__close {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.55rem;
    background: rgb(255 255 255 / 0.045);
    color: rgb(209 213 219);
    font-size: 1.75rem;
    line-height: 1;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .contact-modal__close:hover {
    border-color: rgb(249 115 22 / 0.55);
    background: rgb(249 115 22 / 0.12);
    color: white;
  }

  .contact-modal__close:focus-visible {
    outline: 2px solid rgb(251 146 60);
    outline-offset: 3px;
  }

  .contact-modal__header {
    padding-right: 3.5rem;
  }

  .contact-modal__header h2 {
    color: rgb(251 146 60);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #contact-form {
    margin-top: 1.35rem;
  }

  .contact-modal__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-modal__field {
    min-width: 0;
  }

  .contact-modal__field--full {
    grid-column: 1 / -1;
  }

  .contact-modal__field label {
    display: block;
    margin-bottom: 0.4rem;
    color: rgb(229 231 235);
    font-size: 0.86rem;
    font-weight: 760;
  }

  .contact-modal__field label span {
    color: rgb(251 146 60);
  }

  .contact-modal__field input,
  .contact-modal__field select,
  .contact-modal__field textarea {
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.55rem;
    background: rgb(2 6 23 / 0.58);
    padding: 0.78rem 0.9rem;
    color: white;
    font-size: 0.94rem;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .contact-modal__field input,
  .contact-modal__field select {
    min-height: 3rem;
  }

  .contact-modal__field textarea {
    min-height: 5.5rem;
    resize: vertical;
  }

  .contact-modal__field input::placeholder,
  .contact-modal__field textarea::placeholder {
    color: rgb(107 114 128);
  }

  .contact-modal__field select option {
    background: rgb(15 23 42);
    color: white;
  }

  .contact-modal__field input:focus,
  .contact-modal__field select:focus,
  .contact-modal__field textarea:focus {
    border-color: rgb(249 115 22 / 0.75);
    box-shadow: 0 0 0 3px rgb(249 115 22 / 0.16);
    outline: none;
  }

  .error-message {
    margin-top: 0.35rem;
    color: rgb(253 186 116);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  #contact-form button[type='submit'] {
    display: inline-flex;
    width: 100%;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    border-radius: 0.55rem;
    background: rgb(249 115 22);
    color: white;
    font-size: 0.95rem;
    font-weight: 850;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  #contact-form button[type='submit']:hover {
    background: rgb(251 146 60);
    transform: translateY(-1px);
  }

  #contact-form button[type='submit']:focus-visible {
    outline: 2px solid rgb(255 237 213);
    outline-offset: 3px;
  }

  .contact-modal__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1rem;
    margin-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.09);
    padding-top: 1rem;
  }

  .contact-modal__socials > span {
    color: rgb(156 163 175);
    font-size: 0.84rem;
    font-weight: 700;
  }

  @media (max-width: 639px) {
    .contact-modal {
      width: calc(100% - 1rem);
      max-height: calc(100dvh - 1rem);
    }

    .contact-modal__panel {
      max-height: calc(100dvh - 1rem);
      padding: 1.15rem;
    }

    .contact-modal__close {
      top: 0.75rem;
      right: 0.75rem;
    }

    .contact-modal__header {
      padding-right: 2.8rem;
    }

    .contact-modal__fields {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .contact-modal__field--full {
      grid-column: auto;
    }

    .contact-modal__socials {
      justify-content: center;
      text-align: center;
    }

    .contact-modal__socials > span {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-modal[open] {
      animation: none;
    }

    .contact-modal__close,
    #contact-form button[type='submit'] {
      transition: none;
    }
  }

  @keyframes modal-fade-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
