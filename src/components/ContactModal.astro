---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';

const requestTypes = ['Реклама під ключ', 'Аудит', 'Вакансія / робота в команді', 'Інше'];
---

<dialog id="contact-modal" class="modal" aria-labelledby="contact-modal-title">
  <div class="modal__panel">
    <button type="button" class="modal__close" aria-label="Закрити форму" data-modal-close>
      <Icon name="close" size={20} />
    </button>

    <div class="modal__form-view" data-form-view>
      <p class="kicker"><b>●</b> Відповідаю протягом робочого дня</p>
      <h2 id="contact-modal-title" class="modal__title">Обговорімо задачу</h2>

      <form id="contact-form" class="form" novalidate data-lead-form>
        <fieldset class="form__types">
          <legend>Що вас цікавить?</legend>
          <div class="form__chips">
            {requestTypes.map((type, index) => (
              <label class="form__chip">
                <input type="radio" name="service" value={type} checked={index === 0} />
                <span>{type}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="form__row">
          <div class="form__field">
            <label for="lead-name">Ім’я <span aria-hidden="true">*</span></label>
            <input id="lead-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" placeholder="Як до вас звертатися" />
            <p class="form__error" data-error-for="name" aria-live="polite"></p>
          </div>
          <div class="form__field">
            <label for="lead-contact">Телефон, Telegram або email <span aria-hidden="true">*</span></label>
            <input id="lead-contact" name="contact" type="text" autocomplete="tel" required maxlength="120" placeholder="+380… / @username / mail@" />
            <p class="form__error" data-error-for="contact" aria-live="polite"></p>
          </div>
        </div>

        <div class="form__field">
          <label for="lead-message">Коротко про задачу</label>
          <textarea id="lead-message" name="message" rows="3" maxlength="1200" placeholder="Ніша, канали, бюджет, що зараз не влаштовує"></textarea>
        </div>

        <div class="form__hp" aria-hidden="true">
          <label for="lead-website">Website</label>
          <input id="lead-website" name="website_hp" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form__status" data-form-status role="status"></p>

        <button type="submit" class="btn btn--primary form__submit" data-submit>
          <span data-submit-label>Надіслати</span>
          <Icon name="arrow-up-right" />
        </button>
        <p class="form__legal">
          Надсилаючи форму, ви погоджуєтесь з <a href="/privacy">політикою конфіденційності</a>.
        </p>
      </form>
    </div>

    <div class="modal__success" data-success-view hidden>
      <div class="modal__success-icon"><Icon name="check" size={28} /></div>
      <h2 class="modal__title">Дякую, заявку отримав</h2>
      <p class="lead">Зв’яжуся з вами протягом робочого дня. Якщо питання термінове — напишіть у Telegram.</p>
      <a
        href={siteConfig.contact.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--ghost"
        data-gtm-event="messenger_click"
        data-gtm-label="telegram"
        data-gtm-location="contact_modal_success"
      >
        <Icon name="telegram" />
        {siteConfig.contact.telegramHandle}
      </a>
    </div>

    <div class="modal__direct">
      <a href={siteConfig.contact.telegram} target="_blank" rel="noopener noreferrer" data-gtm-event="messenger_click" data-gtm-label="telegram" data-gtm-location="contact_modal">
        <Icon name="telegram" size={16} /> Telegram
      </a>
      <a href={siteConfig.contact.calendly} target="_blank" rel="noopener noreferrer" data-gtm-event="book_call" data-gtm-label="calendly" data-gtm-location="contact_modal">
        <Icon name="calendar" size={16} /> Calendly
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" data-gtm-event="social_click" data-gtm-label="linkedin" data-gtm-location="contact_modal">
        <Icon name="linkedin" size={16} /> LinkedIn
      </a>
      <a href={`mailto:${siteConfig.contact.email}`} data-gtm-event="contact_click" data-gtm-label="email" data-gtm-location="contact_modal">
        <Icon name="email" size={16} /> Email
      </a>
    </div>
  </div>
</dialog>

<script>
  import { initContactModal } from '../scripts/contactModal';
  initContactModal();
</script>

<style>
  :global(html.modal-open) {
    overflow: hidden;
  }

  .modal {
    width: min(40rem, calc(100% - 1.5rem));
    max-width: none;
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-paper);
    overflow: visible;
  }

  .modal::backdrop {
    background: rgb(5 6 8 / 0.75);
    backdrop-filter: blur(8px);
  }

  .modal[open] {
    animation: modal-in 320ms var(--ease-out);
  }

  .modal__panel {
    position: relative;
    max-height: calc(100dvh - 1.5rem);
    overflow-y: auto;
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) * 1.3);
    background: var(--color-ink-2);
    box-shadow: 0 40px 120px rgb(0 0 0 / 0.6);
  }

  .modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--color-muted);
    transition: color 200ms ease, border-color 200ms ease;
  }

  .modal__close:hover {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  .modal .kicker {
    padding-right: 3rem;
  }

  .modal .kicker::before {
    display: none;
  }

  .modal__title {
    margin-top: 0.75rem;
    padding-right: 3rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .form__types {
    border: 0;
    padding: 0;
    margin: 0;
  }

  legend,
  .form__field label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .form__field label span {
    color: var(--color-signal);
  }

  .form__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .form__chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .form__chip span {
    display: inline-flex;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .form__chip:hover span {
    border-color: var(--color-paper);
  }

  .form__chip input:checked + span {
    border-color: var(--color-signal);
    background: rgb(255 90 31 / 0.14);
    color: #fff;
  }

  .form__chip input:focus-visible + span {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }

  .form__row {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 600px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form__field input,
  .form__field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 1rem;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .form__field textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .form__field input::placeholder,
  .form__field textarea::placeholder {
    color: var(--color-faint);
  }

  .form__field input:focus,
  .form__field textarea:focus {
    border-color: var(--color-signal);
    box-shadow: 0 0 0 3px rgb(255 90 31 / 0.18);
    outline: none;
  }

  .form__field input[aria-invalid='true'] {
    border-color: #ff6b6b;
  }

  .form__error {
    min-height: 0;
    margin-top: 0.35rem;
    color: #ff8a8a;
    font-size: 0.8rem;
  }

  .form__error:empty {
    display: none;
  }

  .form__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__status:empty {
    display: none;
  }

  .form__status {
    padding: 0.8rem 1rem;
    border: 1px solid rgb(255 107 107 / 0.35);
    border-radius: var(--radius-sm);
    background: rgb(255 107 107 / 0.08);
    color: #ffb3b3;
    font-size: 0.9rem;
  }

  .form__submit {
    width: 100%;
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .form__legal {
    color: var(--color-faint);
    font-size: 0.78rem;
    text-align: center;
  }

  .form__legal a {
    text-decoration: underline;
  }

  .modal__success {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-block: 1rem;
  }

  .modal__success[hidden] {
    display: none;
  }

  .modal__success-icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 50%;
    background: rgb(61 220 151 / 0.14);
    color: var(--color-up);
  }

  .modal__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
  }

  .modal__direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted);
    font-weight: 600;
    transition: color 200ms ease;
  }

  .modal__direct a:hover {
    color: var(--color-paper);
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
</style>
