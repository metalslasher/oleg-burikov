---
import content from '../content/home-uk.json';

const { testimonials } = content;
---

<section id="testimonials" class="py-20 md:py-28">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <p class="text-fluid-sm font-semibold tracking-[0.18em] text-accent-400 uppercase mb-3">
        Соціальний доказ
      </p>
      <h2 class="text-fluid-4xl font-bold text-white mb-4">
        {testimonials.title}
      </h2>
      <p class="text-fluid-lg text-gray-400">
        {testimonials.subtitle}
      </p>
    </div>

    <!-- Testimonials Masonry-style Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-7xl mx-auto">
      {testimonials.items.map((testimonial) => (
        <article
          class="group relative bg-white/5 border border-white/10 rounded-3xl p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300 hover:-translate-y-2"
        >
          <!-- Quote Mark - Modern Style -->
          <div class="absolute -top-4 -left-4 w-16 h-16 bg-gradient-to-br from-accent-500 to-primary-500 rounded-2xl flex items-center justify-center shadow-xl rotate-6 group-hover:rotate-12 transition-transform">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          <!-- Quote Text -->
          <div class="mt-8 mb-6">
            <p class="text-gray-300 leading-relaxed text-base">
              "{testimonial.quote}"
            </p>
          </div>

          <!-- Author - Card Style -->
          <div class="flex items-center gap-4 pt-6 border-t-2 border-white/10">
            <!-- Avatar -->
            <div class="w-12 h-12 bg-accent-500/20 rounded-full flex items-center justify-center border-2 border-accent-500/30">
              <svg class="w-6 h-6 text-accent-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              </svg>
            </div>

            <div class="flex-1 min-w-0">
              <p class="font-bold text-white truncate">
                {testimonial.author}
              </p>
              <p class="text-sm text-gray-400 truncate">
                {testimonial.role}
              </p>
              <p class="text-sm text-accent-400 font-medium truncate">
                {testimonial.company}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
