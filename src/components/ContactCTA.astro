---
import content from '../content/home-uk.json';
import { siteConfig } from '../config/site';

const { cta } = content;
---

<section id="contact" data-gtm-section="contact" class="relative py-20 md:py-28 text-white overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-5xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          {cta.headline}
        </h2>
        {cta.subheadline && (
          <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
            {cta.subheadline}
          </p>
        )}

        <!-- Benefits badges -->
        <div class="flex flex-wrap justify-center gap-4 mb-10 mt-10">
          {cta.benefits.map((benefit) => (
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm text-sm font-medium">
              <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{benefit}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Contact Form - Modern Card -->
      <div class="relative">
        <!-- Glow effect -->
        <div class="absolute -inset-1 bg-gradient-to-r from-primary-500 via-accent-500 to-primary-500 rounded-3xl blur-xl opacity-20"></div>
        
        <div class="relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300">
          {cta.form.title && (
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">
              {cta.form.title}
            </h3>
          )}

          <form id="contact-form" data-gtm-event="lead_submit" class="space-y-6" novalidate>
            <!-- Name & Phone Row -->
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-semibold text-white/90 mb-2">
                  {cta.form.fields.name.label} <span class="text-accent-400">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  required
                  placeholder={cta.form.fields.name.placeholder}
                  class="w-full px-5 py-3.5 bg-white/5 border-2 border-white/10 rounded-xl text-white placeholder-gray-400 focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all backdrop-blur-sm"
                />
                <p class="error-message text-accent-300 text-sm mt-2 hidden"></p>
              </div>

              <div>
                <label for="phone" class="block text-sm font-semibold text-white/90 mb-2">
                  {cta.form.fields.phone.label} <span class="text-accent-400">*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  required
                  placeholder={cta.form.fields.phone.placeholder}
                  class="w-full px-5 py-3.5 bg-white/5 border-2 border-white/10 rounded-xl text-white placeholder-gray-400 focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all backdrop-blur-sm"
                />
                <p class="error-message text-accent-300 text-sm mt-2 hidden"></p>
              </div>
            </div>

            <!-- Contact Method & Service Row -->
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="contact_method" class="block text-sm font-semibold text-white/90 mb-2">
                  {cta.form.fields.contact_method.label} <span class="text-accent-400">*</span>
                </label>
                <select
                  id="contact_method"
                  name="contact_method"
                  autocomplete="off"
                  required
                  class="w-full px-5 py-3.5 bg-white/5 border-2 border-white/10 rounded-xl text-white focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all backdrop-blur-sm appearance-none cursor-pointer"
                >
                  <option value="" class="bg-slate-900">{cta.form.fields.contact_method.placeholder}</option>
                  {cta.form.fields.contact_method.options?.map((option) => (
                    <option value={option} class="bg-slate-900">{option}</option>
                  ))}
                </select>
                <p class="error-message text-accent-300 text-sm mt-2 hidden"></p>
              </div>

              <div>
                <label for="service" class="block text-sm font-semibold text-white/90 mb-2">
                  {cta.form.fields.service.label}
                </label>
                <select
                  id="service"
                  name="service"
                  autocomplete="off"
                  class="w-full px-5 py-3.5 bg-white/5 border-2 border-white/10 rounded-xl text-white focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all backdrop-blur-sm appearance-none cursor-pointer"
                >
                  <option value="" class="bg-slate-900">{cta.form.fields.service.placeholder}</option>
                  {cta.form.fields.service.options?.map((option) => (
                    <option value={option} class="bg-slate-900">{option}</option>
                  ))}
                </select>
                <p class="error-message text-accent-300 text-sm mt-2 hidden"></p>
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-semibold text-white/90 mb-2">
                {cta.form.fields.message.label}
              </label>
              <textarea
                id="message"
                name="message"
                autocomplete="off"
                rows="4"
                placeholder={cta.form.fields.message.placeholder}
                class="w-full px-5 py-3.5 bg-white/5 border-2 border-white/10 rounded-xl text-white placeholder-gray-400 focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all resize-none backdrop-blur-sm"
              ></textarea>
              <p class="error-message text-accent-300 text-sm mt-2 hidden"></p>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-btn"
              class="group relative w-full bg-gradient-to-r from-accent-500 to-accent-600 text-white px-8 py-5 rounded-xl font-bold text-lg hover:shadow-[0_0_40px_rgba(251,146,60,0.6)] transition-all duration-300 hover:scale-[1.02] overflow-hidden"
            >
              <span id="submit-text" class="relative z-10 flex items-center justify-center gap-2">
                {cta.form.submit}
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
              <div class="absolute inset-0 bg-gradient-to-r from-accent-600 to-accent-700 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </button>

            <!-- Success/Error Messages (inside form) -->
            <div id="form-message" class="hidden p-4 rounded-xl text-center font-semibold"></div>

          </form>

          <!-- Calendly Option -->
          <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
              <p class="text-gray-300 text-sm md:text-base md:max-w-xl">
                Хочете швидше? Забронюйте 30-хвилинний дзвінок у зручний для вас час.
              </p>
              <a
                href={siteConfig.contact.calendly}
                target="_blank"
                rel="noopener noreferrer"
                data-gtm-event="book_call"
                data-gtm-label="calendly_30min"
                data-gtm-location="contact_block"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white/10 border border-white/10 text-white font-semibold hover:bg-accent-500/20 hover:border-accent-400/60 transition-colors"
              >
                <svg class="w-5 h-5 text-accent-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10m-12 8h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Забронювати дзвінок</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


