---
import content from '../content/home-uk.json';
import { messengerLinks, siteConfig } from '../config/site';

const { cta } = content;
---

<section id="contact" data-gtm-section="contact" class="py-16 text-white md:py-24">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="contact-grid">
        <div class="contact-copy">
          <p class="mb-3 text-fluid-sm font-semibold uppercase tracking-[0.16em] text-accent-400">
            Контакт
          </p>
          <h2>{cta.headline}</h2>
          {cta.subheadline && (
            <p class="contact-copy__lead">
              {cta.subheadline}
            </p>
          )}

          <div class="contact-benefits">
            {cta.benefits.map((benefit) => (
              <div>
                <svg class="h-5 w-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{benefit}</span>
              </div>
            ))}
          </div>

          <div class="contact-paths">
            <a
              href={siteConfig.contact.calendly}
              target="_blank"
              rel="noopener noreferrer"
              data-gtm-event="book_call"
              data-gtm-label="calendly_30min"
              data-gtm-location="contact_block"
            >
              Забронювати дзвінок
            </a>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              data-gtm-event="cta_click"
              data-gtm-label="contact_linkedin"
              data-gtm-location="contact_block"
            >
              LinkedIn для команд
            </a>
          </div>

          <div class="contact-direct">
            <p>{cta.alternativeContact}</p>
            <div>
              {messengerLinks.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-gtm-event="messenger_click"
                  data-gtm-label={link.label.toLowerCase()}
                  data-gtm-location="contact_block"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="contact-form-shell">
          {cta.form.title && (
            <h3>
              {cta.form.title}
            </h3>
          )}

          <form id="contact-form" data-gtm-event="lead_submit" class="space-y-5" novalidate>
            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <label for="name">
                  {cta.form.fields.name.label} <span>*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  required
                  placeholder={cta.form.fields.name.placeholder}
                />
                <p class="error-message hidden text-sm text-accent-300"></p>
              </div>

              <div>
                <label for="phone">
                  {cta.form.fields.phone.label} <span>*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  required
                  placeholder={cta.form.fields.phone.placeholder}
                />
                <p class="error-message hidden text-sm text-accent-300"></p>
              </div>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <label for="contact_method">
                  {cta.form.fields.contact_method.label} <span>*</span>
                </label>
                <select
                  id="contact_method"
                  name="contact_method"
                  autocomplete="off"
                  required
                >
                  <option value="">{cta.form.fields.contact_method.placeholder}</option>
                  {cta.form.fields.contact_method.options?.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
                <p class="error-message hidden text-sm text-accent-300"></p>
              </div>

              <div>
                <label for="service">
                  {cta.form.fields.service.label}
                </label>
                <select
                  id="service"
                  name="service"
                  autocomplete="off"
                >
                  <option value="">{cta.form.fields.service.placeholder}</option>
                  {cta.form.fields.service.options?.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
                <p class="error-message hidden text-sm text-accent-300"></p>
              </div>
            </div>

            <div>
              <label for="message">
                {cta.form.fields.message.label}
              </label>
              <textarea
                id="message"
                name="message"
                autocomplete="off"
                rows="4"
                placeholder={cta.form.fields.message.placeholder}
              ></textarea>
              <p class="error-message hidden text-sm text-accent-300"></p>
            </div>

            <button type="submit" id="submit-btn">
              <span id="submit-text">
                {cta.form.submit}
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </span>
            </button>

            <div id="form-message" class="hidden rounded-lg p-4 text-center font-semibold"></div>
          </form>

          <p class="contact-form-note">{cta.guarantee}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 3rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
      align-items: start;
      gap: 4rem;
    }
  }

  .contact-copy {
    max-width: 680px;
  }

  .contact-copy h2 {
    color: white;
    font-size: clamp(2.45rem, 4.8vw, 5rem);
    font-weight: 950;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .contact-copy__lead {
    margin-top: 1.35rem;
    color: rgb(209 213 219);
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
  }

  .contact-benefits {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .contact-benefits div {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgb(229 231 235);
    font-weight: 730;
  }

  .contact-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .contact-paths a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.055);
    padding: 0.75rem 1rem;
    color: white;
    font-weight: 800;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .contact-paths a:first-child {
    border-color: rgba(249, 115, 22, 0.5);
    background: rgba(249, 115, 22, 0.16);
    color: rgb(255 237 213);
  }

  .contact-paths a:hover {
    border-color: rgba(249, 115, 22, 0.6);
    background: rgba(255, 255, 255, 0.085);
  }

  .contact-direct {
    margin-top: 2rem;
    color: rgb(148 163 184);
  }

  .contact-direct div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.75rem;
  }

  .contact-direct a {
    color: rgb(253 186 116);
    font-weight: 780;
    text-decoration: underline;
    text-decoration-color: rgba(253, 186, 116, 0.35);
    text-underline-offset: 4px;
  }

  .contact-form-shell {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 1.25rem;
  }

  @media (min-width: 768px) {
    .contact-form-shell {
      padding: 1.6rem;
    }
  }

  .contact-form-shell h3 {
    margin-bottom: 1.4rem;
    color: white;
    font-size: 1.35rem;
    font-weight: 850;
  }

  .contact-form-shell label {
    display: block;
    margin-bottom: 0.45rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.92rem;
    font-weight: 760;
  }

  .contact-form-shell label span {
    color: rgb(251 146 60);
  }

  .contact-form-shell input,
  .contact-form-shell select,
  .contact-form-shell textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.55rem;
    background: rgba(2, 6, 23, 0.48);
    padding: 0.9rem 1rem;
    color: white;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .contact-form-shell input::placeholder,
  .contact-form-shell textarea::placeholder {
    color: rgb(107 114 128);
  }

  .contact-form-shell select option {
    background: rgb(15 23 42);
    color: white;
  }

  .contact-form-shell input:focus,
  .contact-form-shell select:focus,
  .contact-form-shell textarea:focus {
    border-color: rgba(249, 115, 22, 0.75);
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.18);
    outline: none;
  }

  .contact-form-shell textarea {
    resize: vertical;
  }

  .contact-form-shell button[type='submit'] {
    display: inline-flex;
    width: 100%;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    background: rgb(249 115 22);
    color: white;
    font-size: 1rem;
    font-weight: 850;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .contact-form-shell button[type='submit']:hover {
    background: rgb(251 146 60);
    transform: translateY(-1px);
  }

  .contact-form-shell button[type='submit'] span {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .contact-form-note {
    margin-top: 1rem;
    color: rgb(148 163 184);
    font-size: 0.9rem;
    line-height: 1.55;
  }
</style>
