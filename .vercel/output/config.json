{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/analyze/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/case-1/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/case-2/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/case-3/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/case-4/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/case-5/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/case-6/?$",
			"dest": "_render"
		},
		{
			"src": "^/cases/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/pricing/?$",
			"dest": "_render"
		},
		{
			"src": "^/privacy/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/analytics/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/consulting/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/facebook-ads/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/google-ads/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}