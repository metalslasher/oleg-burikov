---
import PageLayout from '../../layouts/PageLayout.astro';

const seo = {
  title: "Аудит сайту (AI) | Targetsy Agency",
  description: "Отримайте безкоштовний аудит вашого сайту за допомогою штучного інтелекту. Професійні рекомендації щодо покращення конверсії та SEO.",
};
---

<PageLayout title={seo.title} description={seo.description}>
  <div class="pt-8 pb-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="inline-block px-4 py-2 rounded-full bg-accent-500/10 text-accent-400 text-sm font-medium mb-6">
          AI Аудит
        </span>
        <h1 class="text-fluid-4xl font-bold text-white mb-6">
          Аудит <span class="text-accent-500">Сайту</span>
        </h1>
        <p class="text-fluid-lg text-gray-400">
          Миттєвий аналіз вашого сайту. Отримайте практичні поради з підвищення конверсії.
        </p>
      
      <!-- Form Container -->
      <div class="max-w-3xl mx-auto mb-24">
        <div class="bg-white/5 border border-white/10 rounded-xl p-6 md:p-8 hover:border-accent-500/50 transition-all duration-300 relative overflow-hidden">
            <!-- Loading Overlay -->
            <div id="loading-overlay" class="absolute inset-0 bg-slate-950/95 flex flex-col items-center justify-center z-50 hidden backdrop-blur-sm">
                <div class="w-12 h-12 border-4 border-accent-500/30 border-t-accent-500 rounded-full animate-spin mb-4"></div>
                <p class="text-white font-medium animate-pulse">Аналізуємо ваш сайт...</p>
                <p class="text-sm text-gray-400 mt-2">Це може зайняти до 30 секунд</p>
            </div>

            <!-- Steps Progress -->
            <div class="flex items-center justify-center mb-10 space-x-4">
                <div class="flex items-center">
                    <div id="step-1-indicator" class="w-10 h-10 bg-accent-500/20 rounded-lg flex items-center justify-center text-accent-400 font-bold transition-all duration-300">1</div>
                    <span class="ml-2 text-sm text-white hidden sm:inline font-medium">URL</span>
                </div>
                <div class="w-16 h-[2px] bg-white/5 rounded-full"></div>
                <div class="flex items-center">
                    <div id="step-2-indicator" class="w-10 h-10 bg-white/5 rounded-lg flex items-center justify-center text-gray-400 font-bold transition-all duration-300">2</div>
                    <span class="ml-2 text-sm text-gray-400 hidden sm:inline font-medium">Контакти</span>
                </div>
            </div>

          <form id="audit-form" class="space-y-8">
            <!-- Step 1: URL -->
            <div id="step-1" class="step-content">
                <div class="space-y-6">
                    <div>
                        <label for="url" class="block text-sm font-medium text-gray-300 mb-2">Адреса вашого сайту</label>
                        <input
                            type="url"
                            id="url"
                            name="url"
                            required
                            placeholder="https://example.com"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-all"
                        />
                    </div>
                     <div class="bg-blue-500/5 border border-blue-500/20 rounded-xl p-4 text-sm">
                        <p class="flex gap-2 text-white">
                           <svg class="w-5 h-5 flex-shrink-0 text-blue-300 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                           <span>Вкажіть повну адресу (наприклад, <code class="text-white bg-white/10 px-1.5 py-0.5 rounded font-mono text-xs">https://myshop.com</code>). Ми перевіримо головну сторінку.</span>
                        </p>
                    </div>
                </div>
                <div class="mt-10">
                    <button type="button" id="next-btn" class="w-full bg-gradient-to-r from-accent-500 to-accent-600 text-white font-semibold px-8 py-4 rounded-xl hover:shadow-[0_0_40px_rgba(251,146,60,0.5)] transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2">
                        Продовжити
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </button>
                </div>
            </div>

            <!-- Step 2: Contact Info -->
            <div id="step-2" class="step-content hidden">
                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Ім'я</label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                placeholder="Олександр"
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                            />
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-300 mb-2">Телефон</label>
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                required
                                placeholder="+38 (0XX) XXX XX XX"
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                            />
                        </div>
                    </div>
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email (для надсилання звіту)</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="mail@example.com"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                        />
                    </div>
                     <div>
                        <label for="notes" class="block text-sm font-medium text-gray-300 mb-2">Додатковий коментар (необов'язково)</label>
                        <textarea
                            id="notes"
                            name="notes"
                            rows="2"
                            placeholder="Яка основна ціль вашого сайту? (напр., продажі, збір лідів...)"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                        ></textarea>
                    </div>

                    <!-- HoneyPot -->
                    <input type="text" name="website_hp" class="hidden" tabindex="-1" autocomplete="off" />

                </div>
                <div class="mt-8 flex gap-3">
                     <button type="button" id="back-btn" class="w-1/3 bg-white/5 hover:bg-white/10 text-white font-medium py-3.5 px-6 rounded-xl transition-colors">
                        Назад
                    </button>
                    <button type="submit" class="w-2/3 bg-gradient-to-r from-accent-500 to-accent-600 text-white font-semibold py-3.5 px-6 rounded-xl hover:shadow-[0_0_40px_rgba(251,146,60,0.5)] transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2">
                        Розпочати аудит
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                    </button>
                </div>
            </div>
             <div id="error-message" class="hidden mt-6 p-4 bg-red-500/10 border border-red-500/20 text-red-200 rounded-xl text-sm text-center">
            </div>
          </form>

            <div id="results-container" class="hidden">
                 <div class="text-center mb-10">
                    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-green-500/10 text-green-400 mb-8 ring-1 ring-green-500/20 shadow-[0_0_40px_rgba(34,197,94,0.1)]">
                        <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">Готово!</h3>
                     <p class="text-gray-400 text-lg">Ми проаналізували ваш сайт. Ось ключові рекомендації:</p>
                </div>

                <div class="bg-[#0d1117] border border-white/10 rounded-2xl overflow-hidden shadow-inner">
                    <div class="p-2">
                        <div id="audit-results" class="space-y-4 text-gray-300 text-base leading-relaxed max-h-[600px] overflow-y-auto custom-scrollbar p-8">
                            <!-- Results will be injected here -->
                        </div>
                    </div>
                </div>

                 <div class="mt-10 grid gap-4">
                    <a href="/contact" class="flex items-center justify-center w-full bg-gradient-to-r from-accent-500 to-accent-600 hover:from-accent-400 hover:to-accent-500 text-white font-bold py-5 px-8 rounded-xl transition-all shadow-[0_0_30px_rgba(251,146,60,0.3)] gap-2 text-lg">
                         <span>Впровадити рекомендації</span>
                         <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </a>
                     <a href="/tools/site-audit" class="block w-full text-center text-gray-500 hover:text-white py-3 text-sm transition-colors opacity-70 hover:opacity-100">
                        Перевірити інший сайт
                    </a>
                </div>
            </div>
        </div>
      </div>

      <!-- How it Works Section -->
      <div class="max-w-7xl mx-auto">
        <h2 class="text-fluid-4xl font-bold text-white text-center mb-12">Як це працює?</h2>
        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
            <!-- Step 1 -->
            <div class="group bg-white/5 border border-white/10 rounded-xl p-6 md:p-8 hover:border-accent-500/50 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 text-center">
                <div class="w-14 h-14 bg-accent-500/20 rounded-lg flex items-center justify-center mx-auto mb-5 group-hover:bg-accent-500 group-hover:scale-110 transition-all duration-300">
                    <svg class="w-7 h-7 text-accent-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Вкажіть сайт</h3>
                <p class="text-gray-400 leading-relaxed">Введіть адресу вашого сайту. Ми автоматично проскануємо головну сторінку.</p>
            </div>

            <!-- Step 2 -->
             <div class="group bg-white/5 border border-white/10 rounded-xl p-6 md:p-8 hover:border-accent-500/50 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 text-center">
                <div class="w-14 h-14 bg-accent-500/20 rounded-lg flex items-center justify-center mx-auto mb-5 group-hover:bg-accent-500 group-hover:scale-110 transition-all duration-300">
                    <svg class="w-7 h-7 text-accent-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Аналіз</h3>
                <p class="text-gray-400 leading-relaxed">Алгоритм аналізує структуру, контент та UX на основі кращих практик.</p>
            </div>

            <!-- Step 3 -->
             <div class="group bg-white/5 border border-white/10 rounded-xl p-6 md:p-8 hover:border-accent-500/50 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 text-center">
                <div class="w-14 h-14 bg-accent-500/20 rounded-lg flex items-center justify-center mx-auto mb-5 group-hover:bg-accent-500 group-hover:scale-110 transition-all duration-300">
                    <svg class="w-7 h-7 text-accent-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Результат</h3>
                <p class="text-gray-400 leading-relaxed">Отримайте список з 3-5 конкретних порад, що можна покращити прямо зараз.</p>
            </div>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
    const form = document.getElementById('audit-form');
    const step1 = document.getElementById('step-1');
    const step2 = document.getElementById('step-2');
    const nextBtn = document.getElementById('next-btn');
    const backBtn = document.getElementById('back-btn');
    const step1Indicator = document.getElementById('step-1-indicator');
    const step2Indicator = document.getElementById('step-2-indicator');
    const loadingOverlay = document.getElementById('loading-overlay');
    const resultsContainer = document.getElementById('results-container');
    const auditResults = document.getElementById('audit-results');
    const errorMessage = document.getElementById('error-message');

    // Validation helper
    const validateStep1 = () => {
        const urlInput = document.getElementById('url') as HTMLInputElement;
        
        let url = urlInput.value.trim();
        if(!url) {
            urlInput.setCustomValidity('Будь ласка, введіть URL');
            urlInput.reportValidity();
            return false;
        }

        // Basic URL cleanup/check
        if (!url.startsWith('http')) {
            url = 'https://' + url;
            urlInput.value = url;
        }

        // Simple regex for URL validation
        const urlPattern = new RegExp('^(https?:\\/\\/)?'+ // protocol
            '((([a-z\\d]([a-z\\d-]*[a-z\\d])*)\\.)+[a-z]{2,}|'+ // domain name
            '((\\d{1,3}\\.){3}\\d{1,3}))'+ // OR ip (v4) address
            '(\\:\\d+)?(\\/[-a-z\\d%_.~+]*)*'+ // port and path
            '(\\?[;&a-z\\d%_.~+=-]*)?'+ // query string
            '(\\#[-a-z\\d_]*)?$','i'); // fragment locator
        
        if (!urlPattern.test(url)) {
            urlInput.setCustomValidity('Введіть коректну адресу сайту');
            urlInput.reportValidity();
            return false;
        } else {
             urlInput.setCustomValidity('');
        }

        if (!urlInput.checkValidity()) {
            urlInput.reportValidity();
            return false;
        }
        return true;
    };

    nextBtn?.addEventListener('click', () => {
        if (validateStep1()) {
            step1?.classList.add('hidden');
            step2?.classList.remove('hidden');

            // Update indicators
            step1Indicator?.classList.replace('bg-accent-500/20', 'bg-white/5');
            step1Indicator?.classList.replace('text-accent-400', 'text-green-500');
             step1Indicator!.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';

            step2Indicator?.classList.replace('bg-white/5', 'bg-accent-500/20');
            step2Indicator?.classList.replace('text-gray-400', 'text-accent-400');
        }
    });

    backBtn?.addEventListener('click', () => {
        step2?.classList.add('hidden');
        step1?.classList.remove('hidden');

        // Reset indicators
        step1Indicator?.classList.replace('bg-white/5', 'bg-accent-500/20');
        step1Indicator?.classList.replace('text-green-500', 'text-accent-400');
        step1Indicator!.textContent = '1';

        step2Indicator?.classList.replace('bg-accent-500/20', 'bg-white/5');
        step2Indicator?.classList.replace('text-accent-400', 'text-gray-400');
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMessage?.classList.add('hidden');
        
        const formData = new FormData(form as HTMLFormElement);
        const data: any = Object.fromEntries(formData.entries());
        
        // Get URL from step 1
        const submitUrlInput = document.getElementById('url') as HTMLInputElement | null;
        if (submitUrlInput) {
            data.url = submitUrlInput.value;
        }

        loadingOverlay?.classList.remove('hidden');

        try {
            // Call API for real AI analysis
            const response = await fetch('/api/analyze', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data),
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.error || 'Помилка при аналізі');
            }

            // Show results
            form.classList.add('hidden');
            resultsContainer?.classList.remove('hidden');
            
             if (auditResults) {
                // Remove Markdown bold **
                const cleanText = result.analysis.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>');
                // Format lists
                const paragraphs = cleanText.split('\n').filter((p: string) => p.trim() !== '');
                auditResults.innerHTML = paragraphs.map((p: string) => {
                    if (p.trim().startsWith('-') || p.trim().startsWith('•') || p.trim().startsWith('✓')) {
                         return `<div class="flex gap-2 mb-3"><span class="text-accent-500 mt-1">•</span><span>${p.trim().substring(1).trim()}</span></div>`
                    } else if (p.trim().match(/^\d+\./)) {
                         return `<div class="flex gap-2 mb-3"><span class="text-accent-500 font-bold mt-0.5">${p.trim().split('.')[0]}.</span><span>${p.trim().substring(p.indexOf('.') + 1).trim()}</span></div>`
                    } else if (p.trim().startsWith('---')) {
                        return '<hr class="my-6 border-white/10" />';
                    }
                    return `<p class="mb-4 text-gray-300">${p}</p>`;
                }).join('');
            }


        } catch (error: any) {
            console.error(error);
            errorMessage!.textContent = error.message;
            errorMessage?.classList.remove('hidden');
        } finally {
            loadingOverlay?.classList.add('hidden');
        }
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.2);
    }
</style>
