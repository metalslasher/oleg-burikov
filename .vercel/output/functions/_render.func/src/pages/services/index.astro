---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const services = [
  {
    slug: 'google-ads',
    title: 'Google Ads',
    description: 'Налаштування та ведення реклами в Google',
    icon: '🎯',
    color: 'from-blue-500 to-blue-600',
    features: ['Пошукова реклама', 'Performance Max', 'YouTube реклама', 'Ремаркетинг'],
  },
  {
    slug: 'facebook-ads',
    title: 'Meta Ads',
    description: 'Таргетована реклама в Facebook та Instagram',
    icon: '📱',
    color: 'from-purple-500 to-pink-500',
    features: ['Facebook', 'Instagram'],
  },
  {
    slug: 'analytics',
    title: 'Веб-аналітика',
    description: 'Налаштування аналітики та відстеження конверсій',
    icon: '📊',
    color: 'from-green-500 to-emerald-500',
    features: ['Google Analytics 4', 'Google Tag Manager', 'Microsoft Clarity'],
  },
  {
    slug: 'consulting',
    title: 'Консалтинг',
    description: 'Аудит та стратегічний консалтинг з реклами',
    icon: '💡',
    color: 'from-amber-500 to-orange-500',
    features: ['Аудит рекламних кампаній', 'Маркетингова стратегія'],
  },
];
---

<PageLayout 
  title="Послуги | Targetsy Agency"
  description="Професійні послуги з цифрового маркетингу: Google Ads, Meta Ads, веб-аналітика та консалтинг. Збільшуємо ваші продажі через ефективну онлайн-рекламу."
>
  <!-- Hero Section -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <span class="inline-block px-4 py-2 rounded-full bg-accent-500/10 text-accent-400 text-sm font-medium mb-6">
        Наші послуги
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        Комплексний digital-маркетинг
        <span class="block text-accent-400">
          для вашого бізнесу
        </span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        Від налаштування реклами до аналітики — ми забезпечуємо повний цикл онлайн-просування вашого бізнесу
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        {services.map((service) => (
          <a 
            href={`/services/${service.slug}`}
            class="group relative bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:bg-white/10 hover:border-accent-500/50 transition-all duration-300"
          >
            <div class={`inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-r ${service.color} mb-6 text-3xl`}>
              {service.icon}
            </div>
            
            <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-accent-400 transition-colors">
              {service.title}
            </h2>
            
            <p class="text-gray-400 mb-6">
              {service.description}
            </p>
            
            <div class="flex flex-wrap gap-2 mb-6">
              {service.features.map((feature) => (
                <span class="px-3 py-1 bg-white/5 rounded-full text-sm text-gray-300">
                  {feature}
                </span>
              ))}
            </div>
            
            <div class="flex items-center text-accent-400 font-medium">
              Детальніше
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
