---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const benefits = [
  {
    title: 'Facebook Ads',
    description: 'Таргетована реклама на найбільшій соціальній платформі світу',
    icon: '📘'
  },
  {
    title: 'Instagram Ads',
    description: 'Візуальна реклама для залучення молодої та активної аудиторії',
    icon: '📸'
  },
  {
    title: 'Lead Forms',
    description: 'Збір заявок прямо в соцмережах без переходу на сайт',
    icon: '📝'
  },
  {
    title: 'Advantage+',
    description: 'Автоматизовані кампанії з машинним навчанням для максимальної ефективності',
    icon: '🤖'
  },
  {
    title: 'Lookalike аудиторії',
    description: 'Пошук нових клієнтів схожих на ваших найкращих покупців',
    icon: '👥'
  },
  {
    title: 'Ремаркетинг',
    description: 'Повернення відвідувачів сайту та покинутих кошиків',
    icon: '🔄'
  }
];

const process = [
  { step: '01', title: 'Аналіз аудиторії', description: 'Визначаємо вашу цільову аудиторію та її болі' },
  { step: '02', title: 'Креативи', description: 'Створюємо привабливі оголошення та відео' },
  { step: '03', title: 'Запуск', description: 'Налаштовуємо піксель, конверсії та запускаємо кампанії' },
  { step: '04', title: 'Масштабування', description: 'Знаходимо найкращі зв\'язки та масштабуємо успіх' },
];

const cases = [
  { metric: '865', label: 'Лідів через Lead Forms', description: 'Для ЖК' },
  { metric: '$13.75', label: 'Вартість ліда', description: 'Нерухомість' },
  { metric: '405K+', label: 'Охоплення', description: 'Потенційних клієнтів' },
];
---

<PageLayout 
  title="Meta Ads (Facebook/Instagram) реклама | Targetsy Agency"
  description="Таргетована реклама в Facebook та Instagram. Lead Forms, Advantage+, Lookalike аудиторії. Залучаємо вашу цільову аудиторію в соцмережах."
>
  <!-- Hero -->
  <section class="pt-8 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/services" class="inline-flex items-center text-accent-400 hover:text-accent-300 mb-6">
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Всі послуги
          </a>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            <span class="text-purple-400">
              Meta Ads
            </span>
            <br />реклама
          </h1>
          
          <p class="text-xl text-gray-400 mb-8">
            Залучаємо вашу аудиторію в Facebook та Instagram. Створюємо креативи, 
            налаштовуємо таргетинг та оптимізуємо для максимальних результатів.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="#contact" class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white px-8 py-4 rounded-xl font-semibold hover:shadow-lg hover:shadow-purple-500/30 transition-all">
              Отримати консультацію
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="bg-gradient-to-br from-purple-500/20 to-pink-500/20 backdrop-blur-sm rounded-3xl p-8 border border-purple-500/30">
            <div class="grid grid-cols-3 gap-4 text-center">
              {cases.map((item) => (
                <div>
                  <div class="text-2xl md:text-3xl font-bold text-white mb-1">{item.metric}</div>
                  <div class="text-sm text-gray-400">{item.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
        Що входить в послугу?
      </h2>
      <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        Повний спектр можливостей Meta для залучення та конвертації вашої аудиторії
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <div class="text-4xl mb-4">{benefit.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{benefit.title}</h3>
            <p class="text-gray-400">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        Як ми працюємо
      </h2>
      
      <div class="grid md:grid-cols-4 gap-8">
        {process.map((item) => (
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-xl">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Hint -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="bg-gradient-to-r from-purple-500/10 to-pink-500/10 border border-purple-500/30 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-4">Вартість послуги</h2>
        <p class="text-gray-400 mb-6">
          Вартість залежить від обсягу робіт та рекламного бюджету. Включає створення креативів та постійну оптимізацію. 
          Мінімальний рекламний бюджет від $300/міс.
        </p>
        <a href="/pricing" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium">
          Дізнатись детальніше про ціни
          <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactCTA />
</PageLayout>
